---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Organization', name: 'MLM Lip' },
  publisher: { '@type': 'Organization', name: 'MLM Lip' }
};
---

<BaseLayout title={`${post.data.title} — MLM Lip`} description={post.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <section>
    <div class="wrap">
      <div class="prose">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog' }, { label: post.data.title }]} />
        <h1 style="font-size:36px">{post.data.title}</h1>
        <p class="post-meta">
          {fmt(post.data.pubDate)}
          {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        </p>
        <Content />
        <div class="card" style="margin-top:48px; text-align:center; padding:36px 24px">
          <h3 style="margin-bottom:8px">Ready to start your own lip line?</h3>
          <p style="margin:0 0 20px">From 500 pcs per SKU, samples in 7 days, sampling fee deducted from your order.</p>
          <a class="btn" href="/contact">Request a quote</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
