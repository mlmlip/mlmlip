---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { factoryVideos } from '../data/cases';

const isYouTube = (url: string) => /youtube|youtu\.be/.test(url);
const toEmbed = (url: string) =>
  url.replace('watch?v=', 'embed/').replace('youtu.be/', 'www.youtube.com/embed/');

// 3 个匿名 B2B 案例研究模板（保护商业隐私）
const caseStudies = [
  {
    title: 'Case Study 1: US Indie Brand — 4-Shade Lip Collection Launch',
    subtitle: 'Rapid go-to-market pilot run for emerging direct-to-consumer beauty brand',
    challenge: 'First-time founder with a strict $25K budget, needed to test market traction and consumer response before committing capital to mass scaling.',
    solution: 'Engineered an agile 500 pcs/shade pilot run utilizing our custom peptide-infused lip formula and streamlined stock packaging with custom hot-stamp decoration.',
    result: 'Sold out first batch in 6 weeks across direct online channels; immediately placed reorder at 5,000 pcs/shade for nationwide fulfillment.',
    timeline: '8 weeks from formula approval to delivery',
    metrics: [
      { label: 'Initial Run', value: '500 pcs/shade' },
      { label: 'Sell-Out Time', value: '6 Weeks' },
      { label: 'Scale Reorder', value: '5,000 pcs/shade' },
      { label: 'Turnaround', value: '8 Weeks' }
    ]
  },
  {
    title: 'Case Study 2: European Beauty Retailer — Private Label Lip Line',
    subtitle: 'Compliance-first omnichannel launch across European retail stores',
    challenge: 'Required full EU CPNP compliant formulations, complete CPSR safety dossiers, a sophisticated 12-shade range, and a rigid pre-holiday retail deadline.',
    solution: 'Comprehensive full ODM service including custom shade matching, preservative challenge testing (USP 51), European regulatory documentation, and production at 3,000 pcs/shade.',
    result: 'Successfully launched on schedule across regional store shelves; passed all EU compliance audits and retailer toxicological reviews without revisions.',
    timeline: '12 weeks including regulatory filing',
    metrics: [
      { label: 'Shade Range', value: '12 Shades' },
      { label: 'Batch Volume', value: '3,000 pcs/shade' },
      { label: 'Compliance', value: '100% EU CPNP' },
      { label: 'Timeline', value: '12 Weeks' }
    ]
  },
  {
    title: 'Case Study 3: Korean-Style Brand — Water Tint Collection for Southeast Asia',
    subtitle: 'Climate-resilient formulation & multi-market regional retail rollout',
    challenge: 'Sought high-adherence K-beauty style water tints tailored for tropical humidity and requiring strict halal-certified ingredient verification.',
    solution: 'Bespoke lightweight water-based tint formula development using halal-certified pigments and active hydrating agents, backed by stability testing.',
    result: 'Secured immediate regional distribution across 200+ retail points in SEA with recurring monthly replenishment orders.',
    timeline: '10 weeks from brief to air freight dispatch',
    metrics: [
      { label: 'Retail Expansion', value: '200+ Retail Points' },
      { label: 'Certification', value: 'Halal-Certified' },
      { label: 'Formulation', value: 'Water Tint' },
      { label: 'Total Time', value: '10 Weeks' }
    ]
  }
];

const casesJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Case Studies & Client Success — MLM Lip Manufacturing",
  "description": "Anonymized B2B case studies demonstrating pilot run scaling, EU regulatory filings, and custom lip formulation success.",
  "url": "https://mlmlip.com/cases",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": caseStudies.map((c, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": c.title,
      "description": c.subtitle
    }))
  }
};
---

<BaseLayout
  title="Case Studies | Real Lip Product Manufacturing Projects — MLM Lip"
  description="Explore anonymized B2B case studies: 500 pcs pilot runs, EU CPNP compliant retail rollouts, and custom lip formulations manufactured by Beautychain."
>
  <script type="application/ld+json" set:html={JSON.stringify(casesJsonLd)} />

  <section>
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Cases & Factory' }]} />
      <p class="eyebrow">Proven Track Record</p>
      <h1>B2B Client Case Studies & Production Realities</h1>
      <p class="lead" style="max-width:680px">
        To protect competitive market positioning and client non-disclosure agreements (NDAs), our client partnerships are anonymized below. Each study illustrates real challenges, formulation solutions, and verified commercial outcomes.
      </p>
    </div>
  </section>

  <!-- 3 Anonymized B2B Case Study Cards -->
  <section class="tint" style="padding-top:0; background:transparent">
    <div class="wrap">
      <div style="display:flex; flex-direction:column; gap:36px;">
        {caseStudies.map((item, idx) => (
          <div class="card" style="background:#fff; border-radius:12px; padding:32px; border:1px solid var(--line); box-shadow:0 4px 18px rgba(0,0,0,0.03);">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px; margin-bottom:12px;">
              <div>
                <p class="eyebrow" style="color:var(--rose-dark); margin-bottom:4px; font-weight:700;">Verified Case #{idx + 1}</p>
                <h2 style="font-size:22px; margin:0 0 6px 0; color:var(--plum-dark);">{item.title}</h2>
                <p style="margin:0; font-size:14px; color:var(--ink-soft); font-style:italic;">{item.subtitle}</p>
              </div>
              <div style="background:var(--blush-soft); padding:8px 14px; border-radius:6px; font-size:13px; font-weight:700; color:var(--burgundy);">
                ⏱️ {item.timeline}
              </div>
            </div>

            <!-- Metrics bar -->
            <div class="grid four" style="margin:20px 0; padding:16px; background:var(--blush-soft); border-radius:8px; gap:16px;">
              {item.metrics.map((m) => (
                <div>
                  <div style="font-size:11px; text-transform:uppercase; letter-spacing:0.06em; color:var(--ink-soft);">{m.label}</div>
                  <div style="font-size:16px; font-weight:800; color:var(--burgundy); margin-top:2px;">{m.value}</div>
                </div>
              ))}
            </div>

            <!-- Challenge / Solution / Result grid -->
            <div class="grid three" style="gap:20px; margin-top:20px;">
              <div style="background:#fdfbfa; padding:18px; border-radius:8px; border-left:3px solid #b76e79;">
                <h3 style="font-size:15px; margin:0 0 8px; color:var(--burgundy); text-transform:uppercase; letter-spacing:0.04em;">Challenge</h3>
                <p style="margin:0; font-size:13px; color:var(--ink); line-height:1.6;">
                  {item.challenge}
                </p>
              </div>
              <div style="background:#fdfbfa; padding:18px; border-radius:8px; border-left:3px solid var(--gold, #d4af37);">
                <h3 style="font-size:15px; margin:0 0 8px; color:var(--plum-dark); text-transform:uppercase; letter-spacing:0.04em;">Solution</h3>
                <p style="margin:0; font-size:13px; color:var(--ink); line-height:1.6;">
                  {item.solution}
                </p>
              </div>
              <div style="background:#fdfbfa; padding:18px; border-radius:8px; border-left:3px solid #2e7d32;">
                <h3 style="font-size:15px; margin:0 0 8px; color:#2e7d32; text-transform:uppercase; letter-spacing:0.04em;">Result</h3>
                <p style="margin:0; font-size:13px; color:var(--ink); line-height:1.6;">
                  {item.result}
                </p>
              </div>
            </div>

            <div style="margin-top:24px; padding-top:16px; border-top:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
              <span style="font-size:13px; color:var(--ink-soft);">Turnaround: <strong>{item.timeline}</strong></span>
              <a href="/quote/" style="font-size:13px; font-weight:700; color:var(--burgundy); text-decoration:none;">Request Formulation Like This &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Factory Tour & Video Section -->
  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">Inside the factory</p>
      <h2>See how your products are made</h2>
      <p class="lead" style="max-width:640px">
        Production line, filling and assembly, quality inspection — filmed on our own floor.
      </p>
      <div class="grid three" style="margin-top:28px">
        {factoryVideos.map((v) => (
          <div>
            {v.videoUrl ? (
              isYouTube(v.videoUrl) ? (
                <div class="video-embed">
                  <iframe src={toEmbed(v.videoUrl)} title={v.title} allowfullscreen loading="lazy"></iframe>
                </div>
              ) : (
                <div class="video-embed"><video src={v.videoUrl} poster={v.poster} autoplay loop muted playsinline preload="metadata" controls></video></div>
              )
            ) : v.image ? (
              <div class="case-media"><img height="600" width="800" src={v.image} alt={v.title} loading="lazy" /></div>
            ) : (
              <div class="media-slot">{v.note}</div>
            )}
            <h3 style="margin-top:14px; font-size:18px">{v.title}</h3>
            <p class="note" style="margin:0">{v.note}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:32px"><a class="btn" href="/contact/">Ask for more project references</a></p>
    </div>
  </section>

  <!-- Bottom CTA: Have a similar project? -->
  <section style="background:var(--burgundy); color:#fff; padding:64px 0;">
    <div class="wrap" style="text-align:center;">
      <h2 style="color:#fff; margin-bottom:16px;">Have a similar project?</h2>
      <p class="lead" style="max-width:600px; margin:0 auto 28px; color:rgba(255,255,255,0.88);">
        From agile 500-unit pilot batches to full CPNP-compliant retail lines, we engineer and package your lip cosmetic vision on time and within budget.
      </p>
      <a class="btn" href="/quote/" style="background:var(--gold); color:var(--plum-dark); font-weight:700; border:none; padding:14px 28px; font-size:16px; border-radius:8px; display:inline-block; text-decoration:none;">
        Get Your Custom Quote &rarr;
      </a>
    </div>
  </section>
</BaseLayout>
