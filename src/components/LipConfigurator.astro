---
// site/src/components/LipConfigurator.astro
// 高转化 90 秒唇妆定制配置器 (B2B Precision Spec Builder)
import { site } from '../data/site';

interface Props {
  webhookUrl?: string;
}

const { webhookUrl = "" } = Astro.props;
---

<div class="lip-configurator-card" id="lip-configurator">
  <!-- Header Bar with Progress Indicator -->
  <div class="config-header">
    <div class="config-title-group">
      <span class="config-badge">Interactive Formulation Desk</span>
      <h2 class="config-title">Design Your Custom Lip Line in 90 Seconds</h2>
      <p class="config-subtitle">Live formula mapping, packaging selection & instant lab sample briefing (500 pcs MOQ)</p>
    </div>
    
    <div class="step-progress-wrapper" aria-label="Form progress">
      <div class="step-dots">
        <div class="step-dot active" data-step-indicator="1"><span>1</span><label>Format</label></div>
        <div class="step-line" data-line="1"></div>
        <div class="step-dot" data-step-indicator="2"><span>2</span><label>Texture</label></div>
        <div class="step-line" data-line="2"></div>
        <div class="step-dot" data-step-indicator="3"><span>3</span><label>Regulatory</label></div>
        <div class="step-line" data-line="3"></div>
        <div class="step-dot" data-step-indicator="4"><span>4</span><label>Scale</label></div>
        <div class="step-line" data-line="4"></div>
        <div class="step-dot" data-step-indicator="5"><span>5</span><label>Dispatch</label></div>
      </div>
    </div>
  </div>

  <form id="configurator-form" class="config-form" novalidate data-webhook={webhookUrl}>
    <!-- STEP 1: Product Format -->
    <div class="form-step active" data-step="1">
      <div class="step-lead">
        <h3>Step 1 · Select Your Product Category</h3>
        <p>Choose the core lip formulation category you intend to manufacture.</p>
      </div>

      <div class="category-grid">
        <label class="choice-tile">
          <input type="radio" name="category" value="Lip Gloss" checked />
          <div class="tile-card">
            <div class="tile-icon">✨</div>
            <div class="tile-info">
              <h4>Lip Gloss</h4>
              <p>High-viscosity cushion gloss, crystal clear or shimmer pearl</p>
              <span class="tile-tag">18,000–32,000 mPa·s</span>
            </div>
          </div>
        </label>

        <label class="choice-tile">
          <input type="radio" name="category" value="Velvet Lip Mud" />
          <div class="tile-card">
            <div class="tile-icon">☁️</div>
            <div class="tile-info">
              <h4>Velvet Lip Mud</h4>
              <p>Air-whipped mousse texture, blurred matte & non-drying transfer resistance</p>
              <span class="tile-tag">Thixotropic Paste</span>
            </div>
          </div>
        </label>

        <label class="choice-tile">
          <input type="radio" name="category" value="Lip Liner" />
          <div class="tile-card">
            <div class="tile-icon">✏️</div>
            <div class="tile-info">
              <h4>Precision Lip Liner</h4>
              <p>Cedarwood sharpenable pencil or 1.5mm micro-lead twist-up barrel</p>
              <span class="tile-tag">8-Hr Waterproof</span>
            </div>
          </div>
        </label>

        <label class="choice-tile">
          <input type="radio" name="category" value="Peptide Lip Oil" />
          <div class="tile-card">
            <div class="tile-icon">💧</div>
            <div class="tile-info">
              <h4>Peptide Lip Oil</h4>
              <p>Botanical squalane, non-sticky cushion glide & plumping actives</p>
              <span class="tile-tag">Skinified Hybrid</span>
            </div>
          </div>
        </label>

        <label class="choice-tile">
          <input type="radio" name="category" value="Bullet Lipstick" />
          <div class="tile-card">
            <div class="tile-icon">💄</div>
            <div class="tile-info">
              <h4>Bullet Lipstick</h4>
              <p>Matte, satin, or butter bullets with custom embossing & 350g magnetic cases</p>
              <span class="tile-tag">High-Pigment</span>
            </div>
          </div>
        </label>

        <label class="choice-tile">
          <input type="radio" name="category" value="Overnight Lip Mask" />
          <div class="tile-card">
            <div class="tile-icon">🌙</div>
            <div class="tile-info">
              <h4>Overnight Lip Mask</h4>
              <p>Biomimetic 3:1:1 ceramide barrier salve, deep nourishment & hydration</p>
              <span class="tile-tag">Barrier Repair</span>
            </div>
          </div>
        </label>
      </div>

      <div class="step-nav-footer">
        <div></div>
        <button type="button" class="btn btn-next" data-next="2">Next: Formulation Texture →</button>
      </div>
    </div>

    <!-- STEP 2: Formulation Texture & Finish -->
    <div class="form-step" data-step="2">
      <div class="step-lead">
        <h3>Step 2 · Formulation Texture & Performance Attributes</h3>
        <p>Define the physical sensory attributes, optical effects, and claims for your lab benchmark.</p>
      </div>

      <div class="options-matrix">
        <div class="options-group">
          <label class="field-label">Texture & Finish Style (Select Primary)</label>
          <div class="pill-group">
            <label class="pill-option">
              <input type="radio" name="texture_finish" value="High-Gloss Mirror Glaze" checked />
              <span>Mirror Glass Glaze (Non-Sticky)</span>
            </label>
            <label class="pill-option">
              <input type="radio" name="texture_finish" value="Soft-Focus Velvet Matte" />
              <span>Soft-Focus Velvet Blur</span>
            </label>
            <label class="pill-option">
              <input type="radio" name="texture_finish" value="Weightless Water Tint" />
              <span>Weightless Jelly Water Tint</span>
            </label>
            <label class="pill-option">
              <input type="radio" name="texture_finish" value="Nourishing Melting Butter" />
              <span>Melting Butter / Cushion Salve</span>
            </label>
          </div>
        </div>

        <div class="options-group">
          <label class="field-label">Active Performance Enhancements (Select all that apply)</label>
          <div class="checkbox-grid">
            <label class="check-pill">
              <input type="checkbox" name="actives" value="Palmitoyl Tripeptide-1 Plumping" checked />
              <span>Tripeptide Collagen Plumping</span>
            </label>
            <label class="check-pill">
              <input type="checkbox" name="actives" value="Hyaluronic Acid Micro-Spheres" checked />
              <span>Sodium Hyaluronate Spheres</span>
            </label>
            <label class="check-pill">
              <input type="checkbox" name="actives" value="Multi-Ceramide Barrier Complex" />
              <span>Ceramide NP/AP Lipid Complex</span>
            </label>
            <label class="check-pill">
              <input type="checkbox" name="actives" value="Pure Botanical Squalane Base" />
              <span>100% Plant Squalane Base</span>
            </label>
            <label class="check-pill">
              <input type="checkbox" name="actives" value="Vitamin E & Ferulic Antioxidant" />
              <span>Vitamin E Antioxidant Shield</span>
            </label>
            <label class="check-pill">
              <input type="checkbox" name="actives" value="Multi-Chrome Mica Shimmer" />
              <span>Multi-Chrome Synthetic Pearl</span>
            </label>
          </div>
        </div>

        <div class="options-group">
          <label class="field-label">Clean Standard Claims</label>
          <div class="clean-tags">
            <span class="spec-chip">✓ 100% Vegan & Cruelty-Free</span>
            <span class="spec-chip">✓ Paraben & Phthalate Free</span>
            <span class="spec-chip">✓ D4/D5 Cyclic Silicone Free</span>
            <span class="spec-chip">✓ Zero Microplastics (EU 2023/2055)</span>
          </div>
        </div>
      </div>

      <div class="step-nav-footer">
        <button type="button" class="btn ghost btn-prev" data-prev="1">← Back</button>
        <button type="button" class="btn btn-next" data-next="3">Next: Regulatory & Market →</button>
      </div>
    </div>

    <!-- STEP 3: Regulatory & Target Markets -->
    <div class="form-step" data-step="3">
      <div class="step-lead">
        <h3>Step 3 · Target Markets & Regulatory Compliance Dossiers</h3>
        <p>We tailor toxicology assessments, ingredient purity screenings, and safety documentation to your destination.</p>
      </div>

      <div class="market-selection-grid">
        <label class="market-card">
          <input type="checkbox" name="target_markets" value="United States (FDA / MoCRA)" checked />
          <div class="market-box">
            <div class="flag">🇺🇸</div>
            <div class="market-details">
              <strong>United States</strong>
              <span>FDA MoCRA Facility & Listing, USP 51/61 Antimicrobial, FDA Certified Color Lakes</span>
            </div>
          </div>
        </label>

        <label class="market-card">
          <input type="checkbox" name="target_markets" value="European Union (CPNP & CPSR)" checked />
          <div class="market-box">
            <div class="flag">🇪🇺</div>
            <div class="market-details">
              <strong>European Union</strong>
              <span>EC 1223/2009 CPNP Notification, Eurotox CPSR Part A/B, Annex II/III Screening</span>
            </div>
          </div>
        </label>

        <label class="market-card">
          <input type="checkbox" name="target_markets" value="United Kingdom (SCPN / UKCA)" />
          <div class="market-box">
            <div class="flag">🇬🇧</div>
            <div class="market-details">
              <strong>United Kingdom</strong>
              <span>UK Cosmetics Regulation & Submit Cosmetic Product Notification (SCPN)</span>
            </div>
          </div>
        </label>

        <label class="market-card">
          <input type="checkbox" name="target_markets" value="Canada / Australia / Global" />
          <div class="market-box">
            <div class="flag">🌐</div>
            <div class="market-details">
              <strong>Canada / Australia / Rest of World</strong>
              <span>Health Canada Cosmetic Notification (CNF), AICIS Compliance, Global SDS/MSDS</span>
            </div>
          </div>
        </label>
      </div>

      <div class="cert-assurance-bar">
        <span class="cert-badge">ISO 22716:2007 GMP</span>
        <span class="cert-badge">US FDA cGMP Verified</span>
        <span class="cert-badge">Class 100,000 Cleanroom</span>
        <span class="cert-badge">Eurotox CPSR Certified</span>
      </div>

      <div class="step-nav-footer">
        <button type="button" class="btn ghost btn-prev" data-prev="2">← Back</button>
        <button type="button" class="btn btn-next" data-next="4">Next: Quantity & Packaging →</button>
      </div>
    </div>

    <!-- STEP 4: Quantity & Packaging Componentry -->
    <div class="form-step" data-step="4">
      <div class="step-lead">
        <h3>Step 4 · Production Quantity & Packaging Architecture</h3>
        <p>Take advantage of our 500 pcs universal low MOQ. Select componentry from our prestige inventory or custom tooling.</p>
      </div>

      <div class="quantity-section">
        <label class="field-label">Production Quantity Tier (per SKU)</label>
        <div class="tier-cards">
          <label class="tier-card">
            <input type="radio" name="production_volume" value="500 pcs (Agile Launch Pack)" checked />
            <div class="tier-inner">
              <span class="tier-badge">Recommended for Launch</span>
              <span class="tier-qty">500 pcs</span>
              <span class="tier-desc">Zero dead-stock risk. Test 2–3 hero shades with full custom formula & silkscreening.</span>
              <span class="tier-leadtime">⚡ 7-Day Sample · 18-Day Bulk</span>
            </div>
          </label>

          <label class="tier-card">
            <input type="radio" name="production_volume" value="1,000 pcs (Growth Scale)" />
            <div class="tier-inner">
              <span class="tier-qty">1,000 pcs</span>
              <span class="tier-desc">Optimal unit margin economics. Custom hot-stamping & metallic collars included.</span>
              <span class="tier-leadtime">⚡ 7-Day Sample · 20-Day Bulk</span>
            </div>
          </label>

          <label class="tier-card">
            <input type="radio" name="production_volume" value="3,000+ pcs (Enterprise Scale)" />
            <div class="tier-inner">
              <span class="tier-qty">3,000+ pcs</span>
              <span class="tier-desc">Volume factory discounts. Custom mold tooling & exclusive silhouette options.</span>
              <span class="tier-leadtime">⚡ 7-Day Sample · 22-Day Bulk</span>
            </div>
          </label>
        </div>
      </div>

      <div class="packaging-section" style="margin-top: 24px;">
        <label class="field-label">Preferred Packaging Component Style</label>
        <div class="pkg-grid">
          <label class="pkg-tile">
            <input type="radio" name="packaging_style" value="Prestige Heavyweight Acrylic (Square/Round)" checked />
            <span>💎 Heavyweight Thick-Wall Acrylic (Prestige Glass Feel)</span>
          </label>
          <label class="pkg-tile">
            <input type="radio" name="packaging_style" value="Magnetic Zamac / Aluminum Bullet Tube" />
            <span>🧲 350g Magnetic Zamac / Anodized Aluminum Bullet</span>
          </label>
          <label class="pkg-tile">
            <input type="radio" name="packaging_style" value="Zinc-Alloy Cryo Cooling Contour Applicator" />
            <span>❄️ Zinc-Alloy Cryo Sculpting / Ceramic Applicator Tip</span>
          </label>
          <label class="pkg-tile">
            <input type="radio" name="packaging_style" value="Slim Retractable Mechanical Barrel" />
            <span>🖊️ 1.5mm Micro-Lead Retractable Barrel</span>
          </label>
          <label class="pkg-tile">
            <input type="radio" name="packaging_style" value="Bespoke Private Mold Tooling" />
            <span>⚙️ Custom Proprietary Mold Opening</span>
          </label>
        </div>
      </div>

      <div class="step-nav-footer">
        <button type="button" class="btn ghost btn-prev" data-prev="3">← Back</button>
        <button type="button" class="btn btn-next" data-next="5">Next: Instant Estimate & Dispatch →</button>
      </div>
    </div>

    <!-- STEP 5: Buyer Details, Estimate & Instant Dispatch -->
    <div class="form-step" data-step="5">
      <div class="step-lead">
        <h3>Step 5 · Immediate Specification Ticket & Engineering Handoff</h3>
        <p>Review your customized specifications, view the live timeline & budget estimation, and dispatch your ticket.</p>
      </div>

      <!-- Real-time Spec Summary Card -->
      <div class="live-ticket-card" id="spec-ticket-card">
        <div class="ticket-header">
          <span class="ticket-status">✓ Production Spec Ready</span>
          <span class="ticket-code" id="ticket-id">MLM-2026-LIP</span>
        </div>
        <div class="ticket-body">
          <div class="ticket-row"><strong>Category:</strong> <span id="summary-cat">Lip Gloss</span></div>
          <div class="ticket-row"><strong>Formula Finish:</strong> <span id="summary-finish">Mirror Glass Glaze</span></div>
          <div class="ticket-row"><strong>Volume Tier:</strong> <span id="summary-volume">500 pcs (Agile Launch Pack)</span></div>
          <div class="ticket-row"><strong>Packaging:</strong> <span id="summary-pkg">Heavyweight Thick-Wall Acrylic</span></div>
          <div class="ticket-row"><strong>Compliance:</strong> <span id="summary-reg">FDA / MoCRA, EU CPNP</span></div>
          <div class="ticket-row"><strong>Sampling Guarantee:</strong> <span>7 Business Days (100% Credited to Bulk Order)</span></div>
          <div class="ticket-row highlight"><strong>Estimated Unit Price Range:</strong> <span id="summary-price">$1.85 – $2.65 / pc (FOB Shenzhen/Huizhou)</span></div>
        </div>
      </div>

      <!-- Contact Inputs -->
      <div class="buyer-contact-grid" style="margin-top: 24px;">
        <div class="form-field">
          <label for="cfg-email">Corporate Work Email <span class="required">*</span></label>
          <input type="email" id="cfg-email" name="buyer_email" required placeholder="founder@yourbrand.com" />
          <span class="field-hint" id="cfg-email-hint">Official lab benchmark report & pricing breakdown will be delivered here.</span>
        </div>

        <div class="form-field">
          <label for="cfg-brand">Brand / Company Name <span class="required">*</span></label>
          <input type="text" id="cfg-brand" name="buyer_brand" required placeholder="e.g. Dahlia Cosmetics Paris" />
        </div>

        <div class="form-field">
          <label for="cfg-whatsapp">WhatsApp Number (Optional, for instant direct chat)</label>
          <input type="tel" id="cfg-whatsapp" name="buyer_whatsapp" placeholder="+1 (555) 019-2834" />
        </div>

        <div class="form-field">
          <label for="cfg-notes">Specific Shade / Benchmark Notes (Optional)</label>
          <textarea id="cfg-notes" name="project_notes" rows="2" placeholder="e.g. Reference Fenty Gloss Bomb shade 'Fenty Glow' or Rhode Peptide Lip Tint..."></textarea>
        </div>
      </div>

      <div class="submit-actions-panel">
        <button type="submit" class="btn btn-primary-submit" id="btn-submit-ticket">
          Submit Brief & Lock In 7-Day Sample Slot →
        </button>
        <button type="button" class="btn btn-whatsapp-direct" id="btn-whatsapp-ticket">
          Dispatch Instantly to Chief Chemist via WhatsApp 💬
        </button>
      </div>

      <div id="cfg-submission-status" class="submission-alert" style="display: none;"></div>

      <p class="data-privacy-notice">
        🔒 Non-Disclosure & Proprietary Protection Guaranteed. We sign mutual NDAs before custom shade lab work. Beautychain Limited does not disclose client formulations to third parties.
      </p>

      <div class="step-nav-footer">
        <button type="button" class="btn ghost btn-prev" data-prev="4">← Back to Packaging</button>
        <div></div>
      </div>
    </div>
  </form>
</div>

<style>
  .lip-configurator-card {
    background: #ffffff;
    border-radius: var(--radius, 16px);
    border: 1px solid var(--line, #e8d7dc);
    box-shadow: 0 10px 30px rgba(74, 21, 37, 0.08);
    overflow: hidden;
    margin: 24px auto;
    max-width: 860px;
    font-family: inherit;
  }

  .config-header {
    background: linear-gradient(135deg, #2f0c17 0%, #4a1525 60%, #6e1a32 100%);
    color: #ffffff;
    padding: 32px 36px 28px;
    border-bottom: 3px solid var(--gold, #b08d4b);
  }

  .config-badge {
    display: inline-block;
    background: rgba(176, 141, 75, 0.25);
    color: #f7dfa5;
    border: 1px solid rgba(176, 141, 75, 0.6);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .config-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3vw, 32px);
    color: #ffffff;
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.25;
  }

  .config-subtitle {
    color: #f3dde3;
    font-size: 14px;
    margin: 0 0 24px;
    max-width: 620px;
  }

  /* Step Progress */
  .step-progress-wrapper {
    margin-top: 20px;
  }

  .step-dots {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  .step-dot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    position: relative;
    z-index: 2;
  }

  .step-dot span {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: 2px solid rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    transition: all 0.3s ease;
  }

  .step-dot label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 600;
  }

  .step-dot.active span, .step-dot.completed span {
    background: var(--gold, #b08d4b);
    border-color: #fcebc2;
    color: #2f0c17;
    box-shadow: 0 0 14px rgba(176, 141, 75, 0.6);
  }

  .step-dot.active label, .step-dot.completed label {
    color: #ffffff;
  }

  .step-line {
    flex: 1;
    height: 2px;
    background: rgba(255, 255, 255, 0.2);
    margin: -18px 8px 0;
    transition: background 0.3s ease;
  }

  .step-line.active {
    background: var(--gold, #b08d4b);
  }

  /* Form Container */
  .config-form {
    padding: 36px 36px 32px;
  }

  .form-step {
    display: none;
    animation: fadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .form-step.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .step-lead {
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line, #e8d7dc);
    padding-bottom: 16px;
  }

  .step-lead h3 {
    font-size: 20px;
    color: var(--burgundy, #6e1a32);
    margin: 0 0 6px;
  }

  .step-lead p {
    font-size: 14px;
    color: var(--ink-soft, #4a3e42);
    margin: 0;
  }

  /* Step 1: Tiles */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }

  .choice-tile input[type="radio"],
  .pill-option input[type="radio"],
  .tier-card input[type="radio"],
  .pkg-tile input[type="radio"],
  .market-card input[type="checkbox"],
  .check-pill input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .choice-tile {
    cursor: pointer;
    position: relative;
  }

  .tile-card {
    border: 2px solid var(--line, #e8d7dc);
    border-radius: 12px;
    padding: 18px 16px;
    background: #ffffff;
    transition: all 0.2s ease;
    display: flex;
    gap: 14px;
    height: 100%;
  }

  .tile-card:hover {
    border-color: #caa0af;
    background: var(--blush-soft, #faf2f5);
  }

  .choice-tile input:checked + .tile-card {
    border-color: var(--burgundy, #6e1a32);
    background: #fdf6f8;
    box-shadow: 0 4px 12px rgba(110, 26, 50, 0.1);
  }

  .tile-icon {
    font-size: 28px;
    line-height: 1;
  }

  .tile-info h4 {
    font-size: 16px;
    color: var(--ink, #141013);
    margin: 0 0 4px;
  }

  .tile-info p {
    font-size: 12px;
    color: var(--ink-soft, #4a3e42);
    margin: 0 0 8px;
    line-height: 1.4;
  }

  .tile-tag {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--blush, #f4e2e7);
    color: var(--plum, #4a1525);
    padding: 2px 8px;
    border-radius: 6px;
    display: inline-block;
  }

  /* Step 2: Texture & Finishes */
  .options-matrix {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .field-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink, #141013);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 12px;
  }

  .pill-group {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }

  .pill-option {
    cursor: pointer;
  }

  .pill-option span {
    display: block;
    padding: 12px 16px;
    border-radius: 8px;
    border: 1px solid var(--line, #e8d7dc);
    font-size: 13px;
    font-weight: 600;
