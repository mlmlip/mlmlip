            <textarea id="lb-message" name="message" rows="4" required placeholder="Share your target butter/oil profile, SPF level, flavor/scent, packaging preference (stock vs custom mold), and target market (US FDA / EU CPNP)..."></textarea>
          </div>

          <div style="margin-top: 12px;">
            <button id="lb-submit-btn" class="btn" type="submit" style="width: 100%; font-size: 15px; padding: 14px 20px;">
              Send Lip Balm Inquiry &amp; Request 7-Day Samples &rarr;
            </button>
          </div>
          <div id="lb-status" style="display: none; margin-top: 14px; padding: 12px 16px; border-radius: 8px; font-size: 14px; text-align: center;"></div>
        </form>
      </div>
    </div>
  </section>

  <!-- Dedicated FAQ Module -->
  <section>
    <div class="wrap">
      <p class="eyebrow">Frequently asked</p>
      <h2>Private Label Lip Balm — Technical &amp; Commercial FAQ</h2>
      <div class="grid two" style="margin-top: 28px; gap: 20px;">
        {faqs.map((f) => (
          <div class="card">
            <h3 style="font-size: 18px; margin-bottom: 10px; color: var(--plum);">{f.q}</h3>
            <p style="margin: 0; color: var(--ink-soft); line-height: 1.65;">{f.a}</p>
          </div>
        ))}
      </div>
      <p style="margin-top: 28px;"><a href="/faq">Explore all manufacturing FAQs &rarr;</a></p>
    </div>
  </section>

  <!-- Final Footer CTA -->
  <section class="tint">
    <div class="wrap">
      <div class="card" style="text-align: center; padding: 48px 28px; background: #fff;">
        <h2 style="margin-bottom: 10px;">Launch your private label lip balm line</h2>
        <p class="lead" style="max-width: 600px; margin: 0 auto 24px;">
          100-200 pcs MOQ on standard packaging, 500 pcs on custom molds, 7-day rapid sampling, and full ISO 22716 / GMPC / FDA / MSDS dossiers included.
        </p>
        <a class="btn" href="/quote?product=Lip%20Balm&source=lip-balm-landing">Get a Lip Balm Quote &rarr;</a>
        <a class="btn ghost" href="/cases" style="margin-left: 12px;">View Factory Cases</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { submitInquiryDualTrack } from '../lib/inquiryClient';

  const lbForm = document.getElementById('lip-balm-quote-form') as HTMLFormElement | null;
  const lbStatus = document.getElementById('lb-status');
  const lbBtn = document.getElementById('lb-submit-btn') as HTMLButtonElement | null;

  lbForm?.addEventListener('submit', async function (e) {
    e.preventDefault();
    if (!lbForm) return;
    const payload = Object.fromEntries(new FormData(lbForm).entries());
    await submitInquiryDualTrack({
      payload,
      formElement: lbForm,
      submitButton: lbBtn,
      statusElement: lbStatus,
      source: 'lip-balm-landing',
      redirectingText: '✓ Redirecting to WhatsApp...',
    });
  });
</script>
