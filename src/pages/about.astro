  <script is:inline>
    (function() {
      const modal = document.getElementById('gated-modal');
      const closeBtn = document.getElementById('gated-close');
      const docNameEl = document.getElementById('gated-doc-name');
      const requestedInput = document.getElementById('gated-requested-doc');
      const form = document.getElementById('gated-download-form');
      const resultBox = document.getElementById('gated-result');
      const directLink = document.getElementById('gated-direct-link');
      const submitBtn = document.getElementById('gd-submit-btn');

      let currentPdfUrl = '';
      const gdEmailInput = document.getElementById('gd-email');
      const gdEmailNotice = document.getElementById('gd-email-notice');
      const consumerDomains = ['gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'qq.com', '163.com'];

      gdEmailInput?.addEventListener('input', () => {
        const val = (gdEmailInput.value || '').trim().toLowerCase();
        const parts = val.split('@');
        if (parts.length === 2 && consumerDomains.includes(parts[1])) {
          if (gdEmailNotice) gdEmailNotice.style.display = 'block';
        } else {
          if (gdEmailNotice) gdEmailNotice.style.display = 'none';
        }
      });

      document.querySelectorAll('.gated-download-trigger').forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          currentPdfUrl = link.getAttribute('data-pdf') || '#';
          const docTitle = link.getAttribute('data-doc') || 'Compliance Document';
          if (docNameEl) docNameEl.textContent = docTitle;
          if (requestedInput) requestedInput.value = docTitle;
          if (directLink) directLink.setAttribute('href', currentPdfUrl);

          if (resultBox) resultBox.setAttribute('hidden', '');
          if (form) form.style.display = 'block';
          modal?.removeAttribute('hidden');
        });
      });

      closeBtn?.addEventListener('click', () => {
        modal?.setAttribute('hidden', '');
      });

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) modal.setAttribute('hidden', '');
      });

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Unlocking...';
        }
        try {
          const formData = new FormData(form);
          await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: formData
          });
        } catch (err) {
          // Proceed to reveal download link even if offline or placeholder key
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = 'Unlock &amp; Show Download Link &rarr;';
          }
          if (typeof window.gtag === 'function') { window.gtag('event', 'generate_lead', { event_category: 'Lead Magnet', event_label: 'Compliance Dossier' }); }
          form.style.display = 'none';
          resultBox?.removeAttribute('hidden');
        }
      });
    })();
  </script>
