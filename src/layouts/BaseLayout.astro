---
import { site, footerCategories, footerCompany } from '../data/site';
import '../styles/global.css';

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://mlmlip.com');

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": site.name,
  "legalName": site.manufacturer,
  "url": site.domain,
  "logo": `${site.domain}/favicon.svg`,
  "description": "Tier-1 private label custom lip cosmetics manufacturer specializing in lip gloss, lip mud, lip oil, lipstick, and lip masks with a universal 500 pcs MOQ.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Shenzhen",
    "addressCountry": "CN"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": site.contact.whatsapp,
    "contactType": "sales",
    "availableLanguage": ["English", "French", "Spanish"]
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Custom Lip Cosmetics OEM/ODM Catalog",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "High-Impact Lip Gloss Private Label" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Velvet Lip Mud & Tint Manufacturing" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Skinified Peptide Lip Oil OEM/ODM" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Precision Lip Liner Production" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom Lipstick & Bullet Case Tooling" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Barrier Repair Lip Mask Production" } }
    ]
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#4a1525" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={canonical.href} />
    <link rel="alternate" hreflang="x-default" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&display=swap" /></noscript>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={`${site.domain}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MLM Lip — Private label lip cosmetics manufacturer. 500 pcs MOQ, 7-day sampling, GMPC + ISO + CPNP." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site.domain}/og-image.png`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">MLM<span>Lip</span></a>
        <nav class="nav" id="primary-nav">
          {site.nav.map((item) => (
            <a href={item.href} class={Astro.url.pathname === item.href ? 'is-active' : ''}>{item.label}</a>
          ))}
          <a class="btn" href="/quote">Get a quote</a>
        </nav>
        <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="nav-drawer" id="nav-drawer" hidden>
        <div class="wrap">
          {site.nav.map((item) => (
            <a href={item.href} class={Astro.url.pathname === item.href ? 'is-active' : ''}>{item.label}</a>
          ))}
          <a class="btn" href="/quote" style="margin-top: 8px; display: inline-block;">Get a quote</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="grid three">
          <div>
            <p class="brand">MLM<span>Lip</span></p>
            <p style="color:#e9c9d3; max-width: 320px;">
              Private label lip cosmetics manufacturing — packaging, formulation and logo customization from {site.moq} per SKU.
            </p>
            <p style="color:#d6b3be; font-size:13px; margin-top:16px;">
              GMPC · ISO 22716 · EU CPNP support
            </p>
          </div>
          <div>
            <p style="color:#f3dde3; margin-bottom:10px;">Manufacturing</p>
            <p style="color:#e9c9d3; margin:0; line-height:1.9;">
              {footerCategories.map((l) => (
                <><a href={l.href}>{l.label}</a><br /></>
              ))}
            </p>
          </div>
          <div>
            <p style="color:#f3dde3; margin-bottom:10px;">Get in touch</p>
            <p style="color:#e9c9d3; margin:0 0 14px; line-height:1.9;">
              WhatsApp: <a href={site.contact.whatsappLink} target="_blank" rel="noopener">{site.contact.whatsapp}</a><br />
              Email: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a><br />
              {site.contact.address}
            </p>
            <p style="color:#e9c9d3; margin:0; line-height:1.9;">
              {footerCompany.slice(0, 5).map((l) => (
                <><a href={l.href}>{l.label}</a> · </>
              ))}
            </p>
          </div>
        </div>
        <p style="color:#d6b3be; margin-top:32px; font-size:13px">
          {new Date().getFullYear()} {site.name} · Manufactured by {site.manufacturer}
        </p>
      </div>
    </footer>

    <a class="wa-float" href={`${site.contact.whatsappLink}?text=${encodeURIComponent("Hi MLM Lip, I'd like to discuss a private label lip project.")}`} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path d="M17.5 14.4c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.7.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.7-1.7-.9-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3.1 5 4.3 2.5 1 3 .8 3.6.8.6-.1 1.9-.8 2.1-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/>
      </svg>
      <span>WhatsApp</span>
    </a>

    <script is:inline>
      const toggle = document.getElementById('nav-toggle');
      const drawer = document.getElementById('nav-drawer');
      toggle?.addEventListener('click', () => {
        const open = drawer?.hasAttribute('hidden');
        if (open) { drawer?.removeAttribute('hidden'); toggle.setAttribute('aria-expanded', 'true'); }
        else { drawer?.setAttribute('hidden', ''); toggle.setAttribute('aria-expanded', 'false'); }
      });
    </script>

    <script is:inline>
      // 滚动渐入动画 — 轻量 Intersection Observer
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('revealed');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.card, section .grid > *, .timeline > li').forEach((el) => {
          el.classList.add('reveal');
          io.observe(el);
        });
      }
    </script>
  </body>
</html>
