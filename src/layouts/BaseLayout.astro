---
import { site, footerCategories, footerCompany } from '../data/site';
import '../styles/global.css';

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://mlmlip.com');

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": site.name,
  "legalName": site.manufacturer,
  "url": site.domain,
  "logo": `${site.domain}/favicon.svg`,
  "description": "Tier-1 private label custom lip cosmetics manufacturer specializing in lip gloss, lip mud, lip oil, lipstick, and lip masks with a universal 500 pcs MOQ.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Shenzhen",
    "addressCountry": "CN"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": site.contact.whatsapp,
    "contactType": "sales",
    "availableLanguage": ["English", "French", "Spanish"]
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Custom Lip Cosmetics OEM/ODM Catalog",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "High-Impact Lip Gloss Private Label" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Velvet Lip Mud & Tint Manufacturing" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Skinified Peptide Lip Oil OEM/ODM" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Precision Lip Liner Production" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom Lipstick & Bullet Case Tooling" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Barrier Repair Lip Mask Production" } }
    ]
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">MLM<span>Lip</span></a>
        <nav class="nav">
          {site.nav.map((item) => (
            <a href={item.href} class={Astro.url.pathname === item.href ? 'is-active' : ''}>{item.label}</a>
          ))}
          <a class="btn" href="/contact">Get a quote</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="grid three">
          <div>
            <p class="brand">MLM<span>Lip</span></p>
            <p style="color:#e9c9d3; max-width: 320px;">
              Private label lip cosmetics manufacturing — packaging, formulation and logo customization from {site.moq} per SKU.
            </p>
            <p style="color:#d6b3be; font-size:13px; margin-top:16px;">
              GMPC · ISO 22716 · EU CPNP support
            </p>
          </div>
          <div>
            <p style="color:#f3dde3; margin-bottom:10px;">Manufacturing</p>
            <p style="color:#e9c9d3; margin:0; line-height:1.9;">
              {footerCategories.map((l) => (
                <><a href={l.href}>{l.label}</a><br /></>
              ))}
            </p>
          </div>
          <div>
            <p style="color:#f3dde3; margin-bottom:10px;">Get in touch</p>
            <p style="color:#e9c9d3; margin:0 0 14px; line-height:1.9;">
              WhatsApp: <a href={site.contact.whatsappLink} target="_blank" rel="noopener">{site.contact.whatsapp}</a><br />
              Email: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a><br />
              {site.contact.address}
            </p>
            <p style="color:#e9c9d3; margin:0; line-height:1.9;">
              {footerCompany.slice(0, 5).map((l) => (
                <><a href={l.href}>{l.label}</a> · </>
              ))}
            </p>
          </div>
        </div>
        <p style="color:#d6b3be; margin-top:32px; font-size:13px">
          {new Date().getFullYear()} {site.name} · Manufactured by {site.manufacturer}
        </p>
      </div>
    </footer>

    <a class="wa-float" href={`${site.contact.whatsappLink}?text=${encodeURIComponent("Hi MLM Lip, I'd like to discuss a private label lip project.")}`} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path d="M17.5 14.4c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.7.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.7-1.7-.9-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3.1 5 4.3 2.5 1 3 .8 3.6.8.6-.1 1.9-.8 2.1-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/>
      </svg>
      <span>WhatsApp</span>
    </a>
  </body>
</html>
