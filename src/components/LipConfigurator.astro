  }

  .tier-card input:checked + .tier-inner {
    border-color: var(--burgundy, #6e1a32);
    background: #fffafb;
    box-shadow: 0 4px 16px rgba(110, 26, 50, 0.1);
  }

  .tier-badge {
    position: absolute;
    top: -10px;
    right: 14px;
    background: var(--gold, #b08d4b);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 12px;
    letter-spacing: 0.05em;
  }

  .tier-qty {
    font-size: 22px;
    font-weight: 800;
    color: var(--burgundy, #6e1a32);
    margin-bottom: 6px;
  }

  .tier-desc {
    font-size: 12px;
    color: var(--ink-soft, #4a3e42);
    line-height: 1.45;
    margin-bottom: 12px;
    flex: 1;
  }

  .tier-leadtime {
    font-size: 11px;
    font-weight: 600;
    color: #276749;
    background: #edfdf2;
    padding: 4px 8px;
    border-radius: 6px;
    display: inline-block;
  }

  .pkg-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pkg-tile {
    cursor: pointer;
  }

  .pkg-tile span {
    display: block;
    padding: 12px 16px;
    border: 1px solid var(--line, #e8d7dc);
    border-radius: 8px;
    background: #fff;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink, #141013);
    transition: all 0.2s;
  }

  .pkg-tile input:checked + span {
    border-color: var(--burgundy, #6e1a32);
    background: #fbf1f4;
    color: var(--burgundy, #6e1a32);
  }

  /* Step 5: Ticket & Final Form */
  .live-ticket-card {
    background: #faf4f6;
    border: 1.5px dashed #caa0af;
    border-radius: 12px;
    padding: 20px 24px;
  }

  .ticket-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(110, 26, 50, 0.15);
    padding-bottom: 12px;
    margin-bottom: 14px;
  }

  .ticket-status {
    font-size: 12px;
    font-weight: 700;
    color: #1e7044;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .ticket-code {
    font-family: monospace;
    font-size: 12px;
    background: #ffffff;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--line, #e8d7dc);
    color: var(--burgundy, #6e1a32);
    font-weight: 700;
  }

  .ticket-body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 10px 20px;
    font-size: 13px;
  }

  .ticket-row {
    color: var(--ink-soft, #4a3e42);
  }

  .ticket-row strong {
    color: var(--ink, #141013);
    margin-right: 6px;
  }

  .ticket-row.highlight {
    grid-column: 1 / -1;
    background: #fff;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid #ecd3dc;
    margin-top: 6px;
  }

  .ticket-row.highlight span {
    color: var(--burgundy, #6e1a32);
    font-weight: 800;
    font-size: 15px;
  }

  .buyer-contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field:nth-child(4) {
    grid-column: 1 / -1;
  }

  .form-field label {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink, #141013);
  }

  .form-field .required {
    color: var(--burgundy, #6e1a32);
  }

  .form-field input, .form-field textarea {
    padding: 12px 14px;
    border: 1.5px solid var(--line, #e8d7dc);
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    color: var(--ink, #141013);
    transition: border-color 0.2s;
  }

  .form-field input:focus, .form-field textarea:focus {
    outline: none;
    border-color: var(--burgundy, #6e1a32);
    box-shadow: 0 0 0 3px rgba(110, 26, 50, 0.1);
  }

  .field-hint {
    font-size: 11px;
    color: #8c727a;
  }

  .submit-actions-panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 24px;
  }

  .btn-primary-submit {
    background: var(--burgundy, #6e1a32);
    color: #fff;
    border: none;
    padding: 16px 24px;
    font-size: 16px;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    box-shadow: 0 4px 14px rgba(110, 26, 50, 0.25);
  }

  .btn-primary-submit:hover {
    background: #541325;
    transform: translateY(-1px);
  }

  .btn-whatsapp-direct {
    background: #25d366;
    color: #fff;
    border: none;
    padding: 14px 20px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-whatsapp-direct:hover {
    background: #1eb956;
  }

  .data-privacy-notice {
    font-size: 11px;
    color: #8c727a;
    line-height: 1.5;
    margin-top: 14px;
    text-align: center;
  }

  .submission-alert {
    margin-top: 16px;
    padding: 14px 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
  }

  .submission-alert.success {
    background: #def7ec;
    color: #03543f;
    border: 1px solid #84e1bc;
  }

  .submission-alert.error {
    background: #fde8e8;
    color: #9b1c1c;
    border: 1px solid #f8b4b4;
  }

  /* Navigation Footer */
  .step-nav-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line, #e8d7dc);
  }

  .btn-next {
    background: var(--burgundy, #6e1a32);
    color: #ffffff;
    font-weight: 600;
    padding: 12px 24px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: 14px;
  }

  .btn-next:hover {
    background: #541325;
  }

  .btn-prev {
    font-size: 13px;
    color: var(--ink-soft, #4a3e42);
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .config-header { padding: 24px 20px; }
    .config-form { padding: 24px 20px; }
    .buyer-contact-grid { grid-template-columns: 1fr; }
    .step-dot label { display: none; }
  }
</style>

<script is:inline>
  (function() {
    const root = document.getElementById('lip-configurator');
    if (!root) return;

    let currentStep = 1;
    const totalSteps = 5;

    // Elements
    const form = root.querySelector('#configurator-form');
    const steps = root.querySelectorAll('.form-step');
    const stepIndicators = root.querySelectorAll('.step-dot');
    const stepLines = root.querySelectorAll('.step-line');

    // Summary Elements
    const summaryCat = root.querySelector('#summary-cat');
    const summaryFinish = root.querySelector('#summary-finish');
    const summaryVolume = root.querySelector('#summary-volume');
    const summaryPkg = root.querySelector('#summary-pkg');
    const summaryReg = root.querySelector('#summary-reg');
    const summaryPrice = root.querySelector('#summary-price');
    const ticketId = root.querySelector('#ticket-id');

    // Generate random Ticket ID
    const randomTicketNum = Math.floor(1000 + Math.random() * 9000);
    if (ticketId) ticketId.textContent = 'MLM-2026-LIP-' + randomTicketNum;

    // Price Matrix Calculator
    function updateEstimateSummary() {
      const category = form.querySelector('input[name="category"]:checked')?.value || 'Lip Gloss';
      const finish = form.querySelector('input[name="texture_finish"]:checked')?.value || 'Mirror Glass Glaze';
      const volume = form.querySelector('input[name="production_volume"]:checked')?.value || '500 pcs';
      const packaging = form.querySelector('input[name="packaging_style"]:checked')?.value || 'Heavyweight Acrylic';
      
      const markets = Array.from(form.querySelectorAll('input[name="target_markets"]:checked')).map(el => el.value);

      if (summaryCat) summaryCat.textContent = category;
      if (summaryFinish) summaryFinish.textContent = finish;
      if (summaryVolume) summaryVolume.textContent = volume;
      if (summaryPkg) summaryPkg.textContent = packaging.split('(')[0].replace(/💎|🧲|❄️|🖊️|⚙️/g, '').trim();
      if (summaryReg) summaryReg.textContent = markets.length > 0 ? markets.map(m => m.split(' ')[0]).join(', ') : 'Global Compliance';

      // Dynamic unit price estimate based on volume & category
      let minP = 1.85;
      let maxP = 2.65;

      if (volume.includes('500 pcs')) {
        minP = 1.95; maxP = 2.95;
      } else if (volume.includes('1,000 pcs')) {
        minP = 1.65; maxP = 2.45;
      } else {
        minP = 1.35; maxP = 1.98;
      }

      if (category.includes('Lipstick') || packaging.includes('Zamac')) {
        minP += 0.40; maxP += 0.65;
      }
      if (summaryPrice) {
        summaryPrice.textContent = `$${minP.toFixed(2)} – $${maxP.toFixed(2)} / pc (FOB Shenzhen/Huizhou)`;
      }
    }

    function goToStep(targetStep) {
      if (targetStep < 1 || targetStep > totalSteps) return;

      steps.forEach(step => {
        const stepNum = parseInt(step.getAttribute('data-step') || '1');
        if (stepNum === targetStep) {
          step.classList.add('active');
        } else {
          step.classList.remove('active');
        }
      });

      stepIndicators.forEach(ind => {
        const num = parseInt(ind.getAttribute('data-step-indicator') || '1');
        ind.classList.remove('active', 'completed');
        if (num === targetStep) {
          ind.classList.add('active');
        } else if (num < targetStep) {
          ind.classList.add('completed');
        }
      });

      stepLines.forEach(line => {
        const lineNum = parseInt(line.getAttribute('data-line') || '1');
        if (lineNum < targetStep) {
          line.classList.add('active');
        } else {
          line.classList.remove('active');
        }
      });

      currentStep = targetStep;
      updateEstimateSummary();

      // Scroll smoothly to configurator top if out of view
      const topOffset = root.getBoundingClientRect().top + window.scrollY - 80;
      if (window.scrollY > topOffset) {
        window.scrollTo({ top: topOffset, behavior: 'smooth' });
      }
    }

    // Next / Prev Button events
    root.querySelectorAll('.btn-next').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const next = parseInt(this.getAttribute('data-next') || `${currentStep + 1}`);
        goToStep(next);
      });
    });

    root.querySelectorAll('.btn-prev').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const prev = parseInt(this.getAttribute('data-prev') || `${currentStep - 1}`);
        goToStep(prev);
      });
    });

    // Step dots direct click if already visited
    stepIndicators.forEach(dot => {
      dot.addEventListener('click', function() {
        const target = parseInt(this.getAttribute('data-step-indicator') || '1');
        goToStep(target);
      });
    });

    // Form inputs change listener for live calculations
    form.addEventListener('change', updateEstimateSummary);

    // Build plain-text brief
    function buildBriefText() {
      const category = form.querySelector('input[name="category"]:checked')?.value || 'Lip Gloss';
      const finish = form.querySelector('input[name="texture_finish"]:checked')?.value || 'Mirror Glaze';
      const actives = Array.from(form.querySelectorAll('input[name="actives"]:checked')).map(el => el.value).join(', ');
      const volume = form.querySelector('input[name="production_volume"]:checked')?.value || '500 pcs';
      const packaging = form.querySelector('input[name="packaging_style"]:checked')?.value || 'Heavyweight Acrylic';
      const markets = Array.from(form.querySelectorAll('input[name="target_markets"]:checked')).map(el => el.value).join('; ');
      const email = root.querySelector('#cfg-email')?.value || '';
      const brand = root.querySelector('#cfg-brand')?.value || '';
      const whatsapp = root.querySelector('#cfg-whatsapp')?.value || '';
      const notes = root.querySelector('#cfg-notes')?.value || '';

      return `*Custom Lip Formulation Brief — MLM Lip*\n` +
        `Ticket: ${ticketId?.textContent || 'MLM-LIP'}\n` +
        `Brand: ${brand || 'Pending'}\n` +
        `Contact Email: ${email}\n` +
        `WhatsApp: ${whatsapp || 'N/A'}\n` +
        `------------------------\n` +
        `Category: ${category}\n` +
        `Texture & Finish: ${finish}\n` +
        `Actives: ${actives || 'Standard prestige base'}\n` +
        `Target Markets: ${markets || 'Global'}\n` +
        `Volume Tier: ${volume}\n` +
        `Packaging Style: ${packaging}\n` +
        `Estimated Price Range: ${summaryPrice?.textContent || ''}\n` +
        `Notes / Benchmark: ${notes || 'Standard 7-day lab prototype requested'}`;
    }

    // Direct WhatsApp Dispatch Button
    const btnWhatsApp = root.querySelector('#btn-whatsapp-ticket');
    if (btnWhatsApp) {
      btnWhatsApp.addEventListener('click', function() {
        const emailInput = root.querySelector('#cfg-email');
        if (emailInput && !emailInput.checkValidity()) {
          emailInput.reportValidity();
          return;
        }
        const brief = buildBriefText();
        const url = `https://wa.me/8613652380291?text=${encodeURIComponent(brief)}`;
        window.open(url, '_blank', 'noopener');
      });
    }

    // Submit Handler (Web3Forms / n8n Webhook fallback)
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      const statusBox = root.querySelector('#cfg-submission-status');
      const submitBtn = root.querySelector('#btn-submit-ticket');

      const emailInput = root.querySelector('#cfg-email');
      const brandInput = root.querySelector('#cfg-brand');

      if (!emailInput.value || !emailInput.checkValidity()) {
        emailInput.reportValidity();
        return;
      }
      if (!brandInput.value) {
        brandInput.focus();
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Transmitting Formulation Brief to Lab...';
      }

      const payload = {
        access_key: 'b0681fa9-0cc8-4fd9-80f7-4d5faa39b2e7', // Web3Forms key
        subject: `New Lip Formulation Brief (${ticketId?.textContent || 'MLM-LIP'}) - ${brandInput.value}`,
        from_name: 'MLM Lip Formulation Configurator',
        buyer_email: emailInput.value,
        buyer_brand: brandInput.value,
        buyer_whatsapp: root.querySelector('#cfg-whatsapp')?.value || '',
        category: form.querySelector('input[name="category"]:checked')?.value || '',
        texture_finish: form.querySelector('input[name="texture_finish"]:checked')?.value || '',
        actives: Array.from(form.querySelectorAll('input[name="actives"]:checked')).map(el => el.value).join(', '),
        target_markets: Array.from(form.querySelectorAll('input[name="target_markets"]:checked')).map(el => el.value).join(', '),
        production_volume: form.querySelector('input[name="production_volume"]:checked')?.value || '',
        packaging_style: form.querySelector('input[name="packaging_style"]:checked')?.value || '',
        notes: root.querySelector('#cfg-notes')?.value || '',
        full_brief_summary: buildBriefText()
      };

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (response.ok && result.success) {
          if (statusBox) {
            statusBox.className = 'submission-alert success';
            statusBox.style.display = 'block';
            statusBox.innerHTML = `✓ <strong>Ticket Logged Successfully (${ticketId?.textContent})!</strong> Our formulation chemists have received your specs. An introductory sample schedule and official NDA will be sent to <em>${emailInput.value}</em> within 24 hours.`;
          }
          if (submitBtn) {
            submitBtn.textContent = '✓ Brief Dispatched to Engineering';
          }
          // Fire Analytics Lead Event
          if (typeof gtag === 'function') {
            gtag('event', 'generate_lead', {
              lead_type: 'interactive_configurator_ticket',
              category: payload.category,
              volume: payload.production_volume
            });
          }
        } else {
          throw new Error(result.message || 'Submission failed');
        }
      } catch (err) {
        if (statusBox) {
          statusBox.className = 'submission-alert error';
          statusBox.style.display = 'block';
          statusBox.innerHTML = `Submission delayed. Please click the <strong>Dispatch Instantly via WhatsApp</strong> button above or email us directly at <em>nancy@mlmlip.com</em>.`;
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Retry Submission →';
        }
      }
    });

    // Initial estimation
    updateEstimateSummary();
  })();
</script>
