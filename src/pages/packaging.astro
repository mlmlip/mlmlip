---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';

const packagingItems = [
  {
    name: '39-Shade Precision Doe-Foot Lip Glaze Component',
    category: 'Vials & Tubes',
    material: 'Heavyweight Virgin Acrylic & High-Clarity SAN',
    capacity: '3.5 ml / 0.12 fl. oz.',
    moq: '500 pcs',
    leadTime: '7-day sample / 15-day bulk',
    finishes: ['High-Gloss Clear', 'Soft-Touch Matte Frosted', 'Custom Gradient Spray', 'Hot-Stamping Foil'],
    image: '/lip-series/lip-glaze-hero-1.jpg',
    description: 'Engineered specifically for viscous lip oils and high-pigment lip muds. Anti-leak double-threaded silicone wiper with ultra-plush flocked doe-foot applicator.'
  },
  {
    name: 'Atelier Frosted Lip Mud & Butter Jar Component',
    category: 'Jars & Pots',
    material: 'Double-Wall Heavy Acrylic with Aluminum Cap Insert',
    capacity: '8.0 g / 0.28 oz.',
    moq: '500 pcs',
    leadTime: '7-day sample / 15-day bulk',
    finishes: ['Velvet Frosted Base', 'Metallic Electroplated Cap', 'Silk-Screened Typography'],
    image: '/lip-series/lip-glaze-hero-2.jpg',
    description: 'Luxury heavyweight pot engineered for airy whipped lip muds and deep-conditioning overnight lip treatment butters. Includes internal airtight seal.'
  },
  {
    name: 'Magnetic Architect Bullet Lipstick Shell',
    category: 'Bullet Cases',
    material: 'Anodized Aluminum Body + Weighted Zinc Alloy Base (Zamac)',
    capacity: 'Standard 12.1 mm / 12.7 mm Cup',
    moq: '500 pcs',
    leadTime: '7-day sample / 18-day bulk',
    finishes: ['Brushed Champagne Gold', 'Gunmetal Mirror', 'Piano Lacquer Noir'],
    image: '/lip-series/lip-glaze-hero-3.jpg',
    description: 'Satisfying 350g magnetic snap tactile closure. Smooth mechanical swivel with zero rattle and airtight oxidation protection for clean formulations.'
  },
  {
    name: 'Precision Dual-End Click Lip Liner & Blending Wand',
    category: 'Liners & Applicators',
    material: 'Recyclable Aluminum Barrel with Silicone Grip Collar',
    capacity: '0.3 g retractable micro-tip',
    moq: '500 pcs',
    leadTime: '7-day sample / 14-day bulk',
    finishes: ['Matte Anodized Body', 'Tonal Color Match', 'UV Gloss Brand Logo'],
    image: '/lip-series/lip-glaze-hero-4.jpg',
    description: 'Ultra-slim 1.5mm micro-lead dispensing for razor-sharp lip contouring, paired with an integrated ergonomic silicone smudger wand.'
  },
  {
    name: 'Airless Vacuum Treatment & Lip Peptide Pump',
    category: 'Airless Dispensers',
    material: 'Pure Polypropylene (100% Monomaterial Recyclable)',
    capacity: '5.0 ml & 10.0 ml',
    moq: '500 pcs',
    leadTime: '7-day sample / 15-day bulk',
    finishes: ['Ceramic Soft Touch', 'Clear Airless Window', 'Metallic Gold Collar'],
    image: '/lip-series/lip-glaze-hero-5.jpg',
    description: 'Piston-driven vacuum dispensing mechanism completely isolates peptide, active vitamin C, and hyaluronic lip serums from ambient air oxidation.'
  },
  {
    name: 'Sculpted Ceramic Tip Lip Glaze Applicator',
    category: 'Novelty & Specialty',
    material: 'Medical-Grade Cooling Ceramic Head + PETG Body',
    capacity: '4.0 ml',
    moq: '500 pcs',
    leadTime: '7-day sample / 18-day bulk',
    finishes: ['Porcelain Glaze Tip', 'Frosted Gradient Barrel'],
    image: '/lip-series/lip-glaze-hero-6.jpg',
    description: 'Cold-touch ceramic contour applicator tip glides effortlessly across lip curves, de-puffing and distributing glossy nourishing oils evenly.'
  }
];

const shadeCards = [
  { title: 'Velvet Lip Mud Master Pantone Shade Palette', file: '/packaging/shade-card-1.jpg', count: '39 Standard Formulation Benchmarks' },
  { title: 'High-Luster Glass Lip Oil Core Pigment & Shimmer Range', file: '/packaging/shade-card-4.jpg', count: 'Custom Shimmer & Tint Tiers' },
  { title: 'Nude, Mauve & Deep Berry Contour Line Index', file: '/packaging/shade-card-5.jpg', count: 'Full Undertone Coverage (Warm/Cool/Neutral)' }
];
---

<BaseLayout
  title="Componentry & Packaging Asset Library | 500 pcs Universal MOQ — MLM Lip"
  description="Browse our prestige library of lip cosmetic packaging components: heavyweight acrylic lip oil vials, magnetic aluminum lipstick cases, and precision airless dispensers. Available from 500 pcs with 7-day lab sampling."
>
  <!-- Hero Section -->
  <section class="hero-pack" style="background:#0f172a; color:#fff; padding: 70px 0 50px 0; border-bottom: 1px solid #1e293b;">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Packaging Library' }]} />
      <p style="color:#38bdf8; font-size:12px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; margin-bottom:12px;">PRESTIGE B2B COMPONENTRY & TOOLING ATELIER</p>
      <h1 style="color:#fff; font-size:38px; line-height:1.2; font-weight:800; max-width:850px; margin-bottom:18px;">
        Architectural Lip Packaging. <br/><span style="color:#94a3b8; font-weight:400;">Ready for Your Identity from 500 Pieces.</span>
      </h1>
      <p style="color:#cbd5e1; font-size:16px; line-height:1.6; max-width:720px; margin-bottom:28px;">
        Your componentry is your brand's primary tactile equity. Eliminate generic off-the-shelf looks without committing to $50,000 mold investments. Explore our curated library of cleanroom-compatible vials, magnetic casings, and bespoke applicators — engineered in Shenzhen for global retail prestige.
      </p>
      <div style="display:flex; gap:16px; flex-wrap:wrap;">
        <a href="/quote" class="btn primary" style="background:#2563eb; color:#fff; padding:12px 24px; border-radius:6px; font-weight:600; text-decoration:none;">Request Component Sample Kit &rarr;</a>
        <a href="/about#compliance" class="btn" style="border:1px solid #475569; color:#f8fafc; padding:12px 24px; border-radius:6px; font-weight:600; text-decoration:none;">Inspect Lab Compliance Dossiers</a>
      </div>
      <div style="display:flex; gap:28px; margin-top:36px; padding-top:24px; border-top:1px solid #1e293b; font-size:13px; color:#94a3b8; flex-wrap:wrap;">
        <span>✓ <strong>500 pcs Universal MOQ</strong> across all components</span>
        <span>✓ <strong>7-Day Custom Sample Dispatch</strong> (Logo + Finish)</span>
        <span>✓ <strong>100% Sampling Fee Credited</strong> to bulk invoice</span>
        <span>✓ <strong>ISO 22716 & GMPC</strong> cleanroom filling compatibility</span>
      </div>
    </div>
  </section>

  <!-- Component Grid -->
  <section style="padding:60px 0; background:#f8fafc;">
    <div class="wrap">
      <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:32px;">
        <div>
          <p class="eyebrow">PHYSICAL ASSETS</p>
          <h2 style="font-size:28px; margin:0;">Standard Production Lip Components</h2>
        </div>
        <p style="color:#64748b; font-size:14px; margin:0;">Showing 6 flagship formats with verified tooling specs</p>
      </div>

      <div class="grid two" style="gap:30px;">
        {packagingItems.map(item => (
          <div class="card" style="background:#fff; border-radius:12px; overflow:hidden; border:1px solid #e2e8f0; display:flex; flex-direction:column; box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="height:260px; overflow:hidden; background:#f1f5f9; position:relative;">
              <img src={item.image} alt={item.name} style="width:100%; height:100%; object-fit:cover; transition:transform 0.3s ease;" />
              <span style="position:absolute; top:12px; left:12px; background:rgba(15,23,42,0.85); color:#fff; font-size:11px; font-weight:700; padding:4px 10px; border-radius:4px; text-transform:uppercase; letter-spacing:0.05em;">{item.category}</span>
              <span style="position:absolute; top:12px; right:12px; background:#2563eb; color:#fff; font-size:11px; font-weight:700; padding:4px 10px; border-radius:4px;">MOQ: {item.moq}</span>
            </div>
            <div style="padding:24px; flex:1; display:flex; flex-direction:column;">
              <h3 style="font-size:18px; margin-top:0; margin-bottom:8px; color:#0f172a;">{item.name}</h3>
              <p style="font-size:13px; color:#64748b; line-height:1.5; margin-bottom:18px;">{item.description}</p>
              
              <div style="background:#f8fafc; border-radius:8px; padding:12px; margin-bottom:18px; font-size:12px; display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                <div><strong>Primary Material:</strong> <br/><span style="color:#475569;">{item.material}</span></div>
                <div><strong>Nominal Fill:</strong> <br/><span style="color:#475569;">{item.capacity}</span></div>
                <div><strong>Sampling Dispatch:</strong> <br/><span style="color:#475569;">{item.leadTime}</span></div>
                <div><strong>Tooling Status:</strong> <br/><span style="color:#16a34a; font-weight:600;">Active / In Stock</span></div>
              </div>

              <div style="margin-bottom:20px;">
                <p style="font-size:11px; font-weight:700; color:#94a3b8; text-transform:uppercase; margin-bottom:6px;">Available Surface Finishes:</p>
                <div style="display:flex; gap:6px; flex-wrap:wrap;">
                  {item.finishes.map(f => (
                    <span style="background:#e2e8f0; color:#334155; font-size:11px; padding:3px 8px; border-radius:4px;">{f}</span>
                  ))}
                </div>
              </div>

              <div style="margin-top:auto; padding-top:16px; border-top:1px solid #f1f5f9; display:flex; justify-content:space-between; align-items:center;">
                <a href="/quote" style="color:#2563eb; font-weight:600; font-size:13px; text-decoration:none;">Configure with your formula &rarr;</a>
                <a href="/samples" style="background:#0f172a; color:#fff; font-size:12px; font-weight:600; padding:8px 14px; border-radius:4px; text-decoration:none;">Order Blank Sample</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Shade Palette and Color Matching section -->
  <section style="padding:60px 0; background:#fff; border-top:1px solid #e2e8f0;">
    <div class="wrap">
      <p class="eyebrow">COLOR MATCHING LAB</p>
      <h2 style="font-size:28px; margin-bottom:12px;">39-Shade High-Intensity Color Library & Pigment Standards</h2>
      <p style="color:#64748b; font-size:15px; max-width:760px; margin-bottom:36px;">
        Choose from our validated Pantone benchmarks or send us a physical benchmark swipe (or luxury competitor reference). Our lab color-matches to Delta-E &lt; 0.8 accuracy within 7 business days under D65 daylight viewing booths.
      </p>

      <div class="grid three" style="gap:24px;">
        {shadeCards.map(sc => (
          <div style="border:1px solid #e2e8f0; border-radius:10px; overflow:hidden; background:#f8fafc;">
            <div style="height:220px; overflow:hidden;">
              <img src={sc.file} alt={sc.title} style="width:100%; height:100%; object-fit:cover;" />
            </div>
            <div style="padding:16px;">
              <h4 style="font-size:15px; margin:0 0 6px 0; color:#0f172a;">{sc.title}</h4>
              <p style="font-size:12px; color:#64748b; margin:0;">{sc.count}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Custom Tooling / Mold Development Callout -->
  <section class="tint" style="padding:60px 0; background:#0f172a; color:#fff;">
    <div class="wrap" style="display:flex; justify-content:space-between; align-items:center; gap:40px; flex-wrap:wrap;">
      <div style="max-width:600px;">
        <p style="color:#38bdf8; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:8px;">BESPOKE INDUSTRIAL DESIGN</p>
        <h2 style="color:#fff; font-size:30px; margin-top:0; margin-bottom:14px;">Need a Proprietary Silhouette? We Build Custom Molds.</h2>
        <p style="color:#94a3b8; font-size:14px; line-height:1.6; margin:0;">
          From initial 3D CAD modeling and SLA resin rapid-prototyping (48 hours) to hardened steel multi-cavity injection molds. Retain 100% intellectual property and silhouette exclusivity with Beautychain Limited tooling contracts.
        </p>
      </div>
      <div>
        <a href="/quote" class="btn" style="background:#2563eb; color:#fff; padding:14px 28px; border-radius:6px; font-weight:700; text-decoration:none; display:inline-block;">Discuss Custom Tooling Brief &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>
