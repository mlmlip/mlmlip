---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { site } from "../data/site";
import { productsCatalog } from "../data/products";
import { categories } from "../data/categories";

const PAGE_SIZE = 20;
const allProducts = [...productsCatalog].reverse(); // newest first
const totalPages = Math.ceil(allProducts.length / PAGE_SIZE);
const currentPage = 1;
const pageProducts = allProducts.slice(0, PAGE_SIZE);

const compare = [
  { format: "Lip Gloss", finish: "High-shine, sheer, jelly, shimmer", pack: "Acrylic tube + doe-foot", best: "DTC, TikTok, viral launches", href: "/lip-gloss-manufacturer" },
  { format: "Lip Mud", finish: "Soft-focus matte, velvet", pack: "Tube, jar, cushion compact", best: "K-beauty, matte lovers", href: "/lip-mud-manufacturer" },
  { format: "Lip Liner", finish: "Matte, waterproof, precise", pack: "Wood barrel, twist-up", best: "Contour, shade pairing", href: "/lip-liner-manufacturer" },
  { format: "Lipstick", finish: "Matte, satin, cream, shine", pack: "Zamac, aluminum, custom case", best: "Prestige, retail counter", href: "/lipstick-manufacturer" },
  { format: "Lip Oil", finish: "Glass-shine, treatment", pack: "Tube, ceramic-tip, roller", best: "Skinified, treatment-led", href: "/lip-oil-manufacturer" },
  { format: "Lip Mask", finish: "Balm, overnight repair", pack: "Jar, squeeze tube", best: "Night care, barrier repair", href: "/lip-mask-manufacturer" }
];
---

<BaseLayout
  title="OEM Lip Products | 60+ Formulas, 6 Categories, 500 pcs"
  description="Browse 60+ private label lip formulas: gloss, lip mud, lip oil, lipstick, liner & mask. 500 pcs MOQ, 7-day sampling. Configure your line today."
>
  <section style="background: linear-gradient(180deg, var(--cream) 0%, var(--blush-soft) 100%); padding-top: 48px; padding-bottom: 56px;">
    <div class="wrap">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Products" }]} />
      <p class="eyebrow" style="color: var(--gold);">Product Catalogue</p>
      <h1 style="font-size: clamp(32px, 4vw, 50px); max-width: 840px; margin-bottom: 16px;">
        Custom Lip Formulations & Finished Products
      </h1>
      <p class="lead" style="max-width: 680px; font-size: 18px; margin-bottom: 24px;">
        Showing the latest {PAGE_SIZE} of {allProducts.length} private label formulations.
        Every SKU supports full shade-matching, custom scent/flavoring, and bespoke component tooling from {site.moq} per SKU.
      </p>

      <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px;">
        {categories.map((c) => (
          <a
            href={`/${c.slug}`}
            style="display: inline-block; padding: 8px 16px; background: white; border: 1px solid var(--line); border-radius: 20px; font-size: 13px; font-weight: 600; color: var(--plum); text-decoration: none; transition: all 0.2s;"
          >
            {c.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Grid: Latest 20 -->
  <section style="padding: 48px 0;">
    <div class="wrap">
      <div class="grid three" style="gap: 24px;">
        {pageProducts.map((p) => (
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; border-radius: 10px; overflow: hidden; padding: 20px; transition: transform 0.2s, box-shadow 0.2s;">
            <div>
              <div class="case-media" style="margin-bottom: 16px; border-radius: 6px; overflow: hidden; background: white;">
                <img
                  src={p.heroImage}
                  alt={p.name}
                  width="600"
                  height="450"
                  style="width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block;"
                  loading="lazy"
                />
              </div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-size: 11px; font-weight: 700; color: var(--gold); text-transform: uppercase;">
                  {p.tag}
                </span>
                <span style="font-size: 11px; color: var(--ink-soft); font-family: monospace;">
                  {p.moq} MOQ
                </span>
              </div>
              <h3 style="font-size: 18px; margin: 0 0 10px; line-height: 1.3;">
                <a href={"/products/" + p.slug} style="color: var(--plum); text-decoration: none;">
                  {p.name}
                </a>
              </h3>
              <p style="font-size: 13px; color: var(--ink-soft); line-height: 1.5; margin-bottom: 16px;">
                {p.headline}
              </p>
            </div>
            <div style="border-top: 1px solid var(--line); padding-top: 14px; margin-top: 12px; display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 12px; color: var(--ink-soft);">
                {p.shadeCount} shades available
              </span>
              <a href={"/products/" + p.slug} style="font-size: 13px; font-weight: 600; color: var(--burgundy); text-decoration: none;">
                Details & Specs \u2192
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Pagination -->
      <nav style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--line);">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
          <a
            href={n === 1 ? "/products" : `/products/page/${n}`}
            style={`padding: 10px 14px; border-radius: 6px; font-size: 14px; font-weight: 600; text-decoration: none; ${
              n === currentPage
                ? "background: var(--plum); color: #fff; border: 1px solid var(--plum);"
                : "background: white; color: var(--plum); border: 1px solid var(--line);"
            }`}
          >
            {n}
          </a>
        ))}
        {totalPages > 1 && (
          <a
            href="/products/page/2"
            style="padding: 10px 18px; background: var(--blush); border: 1px solid var(--line); border-radius: 6px; font-size: 14px; font-weight: 600; color: var(--plum); text-decoration: none;"
          >
            Next \u2192
          </a>
        )}
      </nav>
    </div>
  </section>

  <!-- Side by side comparison table -->
  <section>
    <div class="wrap">
      <p class="eyebrow">Side by side</p>
      <h2>Compare the six lip formats</h2>
      <p class="lead" style="max-width:600px;">
        Same MOQ, same 7-day sampling, same compliance \u2014 the difference is texture, packaging and who it wins.
      </p>
      <div class="card gold-line table-responsive" style="margin-top:28px; padding:0;">
        <table style="width:100%; border-collapse:collapse; font-size:14px; min-width:680px;">
          <thead>
            <tr style="background:var(--blush);">
              <th style="padding:14px 18px; text-align:left; color:var(--plum); font-family:'Playfair Display',serif; font-weight:600;">Format</th>
              <th style="padding:14px 18px; text-align:left; color:var(--ink-soft);">Finish</th>
              <th style="padding:14px 18px; text-align:left; color:var(--ink-soft);">Packaging</th>
              <th style="padding:14px 18px; text-align:left; color:var(--ink-soft);">Best for</th>
              <th style="padding:14px 18px; text-align:left; color:var(--plum); font-weight:600;">MOQ</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((c) => (
              <tr style="border-bottom:1px solid var(--line);">
                <td style="padding:14px 18px;"><a href={c.href} style="color:var(--burgundy); font-weight:600;">{c.format}</a></td>
                <td style="padding:14px 18px; color:var(--ink-soft);">{c.finish}</td>
                <td style="padding:14px 18px; color:var(--ink-soft);">{c.pack}</td>
                <td style="padding:14px 18px; color:var(--ink-soft);">{c.best}</td>
                <td style="padding:14px 18px; color:var(--plum); font-weight:600;">500 pcs</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note" style="margin-top:14px;">
        All six share the same {site.moq} minimum, 7-day sampling, and GMPC + ISO + CPNP compliance \u2014 the format you pick is about your brand story, not a manufacturing constraint.
      </p>
    </div>
  </section>

  <section style="background:var(--blush-soft)">
    <div class="wrap">
      <h2>Not sure which format fits your idea?</h2>
      <p class="lead" style="max-width:600px">
        Tell us the market, price point and how you want the product to feel. We will recommend the format,
        packaging and shade direction that gets there fastest.
      </p>
      <a class="btn" href="/quote">Build your brief</a>
    </div>
  </section>
</BaseLayout>
