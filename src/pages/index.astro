---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, pillars, products, steps, certifications } from '../data/site';
import { cases } from '../data/cases';
import { getCollection } from 'astro:content';

const categoryLinks = [
  { label: 'Lip Gloss Manufacturer', href: '/lip-gloss-manufacturer', blurb: 'Clear, tinted, shimmer and plumping gloss with custom tube and applicator.' },
  { label: 'Lip Mud & Velvet Tint', href: '/lip-mud-manufacturer', blurb: 'Soft-focus matte formulas with transfer-resistant, buildable colour.' },
  { label: 'Lip Liner Manufacturer', href: '/lip-liner-manufacturer', blurb: 'Cedarwood or twist-up liners shade-matched to your colour range.' },
  { label: 'Lipstick Manufacturer', href: '/lipstick-manufacturer', blurb: 'Matte, satin and shine bullets with custom case tooling.' },
  { label: 'Lip Oil Manufacturer', href: '/lip-oil-manufacturer', blurb: 'Peptide and botanical oil treatments with glass-like shine.' },
  { label: 'Lip Mask Manufacturer', href: '/lip-mask-manufacturer', blurb: 'Overnight repair masks and barrier balms in jars or tubes.' }
];

const faqPreview = [
  { q: 'What is your minimum order quantity?', a: '500 pcs per SKU — identical across all six lip categories, and SKUs can be combined in one project.' },
  { q: 'How fast are samples ready?', a: 'Custom samples in 7 days, and 100% of the sampling fee is credited back to your production order.' },
  { q: 'Can you open a custom mold?', a: 'Yes. Beyond our in-house packaging library, we tool bespoke molds for an exclusive silhouette.' },
  { q: 'Which certifications do you provide?', a: 'GMPC and ISO 22716 production, with EU CPNP notification support and FDA-ready documentation.' }
];

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
const featuredCases = cases.slice(0, 3);
---

<BaseLayout
  title="Private Label Lip Cosmetics Manufacturer | 500 pcs Universal MOQ — MLM Lip"
  description="Tier-1 custom lip cosmetics manufacturing for emerging and high-growth beauty brands in North America & Europe. 500 pcs MOQ across Peptide Lip Oils, Lip Muds, Glosses, and Lipsticks. 7-day rapid prototyping."
>
  <section style="position: relative; background: var(--plum-dark); overflow: hidden;">
    <img src="/factory/production-line-01.jpg" alt="MLM Lip automated production line" loading="eager" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.32;" />
    <div style="position: absolute; inset: 0; background: linear-gradient(120deg, rgba(47,12,23,0.92) 0%, rgba(74,21,37,0.78) 60%, rgba(110,26,50,0.55) 100%);"></div>
    <div class="wrap" style="position: relative; padding-top: 104px; padding-bottom: 104px;">
      <p class="eyebrow" style="letter-spacing: 0.2em; font-weight: 600; color: var(--gold);">Custom Lip Cosmetics · OEM &amp; ODM Specialist</p>
      <h1 style="font-size: clamp(38px, 5vw, 60px); line-height: 1.1; max-width: 900px; margin-bottom: 24px; color: #fff;">
        Engineering Your Next Viral Lip Line.<br />
        <span style="color: var(--gold); font-style: italic;">From 500 Pieces, End-to-End.</span>
      </h1>
      <p class="lead" style="max-width: 720px; font-size: 19px; line-height: 1.6; margin-bottom: 36px; color: #f3dde3;">
        We manufacture benchmark-grade lip cosmetics for indie beauty founders, TikTok Shop creators, and multi-channel retailers across North America and Europe. Bespoke formulation, componentry library, and custom tooling — executed under GMPC &amp; ISO cleanroom standards.
      </p>
      <div>
        <a class="btn" href="/quote" style="padding: 16px 36px; font-size: 16px; font-weight: 600;">Build your brief</a>
        <a class="btn ghost" href="/cases" style="margin-left: 14px; padding: 16px 32px; font-size: 16px; color: var(--gold-light); border-color: var(--gold);">View factory &amp; cases</a>
      </div>
      <p class="note" style="margin-top: 24px; font-size: 14px; color: var(--gold-light);">
        ✓ 500 pcs universal MOQ &nbsp;·&nbsp; ✓ 7-day formulation sampling &nbsp;·&nbsp; ✓ 100% sample fee credited to bulk order
      </p>
    </div>
  </section>

  <section style="padding: 0;">
    <div class="wrap">
      <div class="card" style="margin-top: -32px; position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: 18px 34px; justify-content: center; padding: 20px 28px; box-shadow: var(--shadow-md);">
        {['GMPC certified', 'ISO 22716', 'EU CPNP support', 'FDA-ready documentation', '500 pcs MOQ', '7-day sampling'].map((t) => (
          <span style="font-size: 14px; color: var(--plum); font-weight: 600; letter-spacing: 0.02em;">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="grid four" style="margin-top: 28px;">
        <div style="text-align: center;">
          <p style="font-family: 'Playfair Display', serif; font-size: 44px; color: var(--burgundy); margin: 0; line-height: 1;">6</p>
          <p class="note" style="margin: 8px 0 0;">lip product categories</p>
        </div>
        <div style="text-align: center;">
          <p style="font-family: 'Playfair Display', serif; font-size: 44px; color: var(--burgundy); margin: 0; line-height: 1;">500</p>
          <p class="note" style="margin: 8px 0 0;">pcs universal MOQ</p>
        </div>
        <div style="text-align: center;">
          <p style="font-family: 'Playfair Display', serif; font-size: 44px; color: var(--burgundy); margin: 0; line-height: 1;">7</p>
          <p class="note" style="margin: 8px 0 0;">days to custom samples</p>
        </div>
        <div style="text-align: center;">
          <p style="font-family: 'Playfair Display', serif; font-size: 44px; color: var(--burgundy); margin: 0; line-height: 1;">100%</p>
          <p class="note" style="margin: 8px 0 0;">sample fee credited to order</p>
        </div>
      </div>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">Why founders choose us</p>
      <h2>Built for agile brands, not old-model gatekeepers</h2>
      <p class="lead" style="max-width: 660px;">
        Tier-1 contract manufacturers demand 10,000-unit commitments and eight-week R&amp;D backlogs. We started from the opposite end.
      </p>
      <div class="card gold-line" style="margin-top: 28px; padding: 0; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; font-size: 15px;">
          <thead>
            <tr style="background: var(--blush);">
              <th style="padding: 16px 24px; text-align: left; color: var(--plum); font-family: 'Playfair Display', serif; font-weight: 600;">Metric</th>
              <th style="padding: 16px 24px; text-align: left; color: var(--ink-soft);">Traditional tier-1 OEM</th>
              <th style="padding: 16px 24px; text-align: left; color: var(--burgundy); font-family: 'Playfair Display', serif; font-weight: 600;">MLM Lip</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['MOQ per SKU', '5,000 – 10,000 pcs', '500 pcs (all categories)'],
              ['Sampling lead time', '4 – 8 weeks', '7 days'],
              ['Sampling fee', 'Non-refundable', '100% credited to order'],
              ['Shades affordable at launch', '1', '3 – 4'],
              ['Packaging route', 'Off-shelf catalogue', 'Library + custom tooling'],
              ['Compliance documentation', 'Self-managed', 'GMPC + ISO + CPNP support']
            ].map((row) => (
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 14px 24px; color: var(--plum); font-weight: 600;">{row[0]}</td>
                <td style="padding: 14px 24px; color: var(--ink-soft);">{row[1]}</td>
                <td style="padding: 14px 24px; color: var(--burgundy); font-weight: 600;">{row[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="margin-top: 28px;"><a class="btn" href="/quote">Start your brief</a></p>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">Enterprise Manufacturing Pillars</p>
      <h2>Backed by industrial rigor</h2>
      <div class="grid three" style="margin-top: 36px;">
        {pillars.map((p) => (
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <p class="eyebrow" style="margin-bottom: 8px; color: var(--burgundy); font-size: 11px;">{p.subtitle}</p>
              <h3 style="font-size: 22px; line-height: 1.3; margin-bottom: 14px;">{p.title}</h3>
              <p style="font-size: 15px; line-height: 1.65; color: var(--ink-soft);">{p.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">What we produce</p>
      <h2>Lip first. Everything else second.</h2>
      <p class="lead" style="max-width:640px">
        Six lip categories are what we do best — gloss, mud, liner, lipstick, oil and mask.
        Body oils and other cosmetics are available as companion lines to round out your range.
      </p>
      <div class="grid three" style="margin-top:28px">
        {products.slice(0, 6).map((p) => (
          <div class="card">
            {p.image ? (
              <div class="case-media" style="margin-bottom:16px"><img src={p.image} alt={p.name} loading="lazy" /></div>
            ) : (
              <div class="media-slot" style="margin-bottom:16px">Product photography in preparation</div>
            )}
            <h3>{p.name}</h3>
            <p>{p.body}</p>
            <p class="note" style="margin:0 0 12px">{p.detail}</p>
            {p.categoryHref && <p style="margin:0"><a href={p.categoryHref}>Explore the {p.name.split(' ')[0]} program →</a></p>}
          </div>
        ))}
      </div>
      <p style="margin-top:24px"><a href="/products">View the full product range →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Custom manufacturing by category</p>
      <h2>Private label solutions for every lip format</h2>
      <p class="lead" style="max-width: 660px;">
        Each category has its own manufacturing page — capabilities, specification and answers to the questions brands ask most.
      </p>
      <div class="grid three" style="margin-top: 28px;">
        {categoryLinks.map((c) => (
          <a class="card" href={c.href} style="display: block; color: inherit;">
            <h3 style="font-size: 19px; margin-bottom: 8px;">{c.label}</h3>
            <p style="margin: 0; font-size: 15px;">{c.blurb}</p>
            <p style="margin: 12px 0 0; color: var(--rose-dark); font-size: 14px;">Explore →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2>From brief to your door</h2>
      <div class="grid two" style="margin-top:28px">
        {steps.map((s) => (
          <div class="card">
            <p class="eyebrow" style="margin-bottom:6px">Step {s.n}</p>
            <h3>{s.title}</h3>
            <p style="margin:0">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Certified production</p>
      <h2>Documentation your market asks for</h2>
      <div class="grid three" style="margin-top:28px">
        {certifications.map((c) => (
          <div class="card gold-line">
            <h3>{c.name}</h3>
            <p style="margin:0">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">Real projects</p>
      <h2>Made for brands like yours</h2>
      <div class="grid three" style="margin-top:28px">
        {featuredCases.map((c) => (
          <div class="card">
            {c.image ? (
              <div class="case-media"><img src={c.image} alt={c.title} loading="lazy" /></div>
            ) : (
              <div class="media-slot" style="margin-bottom:16px">Case media — assets coming</div>
            )}
            <p class="eyebrow" style="margin-bottom:6px">{c.category}</p>
            <h3 style="margin-bottom:8px">{c.title}</h3>
            <p style="margin:0">{c.summary}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:24px"><a href="/cases">See all cases &amp; factory videos →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">From the blog</p>
      <h2>Build your lip brand smarter</h2>
      <div class="grid two" style="margin-top:28px">
        {latestPosts.map((post) => (
          <a class="card" href={`/blog/${post.id}`} style="display:block; color:inherit">
            <h3 style="margin-bottom:8px">{post.data.title}</h3>
            <p style="margin:0">{post.data.description}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:24px"><a href="/blog">Read all articles →</a></p>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">Sampling program</p>
      <h2>Test the product before you order stock</h2>
      <p class="lead" style="max-width: 680px;">
        Physical samples developed against your brief, ready in 7 days — and the full sampling fee is credited back
        when you place your 500 pcs production order. Sampling effectively costs nothing.
      </p>
      <p style="margin-top: 28px;">
        <a class="btn" href="/samples">Order samples</a>
        <a class="btn ghost" href="/process" style="margin-left: 12px;">See how we work</a>
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Common questions</p>
      <h2>Before you send your brief</h2>
      <div class="grid two" style="margin-top: 28px;">
        {faqPreview.map((f) => (
          <div class="card">
            <h3 style="font-size: 18px;">{f.q}</h3>
            <p style="margin: 0;">{f.a}</p>
          </div>
        ))}
      </div>
      <p style="margin-top: 24px;"><a href="/faq">Read all frequently asked questions →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="card" style="text-align:center; padding:48px 28px">
        <h2 style="margin-bottom:10px">Tell us what you want to launch</h2>
        <p class="lead" style="max-width:560px; margin:0 auto 24px">
          Send your product idea, target quantity and market. We will come back with the most practical way to make it yours.
        </p>
        <a class="btn" href="/contact">Start your lip line</a>
      </div>
    </div>
  </section>
</BaseLayout>
