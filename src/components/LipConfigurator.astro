  }

  .pill-option input:checked + span {
    background: var(--burgundy, #6e1a32);
    color: #ffffff;
    border-color: var(--burgundy, #6e1a32);
  }

  .checkbox-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }

  .check-pill {
    cursor: pointer;
  }

  .check-pill span {
    display: block;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid var(--line, #e8d7dc);
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-soft, #4a3e42);
    background: #fff;
    transition: all 0.2s;
  }

  .check-pill input:checked + span {
    background: #fdf2f4;
    border-color: var(--rose, #9c2e4e);
