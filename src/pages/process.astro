---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';

const phases = [
  {
    n: '01',
    title: 'Inquiry & Product Brief',
    body: 'Tell us what you want to launch: product format (Oil, Mud, Gloss, Liner, Lipstick, Mask), target quantity, market regulations (FDA/CPNP), and pricing tier.',
    you: 'You provide: product mood board, target quantity, benchmark references if available.',
    image: '/factory/sampling-packaging-01.jpg',
    tag: 'Lab Intake'
  },
  {
    n: '02',
    title: 'Engineering Proposal & Quotation',
    body: 'We map the practical route — recommended componentry from our packaging library or bespoke tooling, clean formulation direction, and transparent tiered pricing.',
    you: 'You receive: formal commercial quote with componentry specs and milestone schedule.',
    image: '/packaging/lip-component-dimensions-spec.jpg',
    tag: 'Technical Spec'
  },
  {
    n: '03',
    title: '7-Day Rapid Atelier Sampling',
    body: 'Our formulation chemists match shade (Delta-E < 0.8), viscosity, and finish against your brief. Custom lab prototypes dispatched to your desk in 7 business days.',
    you: 'You confirm: testing shade and sensory glide on lips in natural lighting.',
    image: '/packaging/shade-card-1.jpg',
    tag: 'Colorimetry'
  },
  {
    n: '04',
    title: 'Sensory Revisions & Packaging Alignment',
    body: 'Consolidated formulation feedback rounds. We refine texture, scent, payoff, and verify wiper-to-stem fitment until the formulation is perfected.',
    you: 'You provide: consolidated revision feedback to lock final pilot batch.',
    image: '/packaging/shade-card-4.jpg',
    tag: 'Sensory Lab'
  },
  {
    n: '05',
    title: 'Order Lock & 100% Sample Fee Credit',
    body: 'Approve the pilot sample to confirm production from 500 pcs per SKU. 100% of initial sampling and prototype costs are directly credited back to your mass production invoice.',
    you: 'You confirm: final vector artwork, Pantone codes, and purchase order.',
    image: '/factory/packaging-tubes-01.jpg',
    tag: 'Production Lock'
  },
  {
    n: '06',
    title: 'GMPC Cleanroom Mass Production',
    body: 'Bulk compounding and high-speed rotary vacuum filling under ISO 22716 cleanroom controls. Zero cross-vendor mismatch because formulation and filling live under one roof.',
    you: 'You receive: milestone updates and batch compounding traceability logs.',
    image: '/factory/cleanroom-01.jpg',
    tag: 'Cleanroom ISO 22716'
  },
  {
    n: '07',
    title: 'Microbial & Quantitative QC Release',
    body: 'Every batch undergoes USP 51/62 microbial testing, heavy-metal ICP-OES screening, drop tests, and thermal stability audits before release.',
    you: 'You receive: official Certificate of Analysis (COA) and pre-shipment photos.',
    image: '/factory/production-line-01.jpg',
    tag: 'Lab QC Gate'
  },
  {
    n: '08',
    title: 'Global Dispatch & CPNP/FDA Dossiers',
    body: 'Door-to-door sea/air logistics to your US/EU warehouse, accompanied by complete EU CPNP notification files, PIF dossiers, and FDA-compliant paperwork.',
    you: 'You receive: international tracking, regulatory dossiers, and priority replenishment.',
    image: '/factory/packaging-tubes-02.jpg',
    tag: 'Global Delivery'
  }
];
---

<BaseLayout
  title="Our Process | 8-Step Precision Lip Manufacturing — MLM Lip"
  description="8-step B2B lip manufacturing process: 7-day lab samples, ISO 22716 cleanroom production, 15-25 day bulk lead times & full FDA/CPNP compliance dossiers."
>
  <section style="background:var(--plum-dark); color:#fff; padding:70px 0 50px 0; border-bottom:1px solid rgba(255,255,255,0.12);">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Process' }]} />
      <p style="color:var(--gold); font-size:12px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; margin-bottom:12px;">TRANSPARENT INDUSTRIAL TIMELINE</p>
      <h1 style="color:#fff; font-size:38px; line-height:1.2; font-weight:800; max-width:800px; margin-bottom:18px;">
        From Creative Brief to Your Door. <br/><span style="color:#d6b3be; font-weight:400;">In 8 Documented Milestones.</span>
      </h1>
      <p style="color:#f3dde3; font-size:16px; line-height:1.6; max-width:720px; margin:0;">
        No opaque supply chains. You always know what happens next, what our formulation lab requires from you, and exactly what documentation accompanies your shipment into North America or Europe.
      </p>
    </div>
  </section>

  <section style="padding:60px 0; background:var(--blush-soft);">
    <div class="wrap">
      <div style="display:flex; flex-direction:column; gap:36px;">
        {phases.map((p) => (
          <div class="card" style="background:#fff; border-radius:12px; border:1px solid var(--line); overflow:hidden; display:grid; grid-template-columns: 280px 1fr; gap:0; box-shadow:0 4px 6px -1px rgba(0,0,0,0.04);">
            <div style="height:100%; min-height:220px; position:relative; background:var(--blush); overflow:hidden;">
              <img src={p.image} alt={p.title} style="width:100%; height:100%; object-fit:cover;" />
              <span style="position:absolute; top:12px; left:12px; background:rgba(47,12,23,0.88); color:#fff; font-size:11px; font-weight:700; padding:4px 10px; border-radius:4px;">{p.tag}</span>
            </div>
            <div style="padding:28px; display:flex; flex-direction:column; justify-content:center;">
              <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px;">
                <span style="display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; border-radius:50%; background:var(--burgundy); color:#fff; font-weight:800; font-size:14px;">{p.n}</span>
                <h3 style="font-size:20px; margin:0; color:var(--plum-dark);">{p.title}</h3>
              </div>
              <p style="font-size:14px; color:var(--ink-soft); line-height:1.6; margin:0 0 14px 0;">{p.body}</p>
              <div style="background:var(--cream); border-left:3px solid var(--rose); padding:10px 14px; border-radius:0 6px 6px 0;">
                <p style="font-size:12px; color:var(--ink-soft); margin:0; line-height:1.5;"><strong>Client Handoff:</strong> {p.you}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div style="text-align:center; margin-top:50px;">
        <a class="btn primary" href="/quote" style="background:var(--burgundy); color:#fff; padding:16px 36px; border-radius:6px; font-weight:700; font-size:15px; text-decoration:none;">Start Step 01 — Build Your Brief &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>
