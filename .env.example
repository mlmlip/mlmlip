# mlmlip.com — 询盘后端环境变量清单（示例文件，全部为占位符，禁止填真实值）
# 部署位置：Vercel → Project Settings → Environment Variables（Production / Preview 均需配）
# 本地开发：复制本文件为 .env.local 后填写（.env.local 已被 .gitignore 忽略，不会被提交）

# ---------------------------------------------------------------------------
# 飞书自定义机器人（必配其一；两个都配则两条通道同时推送）
# ---------------------------------------------------------------------------
# 飞书群 → 设置 → 群机器人 → 添加自定义机器人，复制 Webhook 地址
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME

# 飞书机器人「安全设置 → 签名校验」生成的密钥。
# 留空 = 不签名（此时机器人必须改用「自定义关键词」或「IP 白名单」方式放行）
FEISHU_SECRET=

# ---------------------------------------------------------------------------
# 钉钉自定义机器人
# ---------------------------------------------------------------------------
# 钉钉群 → 智能群助手 → 添加机器人 → 自定义机器人（Webhook 里含 access_token）
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=REPLACE_ME

# 钉钉机器人「安全设置 → 加签」生成的 SEC 开头密钥。
# 留空 = 不签名（此时机器人必须改用「自定义关键词」或「IP 白名单」方式放行）
DINGTALK_SECRET=

# 可选：钉钉机器人的「自定义关键词」。只有当你把钉钉安全设置选成「自定义关键词」
# 时才需要填，填了之后机器人消息的开头会自动带上这个词，用于通过钉钉的安全校验。
# 选了「加签」的话留空即可。
DINGTALK_KEYWORD=

# ---------------------------------------------------------------------------
# 频率限制（可选，都有默认值）
# ---------------------------------------------------------------------------
# 同一 IP 在窗口期内允许的提交次数，默认 5
INQUIRY_RATE_LIMIT=5
# 限流窗口秒数，默认 600（10 分钟）
INQUIRY_RATE_WINDOW_SECONDS=600

# ---------------------------------------------------------------------------
# Upstash Redis（可选，强烈建议生产环境配置）
# ---------------------------------------------------------------------------
# 不配也能跑：此时退化为「进程内内存限流」，见报告中的降级说明。
# 生产环境（Vercel Serverless）每个实例内存独立且随时回收，内存限流基本无效，
# 必须配置 Upstash 才能实现跨实例、跨请求的真正限流。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
