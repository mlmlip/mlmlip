  }

  /* Step 4: Quantity & Packaging */
  .tier-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .tier-card {
    cursor: pointer;
  }

  .tier-inner {
    border: 2px solid var(--line, #e8d7dc);
    border-radius: 12px;
    padding: 20px;
    background: #fff;
    display: flex;
    flex-direction: column;
    height: 100%;
