---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';

// 3 种开箱即用预配置测款套盒
const sampleKits = [
  {
    id: 'clean-beauty-lip-oil',
    name: 'Clean Beauty Lip Oil Kit',
    badge: 'Clean & Peptide Focus',
    price: '$50',
    priceNote: '100% credited to bulk order',
    image: '/products/nas-sync-01.jpg',
    moq: '500 pcs/shade',
    dispatch: '7 Business Days',
    features: ['Vegan & Cruelty-Free', 'Peptide-Infused & Squalane Base', 'Botanical Seed Oils'],
    textures: [
      { name: 'Hydra-Glass (Dewy High Shine)', desc: 'Ultralight cushion glaze with botanical squalane & vitamin E.' },
      { name: 'Peptide Plump (Volumizing)', desc: 'Maxi-Lip tripeptide matrix with gentle cooling tingle.' },
      { name: 'Barrier Restorative (Intense Repair)', desc: 'Ceramide NP + organic rosehip seed oil overnight lipid barrier.' }
    ],
    packagingIncluded: 'Jumbo doe-foot clear acrylic vials + cooling ceramic applicator sample',
    compliance: 'EU CPNP Ready · US FDA MoCRA Compliant'
  },
  {
    id: 'velvet-matte-lip-mud',
    name: 'Velvet Matte Lip Mud Kit',
    badge: 'Soft-Focus Texture',
    price: '$50',
    priceNote: '100% credited to bulk order',
    image: '/products/nas-sync-39-1.jpg',
    moq: '500 pcs/shade',
    dispatch: '7 Business Days',
    features: ['Transfer-Proof & Mask-Friendly', '12-Hour Weightless Wear', 'Buildable Blurring Coverage'],
    textures: [
      { name: 'Classic Silk Velvet Mud', desc: 'Whipped elastomer matrix that blurs fine lip lines effortlessly.' },
      { name: 'Airy Sugar Mist Mud', desc: 'Powder-cloud featherweight touch, zero tackiness, ultra-diffused finish.' },
      { name: 'Hydrating Cream-to-Powder', desc: 'Nourishing murumuru butter infused comfort matte that never flakes.' }
    ],
    packagingIncluded: 'Frosted soft-touch square tubes + airtight wiper mini-pot test jars',
    compliance: 'Heavy metal ICP-MS Pb < 2ppm · GMPC Cleanroom'
  },
  {
    id: 'precision-lip-liner',
    name: 'Precision Lip Liner Kit',
    badge: 'Waterproof Mechanism Kit',
    price: '$50',
    priceNote: '100% credited to bulk order',
    image: '/products/auto-01-1.jpg',
    moq: '500 pcs/shade',
    dispatch: '7 Business Days',
    features: ['Waterproof & Smudge-Proof', 'Retractable & Twist-Up Options', 'Includes Sharpener Options'],
    textures: [
      { name: '2.0mm Retractable Twist Gel', desc: 'Waterproof silicone gel wax with integrated tail-cap sharpener.' },
      { name: 'Californian Cedarwood Pencil', desc: 'Traditional sharpenable wooden barrel with high-pigment wax core.' },
      { name: '1.5mm Ultra-Fine Micro-Core', desc: 'Automatic fine-lead mechanism for razor-sharp micro-contouring.' }
    ],
    packagingIncluded: 'Aluminum-accented mechanical barrels + sharpenable cedarwood pencils',
    compliance: 'Clean plant wax formula · US / EU Colorant Compliant'
  }
];

// 4 步极速打样流程 (对齐需求规范)
const workflowSteps = [
  {
    step: '01',
    title: '1. Tell Us Your Vision',
    subtitle: 'Consultation & Target Brief',
    description: 'Share your texture desires, Pantone / Hex shades, benchmark samples, and target packaging mechanisms.'
  },
  {
    step: '02',
    title: '2. Receive Samples in 7 Days',
    subtitle: 'Express Lab Formulation',
    description: 'Our cosmetic chemists compound your physical formulas in our ISO 22716 cleanroom and ship express to your doorstep.'
  },
  {
    step: '03',
    title: '3. Approve or Free Re-adjust',
    subtitle: 'Zero-Risk Verification',
    description: 'Evaluate slip, scent, and ΔE ≤ 0.5 shade accuracy. If the bench sample isn’t 100% dialed in, we re-tune the batch for free.'
  },
  {
    step: '04',
    title: '4. Production in 15–25 Days',
    subtitle: 'Full Credit & Mass Filling',
    description: 'Sign off on mass manufacturing from 500 pcs. 100% of your $50 sample kit fee is credited straight onto your bulk invoice.'
  }
];

// 信任背书
const trustPillars = [
  {
    icon: '🔬',
    title: 'Color Match ΔE ≤ 0.5',
    description: 'Every shade is verified using X-Rite spectrophotometers under D65 daylight illuminants. Zero visible batch-to-batch shift between lab beaker and bulk filling.'
  },
  {
    icon: '🛡️',
    title: 'ISO 22716 · FDA MoCRA · EU CPNP Ready',
    description: 'Formulated in certified cosmetics GMP cleanrooms. Includes heavy-metal safety audits (Pb < 2.0 ppm), microbial clearance, and full regulatory dossier preparation.'
  },
  {
    icon: '💰',
    title: '100% Fee Credited to Bulk',
    description: 'Zero economic risk. Every dollar of your $50 sample kit fee is deducted directly from your initial 500 pcs bulk production invoice.'
  },
  {
    icon: '🔄',
    title: 'Free Re-adjustment Guarantee',
    description: 'Not completely satisfied with the viscosity or mouthfeel? Our R&D chemists re-adjust your formulation free of charge until it matches your exact brief.'
  }
];

// Schema.org Product / Offer 结构化数据
const sampleSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "MLM Lip Custom Formulation Sample Kits",
  "description": "Order $50 sample kits with 7-day delivery. 3 lip textures per kit. Fees credited 100% to bulk production. ISO 22716 & FDA registered facility. MOQ 500 pcs.",
  "brand": {
    "@type": "Brand",
    "name": "MLM Lip"
  },
  "manufacturer": {
    "@type": "Organization",
    "name": "Beautychain Limited",
    "url": "https://mlmlip.com"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "50.00",
    "highPrice": "50.00",
    "offerCount": "3",
    "offers": sampleKits.map((kit) => ({
      "@type": "Offer",
      "name": kit.name,
      "price": "50.00",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "url": "https://mlmlip.com/samples"
    }))
  }
};
---

<BaseLayout
  title="Sample Kits — Test Custom Lip Products Before You Commit | MLM Lip"
  description="Order $50 sample kits with 7-day delivery. 3 lip textures per kit. Fees credited 100% to bulk production. ISO 22716 & FDA registered facility. MOQ 500 pcs."
>
  <script type="application/ld+json" set:html={JSON.stringify(sampleSchema)} slot="head" />

  <!-- Hero Section -->
  <section class="samples-hero" style="background: linear-gradient(180deg, #fffdfd 0%, var(--blush-soft) 100%); padding-top: 56px; padding-bottom: 72px; border-bottom: 1px solid var(--line);">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Sample Kits' }]} />
      
      <div style="text-align: center; max-width: 840px; margin: 24px auto 0;">
        <span class="eyebrow" style="color: var(--gold); letter-spacing: 0.22em; font-weight: 700;">Fast-Track Prototyping</span>
        <h1 style="font-size: clamp(34px, 4.8vw, 56px); margin: 12px 0 20px; line-height: 1.15; color: var(--plum);">
          Sample Kits — Test Before You Commit
        </h1>
        <p class="lead" style="font-size: clamp(17px, 2vw, 20px); font-weight: 600; color: var(--burgundy); margin-bottom: 16px;">
          7-day delivery · Color match &Delta;E &le; 0.5 · Sample fees 100% credited to bulk orders
        </p>
        <p style="font-size: 15px; color: var(--ink-soft); line-height: 1.8; max-width: 680px; margin: 0 auto 36px;">
          Overcome formulation uncertainty and customs fears before spending your production budget. Receive physical chemist-compounded lab samples in 7 days, complete with compliance dossiers and a 100% bulk invoice credit.
        </p>

        <!-- CTA Row -->
        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; align-items: center;">
          <a class="btn" href="#sample-kits" style="padding: 16px 36px; font-size: 16px; box-shadow: 0 6px 20px rgba(110,26,50,0.22);">
            Request Your Sample Kit &darr;
          </a>
          <a class="btn ghost" href={site.contact.whatsappLink + "?text=" + encodeURIComponent("Hi MLM Lip team, I want to order a custom lip sample kit.")} target="_blank" rel="noopener" style="padding: 16px 28px; font-size: 15px; display: inline-flex; align-items: center; gap: 8px;">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M17.5 14.4c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.7.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.7-1.7-.9-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3.1 5 4.3 2.5 1 3 .8 3.6.8.6-.1 1.9-.8 2.1-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/>
            </svg>
            Chat on WhatsApp
          </a>
        </div>

        <!-- Micro Guarantees Bar -->
        <div style="display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; margin-top: 36px; padding-top: 24px; border-top: 1px dashed var(--line); font-size: 13px; font-weight: 600; color: var(--plum);">
          <span>&#10003; 500 Pcs Universal MOQ</span>
          <span>&#10003; 7-Day Lab Dispatch</span>
          <span>&#10003; 100% Fee Credited on Order</span>
          <span>&#10003; Free Re-Adjustment Guarantee</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Pre-Configured Sample Kits Section -->
  <section id="sample-kits" style="padding: 84px 0; background: var(--cream);">
    <div class="wrap">
      <div style="text-align: center; max-width: 720px; margin: 0 auto 52px;">
        <p class="eyebrow">Ready-To-Ship Formulations</p>
        <h2>3 Specialized Prototyping Sample Kits</h2>
        <p class="lead" style="margin: 0 auto; font-size: 16px;">
          Choose a pre-configured kit or outline your custom requirements. Each kit contains 3 distinct formulation texture variants and premium component packaging samples.
        </p>
      </div>

      <div class="grid three" style="gap: 28px; align-items: stretch;">
        {sampleKits.map((kit) => (
          <div class="card kit-card" style="display: flex; flex-direction: column; padding: 0; overflow: hidden; border: 1px solid var(--line); background: #ffffff; border-radius: 16px; position: relative;">
            <!-- Badge -->
            <div style="position: absolute; top: 14px; left: 14px; z-index: 2; background: var(--plum); color: #fff; font-size: 11px; font-weight: 700; padding: 4px 12px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.08em; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
              {kit.badge}
            </div>

            <!-- Image Container -->
            <div style="height: 220px; width: 100%; overflow: hidden; background: #f4e8eb; position: relative;">
              <img 
                src={kit.image} 
                alt={kit.name} 
                loading="lazy" 
                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;"
              />
            </div>

            <!-- Body Details -->
            <div style="padding: 24px; flex: 1; display: flex; flex-direction: column;">
              <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px;">
                <h3 style="font-size: 20px; margin: 0; color: var(--plum);">{kit.name}</h3>
              </div>

              <!-- Price Box -->
              <div style="display: flex; align-items: baseline; gap: 8px; margin: 8px 0 16px; padding: 8px 12px; background: var(--blush-soft); border-radius: 8px; border-left: 3px solid var(--gold);">
                <span style="font-size: 24px; font-weight: 700; color: var(--burgundy); font-family: 'Playfair Display', Georgia, serif;">{kit.price}</span>
                <span style="font-size: 12px; font-weight: 600; color: var(--rose-dark);">{kit.priceNote}</span>
              </div>

              <!-- Key Specs -->
              <div style="font-size: 12px; color: var(--ink-soft); display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px;">
                <span style="background: #fdf2f4; padding: 3px 8px; border-radius: 4px; border: 1px solid var(--line);"><strong>MOQ:</strong> {kit.moq}</span>
                <span style="background: #fdf2f4; padding: 3px 8px; border-radius: 4px; border: 1px solid var(--line);"><strong>Lead Time:</strong> {kit.dispatch}</span>
              </div>

              <!-- Feature Highlights -->
              <ul style="list-style: none; padding: 0; margin: 0 0 18px; font-size: 13px; color: var(--ink-soft); line-height: 1.8;">
                {kit.features.map((feat) => (
                  <li style="display: flex; align-items: center; gap: 6px;">
                    <span style="color: var(--gold); font-weight: bold;">&#10004;</span> {feat}
                  </li>
                ))}
              </ul>

              <!-- Included 3 Textures Breakdown -->
              <div style="border-top: 1px solid var(--line); padding-top: 14px; margin-bottom: 20px; flex: 1;">
                <p style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--plum); letter-spacing: 0.08em; margin-bottom: 8px;">
                  3 Formula Variants Included:
                </p>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                  {kit.textures.map((tex) => (
                    <div style="font-size: 12px; background: #faf7f8; padding: 8px 10px; border-radius: 6px; border: 1px solid #f0e4e7;">
                      <div style="font-weight: 600; color: var(--ink);">{tex.name}</div>
                      <div style="color: #6b5c61; font-size: 11px; margin-top: 2px;">{tex.desc}</div>
                    </div>
                  ))}
                </div>
              </div>

              <div style="font-size: 11px; color: #7a6a70; margin-bottom: 18px; line-height: 1.5; border-top: 1px dashed var(--line); padding-top: 10px;">
                <strong>Components Included:</strong> {kit.packagingIncluded}
              </div>

              <!-- Card Action Button -->
              <a 
                href={`#request-form?kit=${encodeURIComponent(kit.name)}`} 
                class="btn kit-select-btn" 
                data-kit-name={kit.name}
                style="width: 100%; text-align: center; padding: 12px 18px; font-size: 14px;"
              >
                Order This Sample Kit ($50)
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Custom Spec Callout -->
      <div style="margin-top: 48px; background: linear-gradient(135deg, rgba(74,21,37,0.03) 0%, rgba(176,141,75,0.06) 100%); border: 1px solid var(--line); border-left: 4px solid var(--gold); border-radius: 12px; padding: 24px 30px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
        <div style="max-width: 720px;">
          <h4 style="font-size: 17px; margin: 0 0 6px; color: var(--plum);">Need a Bespoke Formula or Exact Benchmark Dupe?</h4>
          <p style="margin: 0; font-size: 14px; color: var(--ink-soft);">
            Have a physical benchmark sample (e.g. Fenty, Rhode, Dior Lip Glow Oil) or custom Pantone target? Send your benchmark to our Shenzhen R&amp;D lab. We reverse-engineer rheology, pigment dispersion, and skin feel within 7 days.
          </p>
        </div>
        <a class="btn ghost" href="/quote" style="white-space: nowrap; font-size: 14px;">
          Configure Custom Brief &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- 4-Step Sampling Workflow Section -->
  <section class="tint" style="padding: 84px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div class="wrap">
      <div style="text-align: center; max-width: 680px; margin: 0 auto 52px;">
        <p class="eyebrow">Agile Turnaround</p>
        <h2>The 4-Step Sampling Process</h2>
        <p class="lead" style="margin: 0 auto; font-size: 16px;">
          How we compress high-precision cosmetics prototyping from industry-standard months down to single-digit business days.
        </p>
      </div>

      <div class="grid four" style="gap: 20px;">
        {workflowSteps.map((st) => (
          <div class="card" style="padding: 26px 20px; background: #ffffff; border-radius: 14px; position: relative;">
            <div style="font-size: 32px; font-weight: 800; font-family: 'Playfair Display', Georgia, serif; color: var(--blush); position: absolute; top: 12px; right: 16px; line-height: 1;">
              {st.step}
            </div>
            <p class="eyebrow" style="color: var(--gold); margin-bottom: 8px; font-size: 11px;">Phase {st.step}</p>
            <h3 style="font-size: 18px; margin-bottom: 4px; color: var(--plum);">{st.title}</h3>
            <p style="font-size: 12px; font-weight: 600; color: var(--rose-dark); margin-bottom: 12px;">{st.subtitle}</p>
            <p style="font-size: 13px; color: var(--ink-soft); line-height: 1.7; margin: 0;">{st.description}</p>
          </div>
        ))}
      </div>

      <!-- Quick Timeline Visual -->
      <div style="margin-top: 40px; background: #ffffff; border: 1px solid var(--line); border-radius: 12px; padding: 20px 24px; display: flex; align-items: center; justify-content: space-around; flex-wrap: wrap; gap: 16px; text-align: center;">
        <div>
          <div style="font-size: 22px; font-weight: 700; color: var(--burgundy);">1. Vision Brief</div>
          <div style="font-size: 12px; color: var(--ink-soft);">24h Chemist Review</div>
        </div>
        <div style="color: var(--gold); font-size: 18px;">&rarr;</div>
        <div>
          <div style="font-size: 22px; font-weight: 700; color: var(--burgundy);">2. 7-Day Samples</div>
          <div style="font-size: 12px; color: var(--ink-soft);">Cleanroom Dispatched</div>
        </div>
        <div style="color: var(--gold); font-size: 18px;">&rarr;</div>
        <div>
          <div style="font-size: 22px; font-weight: 700; color: var(--burgundy);">3. Free Re-adjust</div>
          <div style="font-size: 12px; color: var(--ink-soft);">&Delta;E &le; 0.5 Color Match</div>
        </div>
        <div style="color: var(--gold); font-size: 18px;">&rarr;</div>
        <div>
          <div style="font-size: 22px; font-weight: 700; color: var(--burgundy);">4. 15–25 Days Bulk</div>
          <div style="font-size: 12px; color: var(--ink-soft);">100% Fee Credited Back</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Endorsement & Regulatory Section -->
  <section style="padding: 84px 0; background: #ffffff;">
    <div class="wrap">
      <div style="text-align: center; max-width: 720px; margin: 0 auto 52px;">
        <p class="eyebrow">Enterprise Trust &amp; Science</p>
        <h2>Engineered for Retail Audits &amp; Customs Clearance</h2>
        <p class="lead" style="margin: 0 auto; font-size: 16px;">
          Eliminating the two existential fears of indie beauty brands: formulation inconsistency and regulatory impoundment.
        </p>
      </div>

      <div class="grid two" style="gap: 28px;">
        {trustPillars.map((tp) => (
          <div class="card gold-line" style="display: flex; gap: 20px; align-items: flex-start; padding: 28px;">
            <div style="font-size: 36px; line-height: 1; flex-shrink: 0; background: var(--blush-soft); padding: 12px; border-radius: 12px; border: 1px solid var(--line);">
              {tp.icon}
            </div>
            <div>
              <h3 style="font-size: 19px; margin-bottom: 8px; color: var(--plum);">{tp.title}</h3>
              <p style="font-size: 14px; line-height: 1.8; color: var(--ink-soft); margin: 0;">{tp.description}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Factory Certifications Logos / Badges Strip -->
      <div style="margin-top: 48px; padding: 24px; background: var(--blush-soft); border-radius: 12px; border: 1px solid var(--line); display: flex; justify-content: space-around; align-items: center; flex-wrap: wrap; gap: 20px; text-align: center;">
        <div>
          <strong style="color: var(--plum); font-size: 15px; display: block;">ISO 22716:2007</strong>
          <span style="font-size: 12px; color: var(--ink-soft);">Cosmetics GMP Certified</span>
        </div>
        <div style="height: 30px; width: 1px; background: var(--line);" class="divider-line"></div>
        <div>
          <strong style="color: var(--plum); font-size: 15px; display: block;">US FDA MoCRA</strong>
          <span style="font-size: 12px; color: var(--ink-soft);">Active Facility Registration</span>
        </div>
        <div style="height: 30px; width: 1px; background: var(--line);" class="divider-line"></div>
        <div>
          <strong style="color: var(--plum); font-size: 15px; display: block;">EU CPNP Ready</strong>
          <span style="font-size: 12px; color: var(--ink-soft);">Turn-Key CPSR &amp; PIF Dossiers</span>
        </div>
        <div style="height: 30px; width: 1px; background: var(--line);" class="divider-line"></div>
        <div>
          <strong style="color: var(--plum); font-size: 15px; display: block;">Cleanroom Filling</strong>
          <span style="font-size: 12px; color: var(--ink-soft);">Class 100,000 Air Purity</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA & Sample Request Lead Form -->
  <section id="request-form" style="padding: 84px 0; background: linear-gradient(180deg, var(--blush-soft) 0%, #fff 100%); border-top: 1px solid var(--line);">
    <div class="wrap">
      <div style="text-align: center; max-width: 680px; margin: 0 auto 40px;">
        <span class="eyebrow" style="color: var(--gold);">Fast-Track Dispatch</span>
        <h2>Request Your Sample Kit</h2>
        <p class="lead" style="font-size: 15px; margin: 0 auto;">
          Select your target kit or outline your custom requirements below. Our international sales engineering team will confirm your shade directions, shipping address, and generate an itemized invoice with 100% credit guarantee within 24 hours.
        </p>
      </div>

      <div class="card" style="max-width: 720px; margin: 0 auto; box-shadow: var(--shadow-md); border: 1px solid var(--line); border-top: 4px solid var(--burgundy); background: #ffffff; padding: 36px 32px;">
        <form id="sample-request-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="b0681fa9-0cc8-4fd9-80f7-4d5faa39b2e7" />
          <input type="hidden" name="subject" value="New $50 Sample Kit Request via MLM Lip" />
          <input type="hidden" name="from_name" value="MLM Lip Samples Page" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none;" />

          <div class="grid two" style="gap: 16px;">
            <div class="form-row">
              <label for="sample-name" style="font-weight: 600; font-size: 13px; color: var(--ink);">Full Name <span style="color: var(--burgundy);">*</span></label>
              <input id="sample-name" name="name" type="text" required placeholder="e.g. Elena Rostova" style="width: 100%;" />
            </div>
            <div class="form-row">
              <label for="sample-email" style="font-weight: 600; font-size: 13px; color: var(--ink);">Work Email <span style="color: var(--burgundy);">*</span></label>
              <input id="sample-email" name="email" type="email" required placeholder="e.g. founder@beautybrand.com" style="width: 100%;" />
            </div>
          </div>

          <div class="grid two" style="gap: 16px; margin-top: 12px;">
            <div class="form-row">
              <label for="sample-company" style="font-weight: 600; font-size: 13px; color: var(--ink);">Brand / Company Name</label>
              <input id="sample-company" name="company" type="text" placeholder="e.g. Lumina Cosmetics" style="width: 100%;" />
            </div>
            <div class="form-row">
