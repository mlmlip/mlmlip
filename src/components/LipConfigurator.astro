  }

  /* Step 3: Markets */
  .market-selection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
  }

  .market-card {
    cursor: pointer;
  }

  .market-box {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border-radius: 10px;
    border: 1.5px solid var(--line, #e8d7dc);
    background: #ffffff;
    height: 100%;
    transition: all 0.2s;
  }

  .market-card input:checked + .market-box {
    border-color: var(--burgundy, #6e1a32);
    background: #fdf5f7;
  }

  .market-box .flag {
    font-size: 26px;
