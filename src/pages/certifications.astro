---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Quality Certifications & Regulatory Compliance Standards — Beautychain Limited"
  description="Official compliance specifications for Beautychain Limited (mlmlip.com): ISO 22716, US FDA GMPC, FDA MoCRA listing, EU CPNP notifications, heavy metal testing limits, and microbiology safety."
>
  <section style="background: linear-gradient(180deg, var(--cream) 0%, var(--blush-soft) 100%); padding-bottom: 40px;">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Certifications & Compliance' }]} />
      <p class="eyebrow" style="color: var(--gold); letter-spacing: 0.2em;">Enterprise E-E-A-T &amp; Quality Engineering</p>
      <h1>Regulatory Certifications &amp; Quality Assurance</h1>
      <p class="lead" style="max-width: 760px;">
        Beautychain Limited operates dedicated cleanroom cosmetic manufacturing facilities certified to international standards. We supply turnkey OEM/ODM lip cosmetics fully compliant with US FDA MoCRA and European Union Cosmetics Regulation (EC) No 1223/2009.
      </p>
    </div>
  </section>

  <!-- Key Certification Grid -->
  <section>
    <div class="wrap">
      <div class="grid two">
        <div class="card" style="border-top: 4px solid var(--burgundy); box-shadow: var(--shadow-sm);">
          <div style="display:flex; justify-content:space-between; align-items:flex-start;">
            <p class="eyebrow" style="color: var(--rose);">Standard No. ISO 22716:2007</p>
            <span style="background: #eef7ee; color: #1e7e34; padding: 4px 10px; border-radius: 99px; font-size: 12px; font-weight: 600;">Audited Cleanroom</span>
          </div>
          <h2 style="font-size: 22px; margin: 10px 0 14px;">ISO 22716 Cosmetics GMP Certification</h2>
          <p style="font-size: 14px; line-height: 1.6; color: var(--ink-soft); margin-bottom: 16px;">
            Our production lines adhere strictly to ISO 22716:2007 Good Manufacturing Practices for Cosmetics. Covering personnel, premises, equipment, raw material quarantine, hygienic batch processing, packaging, and laboratory quality control.
          </p>
          <ul style="font-size: 14px; line-height: 1.8; padding-left: 20px; color: var(--ink);">
            <li>Class 100,000 (ISO Class 8) HEPA-filtered cleanroom filling suites</li>
            <li>Dedicated HVAC differential pressure controls preventing cross-contamination</li>
            <li>Automated CIP (Clean-in-Place) stainless steel batch emulsification vessels</li>
            <li>Full traceability from raw material lot to finished boxed SKU</li>
          </ul>
        </div>

        <div class="card" style="border-top: 4px solid var(--burgundy); box-shadow: var(--shadow-sm);">
          <div style="display:flex; justify-content:space-between; align-items:flex-start;">
            <p class="eyebrow" style="color: var(--rose);">US FDA Standard</p>
            <span style="background: #eef7ee; color: #1e7e34; padding: 4px 10px; border-radius: 99px; font-size: 12px; font-weight: 600;">FDA Compliant</span>
          </div>
          <h2 style="font-size: 22px; margin: 10px 0 14px;">US FDA GMPC (US Guidelines)</h2>
          <p style="font-size: 14px; line-height: 1.6; color: var(--ink-soft); margin-bottom: 16px;">
            Fully compliant with the United States Food and Drug Administration's Good Manufacturing Practice guidelines for cosmetics (CFSAN 21 CFR Part 700/701).
          </p>
          <ul style="font-size: 14px; line-height: 1.8; padding-left: 20px; color: var(--ink);">
            <li>Continuous environmental microbial air sampling and surface swabbing</li>
            <li>Validated DI (Deionized) reverse osmosis water purification systems</li>
            <li>Double-barrier airlock personnel sanitation protocol</li>
            <li>Strict retention sample archiving for 36 months post-batch release</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Market Compliance Standards -->
  <section class="tint">
    <div class="wrap">
      <p class="eyebrow" style="color: var(--gold);">Global Regulatory Readiness</p>
      <h2>Turnkey Dossiers for USA &amp; European Distribution</h2>
      <p class="lead" style="max-width: 720px; margin-bottom: 32px;">
        Exporting cosmetics requires airtight documentation. We provide complete technical dossiers directly to your designated Responsible Person (RP) or regulatory agent.
      </p>

      <div class="grid two">
        <div class="card">
          <h3 style="font-size: 20px; margin-bottom: 12px;">United States — FDA MoCRA Compliance</h3>
          <p style="font-size: 14px; line-height: 1.6; color: var(--ink-soft);">
            Under the Modernization of Cosmetics Regulation Act of 2022 (MoCRA):
          </p>
          <ul style="font-size: 14px; line-height: 1.8; padding-left: 20px; color: var(--ink); margin-top: 10px;">
            <li><strong>Facility Registration (Section 607):</strong> Beautychain manufacturing facilities are registered with FDA FEI credentials.</li>
            <li><strong>Cosmetic Product Listing (Section 607):</strong> Complete formula breakdowns and quantitative INCI listings provided for fast FDA portal submission.</li>
            <li><strong>Safety Substantiation (Section 608):</strong> Toxicological profile reviews, batch stability records, and ingredient purity records.</li>
            <li><strong>Adverse Event Recordkeeping:</strong> Standardized logging procedures adhering to FDA audit standards.</li>
          </ul>
        </div>

        <div class="card">
          <h3 style="font-size: 20px; margin-bottom: 12px;">European Union &amp; UK — CPNP Notification</h3>
          <p style="font-size: 14px; line-height: 1.6; color: var(--ink-soft);">
            In strict compliance with EU Regulation (EC) No 1223/2009 and UK Schedule 34:
          </p>
          <ul style="font-size: 14px; line-height: 1.8; padding-left: 20px; color: var(--ink); margin-top: 10px;">
            <li><strong>CPSR Dossier Ready:</strong> Cosmetic Product Safety Report Part A and Part B prepared by qualified European toxicologists.</li>
            <li><strong>CPNP Portal Notification:</strong> Full assistance with EU CPNP and UK Submit Cosmetic Product Notification (SCPN).</li>
            <li><strong>Cruelty-Free / Animal Testing Ban:</strong> 100% compliant with EU Chapter V animal testing prohibitions. Alternative in-vitro testing only.</li>
            <li><strong>Annex II &amp; III Compliance:</strong> Zero banned substances, strictly approved colorants and preservatives.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Testing & Quality Control Parameters Table -->
  <section>
    <div class="wrap">
      <p class="eyebrow" style="color: var(--gold);">Laboratory Protocol</p>
      <h2>Standard Release Testing Limits (Every Production Batch)</h2>
      <p class="lead" style="max-width: 720px; margin-bottom: 30px;">
        Every production run is backed by a Certificate of Analysis (COA) issued by our internal QC lab and verified via third-party testing (SGS / Intertek upon request).
      </p>

      <div style="overflow-x: auto; background: #fff; border: 1px solid var(--line); border-radius: 8px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
          <thead>
            <tr style="background: var(--cream); border-bottom: 2px solid var(--line);">
              <th style="padding: 14px 18px; font-weight: 600;">Test Category</th>
              <th style="padding: 14px 18px; font-weight: 600;">Testing Parameter</th>
              <th style="padding: 14px 18px; font-weight: 600;">Specification / Limit</th>
              <th style="padding: 14px 18px; font-weight: 600;">Test Methodology</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--line);">
              <td style="padding: 14px 18px; font-weight: 600;">Heavy Metals</td>
              <td style="padding: 14px 18px;">Lead (Pb)</td>
              <td style="padding: 14px 18px;">&le; 10 mg/kg (ppm) — typically &lt; 2 ppm</td>
              <td style="padding: 14px 18px;">ICP-MS (Inductively Coupled Plasma Mass Spectrometry)</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--line);">
              <td style="padding: 14px 18px; font-weight: 600;">Heavy Metals</td>
              <td style="padding: 14px 18px;">Arsenic (As)</td>
              <td style="padding: 14px 18px;">&le; 2 mg/kg (ppm) — typically &lt; 0.5 ppm</td>
              <td style="padding: 14px 18px;">ICP-MS</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--line);">
              <td style="padding: 14px 18px; font-weight: 600;">Heavy Metals</td>
              <td style="padding: 14px 18px;">Cadmium (Cd)</td>
              <td style="padding: 14px 18px;">&le; 5 mg/kg (ppm) — typically &lt; 0.5 ppm</td>
              <td style="padding: 14px 18px;">ICP-MS</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--line);">
              <td style="padding: 14px 18px; font-weight: 600;">Heavy Metals</td>
              <td style="padding: 14px 18px;">Mercury (Hg)</td>
              <td style="padding: 14px 18px;">&le; 1 mg/kg (ppm) — typically &lt; 0.1 ppm</td>
              <td style="padding: 14px 18px;">Cold Vapor Atomic Absorption (CV-AAS)</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--line);">
              <td style="padding: 14px 18px; font-weight: 600;">Microbiology</td>
              <td style="padding: 14px 18px;">Total Aerobic Microbial Count (TAMC)</td>
              <td style="padding: 14px 18px;">&le; 100 CFU/g (Lip mucosal standard)</td>
              <td style="padding: 14px 18px;">ISO 21149 Plate Count Method</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--line);">
              <td style="padding: 14px 18px; font-weight: 600;">Microbiology</td>
              <td style="padding: 14px 18px;">Total Combined Yeast and Mold (TYMC)</td>
              <td style="padding: 14px 18px;">&le; 10 CFU/g</td>
              <td style="padding: 14px 18px;">ISO 16212 Plate Count Method</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--line);">
              <td style="padding: 14px 18px; font-weight: 600;">Microbiology</td>
              <td style="padding: 14px 18px;">Specified Pathogens (E. coli, S. aureus, P. aeruginosa, C. albicans)</td>
              <td style="padding: 14px 18px;">Absence in 1.0 g sample</td>
              <td style="padding: 14px 18px;">ISO 22718, ISO 22717, ISO 21150, ISO 18416</td>
            </tr>
            <tr>
              <td style="padding: 14px 18px; font-weight: 600;">Physical Stability</td>
              <td style="padding: 14px 18px;">Thermal &amp; Freeze-Thaw Cycling</td>
              <td style="padding: 14px 18px;">Zero syneresis, oil separation, or crystallization (-10&deg;C to +45&deg;C / 12 wks)</td>
              <td style="padding: 14px 18px;">Accelerated Climatic Chamber Stability Protocol</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA Box -->
  <section style="background: linear-gradient(180deg, #fff 0%, var(--cream) 100%); padding: 60px 0;">
    <div class="wrap" style="text-align: center; max-width: 680px; margin: 0 auto;">
      <p class="eyebrow" style="color: var(--gold);">Enterprise Assurance</p>
      <h2>Need Specific Compliance Documentation for Your Retailer?</h2>
      <p class="lead" style="font-size: 15px; margin-bottom: 24px;">
        Whether you are pitching Sephora, Target, Ulta, or European pharmacy chains, our technical compliance team provides custom dossier packages, ingredient disclosure statements, and laboratory COAs.
      </p>
      <a href="/quote/" class="btn" style="background: var(--burgundy); color: #fff; padding: 14px 28px; border-radius: 8px; font-weight: 600; text-decoration: none; display: inline-block;">
        Request Compliance Audit &amp; Quote &rarr;
      </a>
    </div>
  </section>
</BaseLayout>
