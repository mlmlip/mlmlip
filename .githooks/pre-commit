#!/bin/bash
# Pre-commit hook to enforce strict business isolation from the sister site
# 'mlmglitter' (and sibling brand mlmcosmetic / MLM Cosmetical).
#
# 2026-11-20: rule narrowed to brand identifiers only. The previous generic
# words (glitter / shimmer / body oil) false-positived on legitimate product
# vocabulary: "biodegradable glitters (regenerated cellulose)" is the EU Reg
# 2023/2055 compliance term, glitter/shimmer appear in SKU names and texture
# descriptions with zero real cross-brand pollution (full-site audit
# 2026-11-20), and "body oil" is our own product line. The hook's real intent
# is to keep mlmglitter's brand name / traffic-leak traces off this site.

FORBIDDEN_WORDS=("mlmglitter" "mlm glitter" "glittercosmetics" "mlmcosmetic" "mlm cosmetical")
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FILES=()
while IFS= read -r _f; do
    [ -n "$_f" ] && FILES+=("$_f")
done <<< "$STAGED_FILES"
[ ${#FILES[@]} -eq 0 ] && exit 0
FOUND=0

for WORD in "${FORBIDDEN_WORDS[@]}"; do
    # 2026-11-14: scan the staged CONTENT, not the diff. `git diff -S` also fires on
    # deleted lines, which made it impossible to ever clean a violation up.
    MATCHES=$(git grep --cached -l -i -F -e "$WORD" -- "${FILES[@]}" 2>/dev/null || true)
    if [ -n "$MATCHES" ]; then
        # Exclude pre-commit hook itself or scripts that check for forbidden words.
        # 2026-11-14: also exclude the keyword pool (SEO-KEYWORDS.md) — its hits are the
        # prohibition rules themselves, and run_seo_bot.sh stages it on every publish,
        # so scanning it rejected the daily publish commit outright.
        FILTERED_MATCHES=$(echo "$MATCHES" | grep -v 'run_seo_bot.sh' | grep -v 'geo_monitor.sh' | grep -v 'jev_client.py' | grep -v 'scripts/' | grep -v 'reports/' | grep -v 'pre-commit' | grep -v 'SEO-KEYWORDS.md' || true)
        if [ -n "$FILTERED_MATCHES" ]; then
            echo "❌ [SECURITY VIOLATION] Forbidden keyword '$WORD' detected in staged files:"
            echo "$FILTERED_MATCHES"
            echo "Strict isolation policy: mlmlip must not reference glitter cosmetics."
            FOUND=1
        fi
    fi
done

if [ $FOUND -eq 1 ]; then
    echo "Commit rejected. Please eliminate all cross-brand references."
    exit 1
fi

exit 0
