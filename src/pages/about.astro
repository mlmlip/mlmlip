---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="About | Custom Lip Cosmetics Manufacturer — MLM Lip"
  description="MLM Lip is the custom lip cosmetics line of Beautychain Limited — GMPC, ISO and CPNP certified manufacturing of private label lip products for brands in North America and Europe."
>
  <section>
    <div class="wrap">
      <p class="eyebrow">About</p>
      <h1>The factory behind your lip brand</h1>
      <p class="lead" style="max-width:660px">
        MLM Lip is the lip cosmetics line of {site.manufacturer}, based in Shenzhen, China.
        We work with private label brand owners in North America and Europe — online sellers,
        offline retailers and founders alike — who want their own product, made their way.
      </p>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <div class="grid two">
        <div class="card">
          <h3>Low minimums as a principle</h3>
          <p style="margin:0">
            A 20,000 pcs minimum is not a business decision a new brand can make.
            We start at {site.moq} per SKU so your first run can be tested in the real market before you scale.
          </p>
        </div>
        <div class="card">
          <h3>Customization in-house</h3>
          <p style="margin:0">
            Packaging, formulation and branding are handled together, so the sample you approve
            is the product you receive — no mismatched parts from separate vendors.
          </p>
        </div>
        <div class="card">
          <h3>Sampling before commitment</h3>
          <p style="margin:0">
            Samples are ready in 7 days, and we iterate until the texture, shade and packaging are right.
            Order, and the sampling fee comes off your invoice — you commit only after you are satisfied.
          </p>
        </div>
        <div class="card">
          <h3>Lip specialists</h3>
          <p style="margin:0">
            Lip is our focus: gloss, mud, liner, lipstick, oil and mask.
            Body oils and other cosmetics are available as companion lines.
          </p>
        </div>
        <div class="card">
          <h3>Full-chain customization</h3>
          <p style="margin:0">
            An in-house packaging library, formulation tuning, logo and branding — and custom molds
            when your brand needs a pack nobody else has.
          </p>
        </div>
        <div class="card">
          <h3>Certified &amp; documented</h3>
          <p style="margin:0">
            GMPC, ISO and CPNP — we provide the certifications and documentation
            your market entry in North America and Europe requires.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Inside the factory</p>
      <h2>See the floor where your products are made</h2>
      <div class="grid two" style="margin-top:24px">
        <div>
          <div class="case-media video-embed">
            <video src="/factory/factory-production.mp4" controls preload="metadata"></video>
          </div>
          <h3 style="margin-top:12px; font-size:18px">Automated Production Line</h3>
          <p class="note" style="margin:0">High-speed precision filling and capping line.</p>
        </div>
        <div>
          <div class="case-media video-embed">
            <video src="/factory/factory-cleanroom.mp4" controls preload="metadata"></video>
          </div>
          <h3 style="margin-top:12px; font-size:18px">GMPC Cleanroom Operation</h3>
          <p class="note" style="margin:0">Sterile cosmetic manufacturing environment.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Work with us</h2>
      <p class="lead" style="max-width:600px">
        Whether you have a finished concept or just the beginning of an idea, the first step is the same:
        tell us what you want to launch.
      </p>
      <a class="btn" href="/contact">Contact our team</a>
    </div>
  </section>
</BaseLayout>
