---
import TrustBadges from '../components/TrustBadges.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GeoFAQ from '../components/GeoFAQ.astro';
import GeoComparisonTable from '../components/GeoComparisonTable.astro';
import { site, pillars, steps } from '../data/site';
---

<BaseLayout
  title="Customization | Packaging, Formulation & Logo for Lip Products — MLM Lip"
  description="Custom lip cosmetic formulas, bespoke packaging & private molds from 500 pcs MOQ. 7-day lab samples, FDA & EU CPNP certified. Launch your brand today."
>
  <section>
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Customization' }]} />
      <p class="eyebrow">Customization</p>
      <h1>Three layers of customization, one supplier</h1>
      <p class="lead" style="max-width:660px">
        Most suppliers hand you a catalogue and ask you to pick. We start from your brand:
        what the product should look like, feel like and say.
      </p>
    </div>
  </section>
  <TrustBadges />

  <section class="tint" style="padding-top:32px">
    <div class="wrap">
      <div class="grid three">
        {pillars.map((p) => (
          <div class="card">
            <h2 style="font-size:21px;">{p.title}</h2>
            <p style="margin:0">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Three routes, pick your level</p>
      <h2>Library, custom mold, or full bespoke</h2>
      <p class="lead" style="max-width:640px;">
        Not every brand needs a custom mold on day one. Pick the route that matches your stage — and upgrade later without changing supplier.
      </p>
      <div style="margin-top:28px;">
        <GeoComparisonTable
          columns={[
            { key: 'feature', label: 'What you get' },
            { key: 'library', label: 'Library route' },
            { key: 'custom', label: 'Custom mold route' },
            { key: 'bespoke', label: 'Full bespoke route' }
          ]}
          data={[
            { feature: 'Packaging', library: 'In-stock library components', custom: 'Exclusive custom-molded silhouette', bespoke: 'Custom mold + exclusive finish & decoration' },
            { feature: 'Formulation', library: 'Tuned from existing formula base', custom: 'Tuned from existing base or new active story', bespoke: 'Ground-up formulation, patent-ready' },
            { feature: 'Shade card', library: 'Pantone-matched to your palette', custom: 'Full custom shade development', bespoke: 'Exclusive shade range, no resale' },
            { feature: 'Branding', library: 'Logo print on library pack', custom: 'Logo + custom decoration on your mold', bespoke: 'Full brand system on exclusive components' },
            { feature: 'Tooling cost', library: 'None', custom: 'One-time mold fee (yours)', bespoke: 'Mold + finishing tooling (yours)' },
            { feature: 'Lead to sample', library: '7 days', custom: '4–8 weeks tooling + 7 days', bespoke: '6–10 weeks + 7 days' },
            { feature: 'Best for', library: 'First launch, market test', custom: 'Brand has traction, needs signature', bespoke: 'Mature brand expanding exclusive line' }
          ]}
        />
      </div>
      <p class="note" style="margin-top:14px;">
        All three routes share the same {site.moq} MOQ, 7-day sampling, and GMPC + ISO compliance. The route changes how exclusive your product looks — not whether we can make it.
      </p>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <h2>What you can specify</h2>
      <div class="grid two" style="margin-top:24px">
        <div class="card">
          <h3>Packaging</h3>
          <p style="margin:0">
            Start from our packaging library — tube and cap forms, materials and finishes
            (glossy, matte, metallized, frosted), applicator types and decorations
            (printing, hot stamping, silk screen). Need something nobody else has?
            We can open a custom mold for your brand.
          </p>
        </div>
        <div class="card">
          <h3>Formulation</h3>
          <p style="margin:0">
            Texture and finish, pigment and shade matching, wear and feel,
            fragrance, and the ingredient story you want to tell on the label.
          </p>
        </div>
        <div class="card">
          <h3>Logo &amp; branding</h3>
          <p style="margin:0">
            Your logo on primary and secondary packaging, label design,
            color matching to your brand palette, and printed product information.
          </p>
        </div>
        <div class="card">
          <h3>Minimums &amp; sampling</h3>
          <p style="margin:0">
            From {site.moq} per SKU, the same across every product category.
            Samples are ready in 7 days, developed against your brief — and when you place the order,
            the sampling fee is deducted from it, so sampling effectively costs nothing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">In-house packaging library</p>
      <h2>Components you can brand today</h2>
      <p class="lead" style="max-width: 680px">
        A selection of premium tubes, caps and applicators already in stock. Need an exclusive silhouette? We open custom molds to your exact brief.
      </p>
      <div class="grid two" style="margin-top: 28px">
        <div class="card gold-line">
          <div class="case-media" style="margin-bottom: 16px">
            <img height="600" width="800" src="/factory/packaging-tubes-01.jpg" alt="Custom lip gloss tube" loading="lazy" />
          </div>
          <h3>Square clear tube with rose-gold cap</h3>
          <p style="margin:0">Premium heavyweight feel, ready for silk-screen or hot-stamp branding.</p>
        </div>
        <div class="card gold-line">
          <div class="case-media" style="margin-bottom: 16px">
            <img height="600" width="800" src="/factory/packaging-tubes-02.jpg" alt="Packaging library samples" loading="lazy" />
          </div>
          <h3>Curated component library</h3>
          <p style="margin:0">Acrylic, zamac, aluminum and slim-profile options sourced and inspected in-house.</p>
        </div>
      </div>
      <p style="margin-top: 28px"><a class="btn" href="/contact">Request component catalog</a></p>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <h2>The process</h2>
      <div class="grid two" style="margin-top:24px">
        {steps.map((s) => (
          <div class="card">
            <p class="eyebrow" style="margin-bottom:6px">Step {s.n}</p>
            <h3>{s.title}</h3>
            <p style="margin:0">{s.body}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:28px"><a class="btn" href="/contact">Book a consultation</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <GeoFAQ
        faqs={[
          {
            question: "What is your MOQ for custom lip products?",
            answer: `Our standard MOQ is ${site.moq} pieces per SKU for library packaging routes. This low threshold is perfect for indie brands testing new shade ranges or formulations without heavy inventory risks.`
          },
          {
            question: "How long does it take to create a custom formula sample?",
            answer: "Once we finalize your brief, our lab typically prepares your custom formulation samples within 7 business days. This includes pigment matching and initial stability testing."
          },
          {
            question: "Do you provide CPNP PIF files for the EU market?",
            answer: "Yes, we provide full Product Information Files (PIF) and can assist with CPNP registration. Our formulas are strictly audited for EU compliance, ensuring no banned substances are used."
          },
          {
            question: "What are the costs for a custom mold (tooling)?",
            answer: "Custom mold fees for a unique tube silhouette generally range between $1,500 and $3,500 depending on complexity. The mold belongs entirely to you and will never be used for other clients."
          },
          {
            question: "Are your lip cosmetics cruelty-free and vegan?",
            answer: "Absolutely. We offer an extensive library of vegan bases, and we never test on animals. We can also formulate with clean, organic, and halal-compliant ingredients upon request."
          }
        ]}
      />
    </div>
  </section>
</BaseLayout>
