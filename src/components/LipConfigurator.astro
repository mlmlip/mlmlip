  }

  .market-details strong {
    display: block;
    font-size: 14px;
    color: var(--ink, #141013);
    margin-bottom: 4px;
  }

  .market-details span {
    font-size: 11px;
    color: var(--ink-soft, #4a3e42);
    line-height: 1.4;
