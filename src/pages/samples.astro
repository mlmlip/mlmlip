  <script is:inline>
    // 监听 URL 参数或卡片点击以自动填充套盒选择
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const prefillProduct = urlParams.get('product');
      const selectEl = document.getElementById('sample-kit-choice');

      if (prefillProduct && selectEl) {
        for (let i = 0; i < selectEl.options.length; i++) {
          if (selectEl.options[i].text.toLowerCase().includes(prefillProduct.toLowerCase())) {
            selectEl.selectedIndex = i;
            break;
          }
        }
      }

      // 卡片点击联动选择
      const kitButtons = document.querySelectorAll('.kit-select-btn');
      kitButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const kitName = btn.getAttribute('data-kit-name');
          if (kitName && selectEl) {
            for (let i = 0; i < selectEl.options.length; i++) {
              if (selectEl.options[i].value.includes(kitName)) {
                selectEl.selectedIndex = i;
                break;
              }
            }
          }
          const formSec = document.getElementById('request-form');
          if (formSec) {
            formSec.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });

      // AJAX 表单提交反馈
      const form = document.getElementById('sample-request-form');
      const submitBtn = document.getElementById('sample-submit-btn');
      const statusMsg = document.getElementById('sample-status-msg');

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!submitBtn || !statusMsg) return;

          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting Request...';
          statusMsg.style.display = 'none';

          try {
            const formData = new FormData(form);
            const response = await fetch(form.action, {
              method: 'POST',
              body: formData,
              headers: { 'Accept': 'application/json' }
            });

            if (response.ok) {
              form.reset();
              statusMsg.textContent = '✓ Sample kit request received! Our lab engineering coordinator will email you within 24 hours to confirm your shade specifications.';
              statusMsg.style.color = '#2d6a4f';
              statusMsg.style.display = 'block';
              submitBtn.textContent = 'Request Submitted Successfully';
            } else {
              throw new Error('Form submission failed');
            }
          } catch (err) {
            statusMsg.textContent = 'An error occurred. Please contact us directly via WhatsApp (+86 136 5238 0291) or email nancy@mlmlip.com.';
            statusMsg.style.color = '#b00020';
            statusMsg.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Retry Submission';
          }
        });
      }
    });
  </script>
