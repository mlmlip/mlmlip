---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { productsCatalog } from '../../data/products';

const catSlug = 'lip-liner-manufacturer';
const catProducts = productsCatalog.filter((p) => p.categorySlug === catSlug);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{"@type":"Question","name":"Quel est le minimum de commande pour les crayons ?","acceptedAnswer":{"@type":"Answer","text":"500 pièces par référence (SKU), identique à l'ensemble de nos catégories de maquillage labial."}},{"@type":"Question","name":"Bois de cèdre ou mécanique : que privilégier ?","acceptedAnswer":{"@type":"Answer","text":"Le bois de cèdre offre un cachet prestigieux et traditionnel. Le format automatique twist-up apporte une praticité nomade sans taille-crayon."}},{"@type":"Question","name":"Peut-on assembler des kits duo combinant crayon et gloss ?","acceptedAnswer":{"@type":"Answer","text":"Oui, nous réalisons régulièrement des sets et coffrets coordonnés (crayon contour + gloss ou encre à lèvres) avec étuis sur mesure."}}]
};
---

<BaseLayout title="Fabricant de Crayons à Lèvres Marque Blanche | MOQ 500 pcs — MLM Lip" description="Fabrication sur mesure de crayons à lèvres en bois de cèdre ou mécaniques dès 500 pièces. Formules waterproof, glisse ultra-douce, certification ISO 22716.">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section style="background: linear-gradient(180deg, var(--cream) 0%, var(--blush-soft) 100%); padding-top: 50px; padding-bottom: 50px;">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Accueil', href: '/fr/' }, { label: 'Produits', href: '/fr/produits' }, { label: 'Crayon à Lèvres' }]} />
      <p class="eyebrow" style="color: var(--gold); letter-spacing: 0.15em;">Crayon à Lèvres · Spécialiste Marque Blanche OEM/ODM</p>
      <h1 style="font-size: clamp(28px, 3.8vw, 44px); max-width: 860px; margin-bottom: 16px;">Fabricant de Crayons à Lèvres en Marque Blanche</h1>
      <p class="lead" style="max-width: 720px; font-size: 17px; line-height: 1.5; margin-bottom: 24px;">Des crayons haute précision qui définissent et subliment le contour des lèvres en harmonie parfaite avec vos rouges et gloss. Formats bois de cèdre traditionnel ou rétractables automatiques.</p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a class="btn" href="/fr/quote">Demander un devis</a>
        <a class="btn ghost" href="/fr/quote#email-inquiry">Commander un kit d'échantillons</a>
      </div>
      <p class="note" style="margin-top: 16px; font-size: 13px; color: var(--ink-soft);">
        ✓ MOQ 500 pcs &nbsp;·&nbsp; ✓ Échantillons 7 jours &nbsp;·&nbsp; ✓ Frais remboursés &nbsp;·&nbsp; ✓ ISO 22716 & FDA
      </p>
    </div>
  </section>

  <section style="padding: 48px 0;">
    <div class="wrap">
      <div class="grid two" style="align-items: center; gap: 36px;">
        <div class="case-media" style="border-radius: 8px; overflow: hidden; box-shadow: var(--shadow-sm);">
          <img src="/products/lipliner-10-01.jpg" alt="Fabricant de Crayons à Lèvres en Marque Blanche" width="800" height="600" style="width: 100%; height: auto; display: block;" loading="lazy" />
        </div>
        <div>
          <p class="eyebrow" style="color: var(--burgundy);">Spécifications & Atouts</p>
          <h2 style="font-size: 26px; margin-bottom: 14px;">Formulation et design sur mesure</h2>
          <ul style="padding-left: 20px; color: var(--ink-soft); line-height: 1.7; font-size: 14px;">
            <li>Formats en bois de cèdre noble ou stylos mécaniques rétractables</li>
            <li>Mines crémeuses ultra-glissantes, sans tiraillement et sans bavure</li>
            <li>Alignement colorimétrique exact sur votre gamme de rouges à lèvres</li>
            <li>Laquage du corps au Pantone, embouts et capuchons personnalisés</li>
            <li>Formules longue tenue, résistantes à l'eau (waterproof) et anti-filage</li>
            <li>Possibilité de conditionnement en coffrets duo ou kits lèvres coordonnés</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {catProducts.length > 0 && (
    <section class="tint" style="padding: 48px 0;">
      <div class="wrap">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 24px; flex-wrap: wrap; gap: 10px;">
          <div>
            <p class="eyebrow" style="color: var(--gold);">Formulations Disponibles</p>
            <h2 style="font-size: 24px; margin: 0; color: var(--plum);">Catalogue Formules : Crayon à Lèvres</h2>
          </div>
          <a href="/fr/produits" style="color: var(--burgundy); font-weight: 600; font-size: 14px;">Toutes les formules →</a>
        </div>

        <div class="grid three" style="gap: 20px;">
          {catProducts.map((p) => (
            <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; border-radius: 8px; padding: 16px; background: white;">
              <div><div class="case-media" style="margin-bottom: 12px; border-radius: 6px; overflow: hidden;">
                  <img src={p.heroImage} alt={p.name} width="600" height="450" style="width: 100%; aspect-ratio: 4/3; object-fit: cover;" loading="lazy" />
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                  <span style="font-size: 11px; font-weight: 700; color: var(--gold); text-transform: uppercase;">{p.tag}</span><span style="font-size: 11px; color: var(--ink-soft); font-family: monospace;">MOQ {p.moq} pcs</span>
                </div>
                <h3 style="font-size: 16px; margin: 0 0 6px; line-height: 1.3;">
                  <a href="/fr/quote" style="color: var(--plum); text-decoration: none;">{p.name}</a>
                </h3>
                <p style="font-size: 13px; color: var(--ink-soft); line-height: 1.4; margin-bottom: 12px;">{p.headline}</p>
              </div>
              <div style="border-top: 1px solid var(--line); padding-top: 10px; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 12px; color: var(--ink-soft);">{p.shadeCount} teintes</span>
                <a href="/fr/quote" style="font-size: 13px; font-weight: 600; color: var(--burgundy); text-decoration: none;">Demander un devis →</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section style="padding: 48px 0;">
    <div class="wrap">
      <p class="eyebrow" style="color: var(--gold);">Fiche Technique Usine</p>
      <h2 style="font-size: 26px; margin-bottom: 20px;">Spécifications de fabrication : Crayon à Lèvres</h2>
      <div class="card gold-line" style="padding: 0; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
          
            <tr style="border-bottom: 1px solid var(--line);"><td style="padding: 14px 20px; width: 32%; color: var(--plum); font-weight: 600;">Quantité minimale (MOQ)</td><td style="padding: 14px 20px; color: var(--ink-soft);">500 pièces par référence (SKU)</td></tr>
            <tr style="border-bottom: 1px solid var(--line);"><td style="padding: 14px 20px; width: 32%; color: var(--plum); font-weight: 600;">Échantillonnage laboratoire</td><td style="padding: 14px 20px; color: var(--ink-soft);">7 jours ouvrés, expédiés par coursier express</td></tr>
            <tr style="border-bottom: 1px solid var(--line);"><td style="padding: 14px 20px; width: 32%; color: var(--plum); font-weight: 600;">Personnalisation</td><td style="padding: 14px 20px; color: var(--ink-soft);">Corps bois/plastique, mine fondante ou ferme, marquage à chaud</td></tr>
            <tr style="border-bottom: 1px solid var(--line);"><td style="padding: 14px 20px; width: 32%; color: var(--plum); font-weight: 600;">Normes & Conformité</td><td style="padding: 14px 20px; color: var(--ink-soft);">Conformité totale ISO 22716, GMPC, FDA et notification CPNP</td></tr>
        </table>
      </div>
    </div>
  </section>

  <section class="tint" style="padding: 48px 0;">
    <div class="wrap">
      <p class="eyebrow" style="color: var(--gold);">FAQ</p>
      <h2 style="font-size: 26px; margin-bottom: 24px;">Questions fréquentes sur Crayon à Lèvres</h2>
      <div class="grid two" style="gap: 16px;">
        
          <div class="card" style="padding: 20px; background: white; border-radius: 8px;">
            <h3 style="font-size: 16px; margin-bottom: 8px; color: var(--plum);">Quel est le minimum de commande pour les crayons ?</h3>
            <p style="margin: 0; font-size: 14px; color: var(--ink-soft); line-height: 1.5;">500 pièces par référence (SKU), identique à l'ensemble de nos catégories de maquillage labial.</p>
          </div>
          <div class="card" style="padding: 20px; background: white; border-radius: 8px;">
            <h3 style="font-size: 16px; margin-bottom: 8px; color: var(--plum);">Bois de cèdre ou mécanique : que privilégier ?</h3>
            <p style="margin: 0; font-size: 14px; color: var(--ink-soft); line-height: 1.5;">Le bois de cèdre offre un cachet prestigieux et traditionnel. Le format automatique twist-up apporte une praticité nomade sans taille-crayon.</p>
          </div>
          <div class="card" style="padding: 20px; background: white; border-radius: 8px;">
            <h3 style="font-size: 16px; margin-bottom: 8px; color: var(--plum);">Peut-on assembler des kits duo combinant crayon et gloss ?</h3>
            <p style="margin: 0; font-size: 14px; color: var(--ink-soft); line-height: 1.5;">Oui, nous réalisons régulièrement des sets et coffrets coordonnés (crayon contour + gloss ou encre à lèvres) avec étuis sur mesure.</p>
          </div>
      </div>
      <p style="margin-top: 24px; text-align: center;">
        <a href="/fr/faq" style="color: var(--burgundy); font-weight: 600; font-size: 14px;">Consulter toute la FAQ technique →</a>
      </p>
    </div>
  </section>

  <section style="padding: 50px 0;">
    <div class="wrap">
      <div class="card" style="text-align: center; padding: 40px 24px; background: linear-gradient(135deg, var(--plum-dark) 0%, var(--plum) 100%); color: white; border-radius: 12px;">
        <h2 style="margin-bottom: 10px; color: white;">Lancez votre collection de Crayon à Lèvres</h2>
        <p class="lead" style="max-width: 580px; margin: 0 auto 20px; color: #f3dde3; font-size: 16px;">
          Partagez avec nous votre orientation produit et vos volumes souhaités. Devis et analyse technique sous 24h.
        </p>
        <a class="btn" href="/fr/quote" style="background: var(--gold); color: var(--plum); font-weight: 600;">Demander un devis</a>
      </div>
    </div>
  </section>
</BaseLayout>
