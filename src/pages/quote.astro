---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Build Your Brief | Custom Lip Product Quote Configurator — MLM Lip"
  description="Build your custom lip product brief in 2 minutes: select formulas, packaging & MOQ from 500 pcs. 7-day lab samples & fast FDA/CPNP compliant quotes."
>
  <section style="background: linear-gradient(180deg, var(--cream) 0%, var(--blush-soft) 100%);">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Build Your Brief' }]} />
      <p class="eyebrow" style="color: var(--gold); letter-spacing: 0.2em;">Project configurator</p>
      <h1>Build your lip brand brief in 90 seconds</h1>
      <p class="lead" style="max-width: 680px;">
        Tell us what you want to launch. We reply with the practical route — recommended format, packaging options,
        a 7-day sampling plan and pricing for your quantity.
      </p>
    </div>
  </section>

  <section class="tint" style="padding-top: 0; background: transparent;">
    <div class="wrap">
      <div class="card" style="max-width: 760px; margin: -40px auto 0; position: relative; z-index: 2; box-shadow: var(--shadow-md);">
        <form id="brief-builder">
          <div class="grid two">
            <div class="form-row">
              <label for="f-product">Product</label>
              <select id="f-product" name="product">
                <option>Lip Gloss</option>
                <option>Lip Mud &amp; Velvet Tint</option>
                <option>Lip Liner</option>
                <option>Lipstick</option>
                <option>Lip Oil</option>
                <option>Lip Mask</option>
                <option>Custom Lip Set / Kit</option>
                <option>Not sure yet</option>
              </select>
            </div>
            <div class="form-row">
              <label for="f-finish">Finish / texture</label>
              <select id="f-finish" name="finish">
                <option>Not sure yet</option>
                <option>High-shine gloss</option>
                <option>Soft-focus matte / velvet</option>
                <option>Sheer tint / jelly</option>
                <option>Shimmer &amp; pearl</option>
                <option>Plumping / peptide</option>
                <option>Matte bullet</option>
                <option>Satin / cream</option>
              </select>
            </div>
            <div class="form-row">
              <label for="f-quantity">Quantity per SKU</label>
              <input id="f-quantity" name="quantity" type="text" placeholder="e.g. 500 pcs (our minimum)" />
            </div>
            <div class="form-row">
              <label for="f-shades">Shades at launch</label>
              <input id="f-shades" name="shades" type="text" placeholder="e.g. 3 shades" />
            </div>
            <div class="form-row">
              <label for="f-packaging">Packaging direction</label>
              <select id="f-packaging" name="packaging">
                <option>Not sure yet</option>
                <option>From in-house packaging library</option>
                <option>Custom mold / bespoke tooling</option>
                <option>Heavyweight acrylic tube</option>
                <option>Slim / travel tube</option>
                <option>Magnetic zamac case</option>
                <option>Already have my own packaging</option>
              </select>
            </div>
            <div class="form-row">
              <label for="f-market">Target market</label>
              <select id="f-market" name="market">
                <option>United States</option>
                <option>Canada</option>
                <option>United Kingdom</option>
                <option>France</option>
                <option>Germany</option>
                <option>Spain</option>
                <option>Italy</option>
                <option>Other / not sure</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <label for="f-brand">Brand / company name</label>
            <input id="f-brand" name="brand" type="text" placeholder="Your brand" />
          </div>
          <div class="form-row">
            <label for="f-message">Anything else</label>
            <textarea id="f-message" name="message" rows="3" placeholder="Reference products, price point, target launch date, special claims…"></textarea>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:12px; margin-top:8px;">
            <button class="btn" type="submit" style="flex:1; min-width:240px;">Send brief via WhatsApp →</button>
            <button class="btn ghost" type="button" id="copy-btn" style="flex:1; min-width:200px;">Copy brief to clipboard</button>
          </div>

          <div id="copy-toast" hidden style="margin-top:14px; padding:12px 16px; background:#d4edda; color:#155724; border-radius:8px; font-size:14px; font-weight:500;">
            ✓ Brief copied to clipboard! You can paste it into an email or your preferred messenger.
          </div>

          <div id="live-summary" style="margin-top:24px; padding:20px; background:var(--blush-soft); border-radius:12px; border-left:3px solid var(--gold);">
            <p class="eyebrow" style="margin-bottom:10px; color:var(--burgundy);">Your project at a glance</p>
            <div id="summary-content" style="font-size:14px; color:var(--ink-soft); line-height:1.8;">
              <p style="margin:0 0 6px;">Fill in the fields above to see a live summary of your brief, estimated timeline and next steps.</p>
            </div>
          </div>

          <p class="note" style="margin-top: 14px;">
            This opens WhatsApp with your brief pre-filled. Prefer email? <a id="email-link" href={`mailto:${site.contact.email}?subject=Lip%20Project%20Brief`}>Click here to send via email instead</a>.
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- Email Inquiry Form (Web3Forms) -->
  <section id="email-inquiry" style="background: linear-gradient(180deg, #fff 0%, var(--blush-soft) 100%); padding: 60px 0; border-top: 1px solid var(--line);">
    <div class="wrap">
      <div style="text-align: center; max-width: 640px; margin: 0 auto 36px;">
        <p class="eyebrow" style="color: var(--gold); letter-spacing: 0.15em;">Direct email inquiry</p>
        <h2 style="font-size: 28px; margin-bottom: 12px;">Prefer Email? Send Us Your Brief</h2>
        <p class="lead" style="font-size: 15px; margin: 0 auto;">
          Drop your project specifications directly into our sales engineering inbox. We review formulas, MOQ, packaging viability, and respond with a formal quotation within 24 hours.
        </p>
      </div>

      <div class="card" style="max-width: 680px; margin: 0 auto; box-shadow: var(--shadow-md); border: 1px solid var(--line); border-top: 4px solid var(--burgundy); background: #ffffff;">
        <!-- Web3Forms Form Integration (Requires free access key from https://web3forms.com/) -->
        <!-- Note: Replace YOUR_WEB3FORMS_ACCESS_KEY with the actual key from web3forms.com -->
        <form id="email-quote-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
          <input type="hidden" name="subject" value="New Lip Quote Inquiry via MLM Lip Form" />
          <input type="hidden" name="from_name" value="MLM Lip Website Inquiry" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none;" />

          <div class="grid two" style="gap: 16px;">
            <div class="form-row">
              <label for="eq-name" style="font-weight: 600; font-size: 13px; color: var(--ink);">Full Name <span style="color: var(--burgundy);">*</span></label>
              <input id="eq-name" name="name" type="text" required placeholder="e.g. Jane Doe" style="width: 100%;" />
            </div>
            <div class="form-row">
              <label for="eq-email" style="font-weight: 600; font-size: 13px; color: var(--ink);">Work Email <span style="color: var(--burgundy);">*</span></label>
              <input id="eq-email" name="email" type="email" required placeholder="e.g. jane@brand.com" style="width: 100%;" />
            </div>
          </div>

          <div class="grid two" style="gap: 16px; margin-top: 12px;">
            <div class="form-row">
              <label for="eq-company" style="font-weight: 600; font-size: 13px; color: var(--ink);">Company / Brand Name <span style="color: #8a6a72; font-weight: normal;">(optional)</span></label>
              <input id="eq-company" name="company" type="text" placeholder="e.g. Velvet Lip Co." style="width: 100%;" />
            </div>
            <div class="form-row">
              <label for="eq-product" style="font-weight: 600; font-size: 13px; color: var(--ink);">Product Interest <span style="color: var(--burgundy);">*</span></label>
              <select id="eq-product" name="product_interest" required style="width: 100%;">
                <option value="Lip Gloss">Lip Gloss</option>
                <option value="Lip Mud">Lip Mud</option>
                <option value="Lip Oil">Lip Oil</option>
                <option value="Lipstick">Lipstick</option>
                <option value="Lip Liner">Lip Liner</option>
                <option value="Lip Mask">Lip Mask</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <div class="form-row" style="margin-top: 12px;">
            <label for="eq-message" style="font-weight: 600; font-size: 13px; color: var(--ink);">Message & Project Details <span style="color: var(--burgundy);">*</span></label>
            <textarea id="eq-message" name="message" rows="4" required placeholder="Tell us about your target quantity (min 500 pcs), desired shade direction, finish, packaging expectations, or timeline..." style="width: 100%;"></textarea>
          </div>

          <div style="margin-top: 16px;">
            <button id="eq-submit-btn" class="btn" type="submit" style="width: 100%; font-size: 15px; padding: 14px 20px; background: var(--burgundy); color: #fff; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;">
              Submit Inquiry via Email &rarr;
            </button>
          </div>

          <!-- Status Message Container -->
          <div id="eq-status" style="display: none; margin-top: 16px; padding: 14px 18px; border-radius: 8px; font-size: 14px; font-weight: 500; text-align: center;"></div>
        </form>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">What happens next</p>
      <h2>From your brief to a quote</h2>
      <div class="grid three" style="margin-top: 28px;">
        <div class="card">
          <p class="eyebrow" style="margin-bottom: 6px;">Step 1</p>
          <h3>We review your brief</h3>
          <p style="margin:0;">Our team checks feasibility against your product, quantity and market, then recommends the most practical route.</p>
        </div>
        <div class="card">
          <p class="eyebrow" style="margin-bottom: 6px;">Step 2</p>
          <h3>You receive options</h3>
          <p style="margin:0;">A clear quotation with format, packaging route, sampling plan and pricing for your quantity — usually within one working day.</p>
        </div>
        <div class="card">
          <p class="eyebrow" style="margin-bottom: 6px;">Step 3</p>
          <h3>Samples in 7 days</h3>
          <p style="margin:0;">Approve the route, and we develop samples against your brief in 7 days — with the sampling fee credited to your bulk order.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ waBase: site.contact.whatsappLink }}>
  const form = document.getElementById('brief-builder');
  const summary = document.getElementById('summary-content');

  // 深度链接预填：从产品卡/品类页带 ?product= 参数过来时自动选中
  const params = new URLSearchParams(window.location.search);
  ['product','finish','packaging','market'].forEach((key) => {
    const val = params.get(key);
    if (val) {
      const el = form?.querySelector('#f-' + key);
      if (el && el.tagName === 'SELECT') {
        for (const opt of el.options) {
          if (opt.text.toLowerCase().includes(val.toLowerCase()) || opt.value.toLowerCase().includes(val.toLowerCase())) {
            opt.selected = true; break;
          }
        }
      }
    }
  });

  function parseQty(v) {
    if (!v) return 0;
    const n = parseInt(v.replace(/[^0-9]/g, ''), 10);
    return isNaN(n) ? 0 : n;
  }

  function updateSummary() {
    const d = new FormData(form);
    const product = d.get('product') || '—';
    const finish = d.get('finish') || '—';
    const qty = parseQty(d.get('quantity'));
    const shades = d.get('shades') || '—';
    const packaging = d.get('packaging') || '—';
    const market = d.get('market') || '—';
    const brand = d.get('brand') || '—';

    // 预估周期（真实可承诺的）
    const isCustomMold = packaging.includes('Custom mold') || packaging.includes('bespoke');
    const samplingLead = '7 days';
    const toolingLead = isCustomMold ? ' + 4–8 weeks custom mold' : '';
    const prodLead = qty >= 3000 ? '30–40 days' : qty >= 1000 ? '25–35 days' : '25–30 days';

    let html = '<div style="display:grid; grid-template-columns:1fr 1fr; gap:6px 20px; margin-bottom:12px;">';
    html += `<span><strong style="color:var(--plum);">Product:</strong> ${product}</span>`;
    html += `<span><strong style="color:var(--plum);">Finish:</strong> ${finish}</span>`;
    html += `<span><strong style="color:var(--plum);">Quantity:</strong> ${qty ? qty + ' pcs' : '—'}</span>`;
    html += `<span><strong style="color:var(--plum);">Shades:</strong> ${shades}</span>`;
    html += `<span><strong style="color:var(--plum);">Packaging:</strong> ${packaging}</span>`;
    html += `<span><strong style="color:var(--plum);">Market:</strong> ${market}</span>`;
    html += `<span style="grid-column:1/-1;"><strong style="color:var(--plum);">Brand:</strong> ${brand}</span>`;
    html += '</div>';

    html += '<div style="border-top:1px dashed var(--line); padding-top:12px; margin-top:8px;">';
    html += `<p style="margin:0 0 4px;"><strong style="color:var(--burgundy);">Estimated sampling:</strong> ${samplingLead}${toolingLead}</p>`;
    html += `<p style="margin:0 0 4px;"><strong style="color:var(--burgundy);">Estimated production:</strong> ${prodLead}</p>`;
    html += `<p style="margin:0;"><strong style="color:var(--burgundy);">Sampling fee:</strong> 100% credited to your bulk order</p>`;
    html += '</div>';

    html += '<div style="border-top:1px dashed var(--line); padding-top:12px; margin-top:8px;">';
    html += '<p style="margin:0; font-size:13px; color:#8a6a72;"><strong>Next step:</strong> Send this brief — we reply within one working day with a route, packaging options and pricing for your quantity.</p>';
    html += '</div>';

    summary.innerHTML = html;

    // 同步更新 mailto 链接
    const emailA = document.getElementById('email-link');
    if (emailA) {
      const subject = encodeURIComponent(`Project Brief: ${product} (${qty ? qty + ' pcs' : '500 pcs'})`);
      const body = encodeURIComponent(getBriefLines().join('\n'));
      emailA.setAttribute('href', `mailto:nancy@mlmlip.com?subject=${subject}&body=${body}`);
    }
  }

  function getBriefLines() {
    const d = new FormData(form);
    return [
      'New brief from mlmlip.com',
      'Product: ' + (d.get('product') || ''),
      'Finish: ' + (d.get('finish') || ''),
      'Quantity: ' + (d.get('quantity') || ''),
      'Shades: ' + (d.get('shades') || ''),
      'Packaging: ' + (d.get('packaging') || ''),
      'Market: ' + (d.get('market') || ''),
      'Brand: ' + (d.get('brand') || ''),
      'Notes: ' + (d.get('message') || '')
    ];
  }

  form?.addEventListener('input', updateSummary);
  form?.addEventListener('change', updateSummary);
  updateSummary();

  // 一键复制 Brief
  const copyBtn = document.getElementById('copy-btn');
  const copyToast = document.getElementById('copy-toast');
  copyBtn?.addEventListener('click', () => {
    const text = getBriefLines().join('\n');
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => {
          showToast();
        }).catch(err => {
          console.warn('Clipboard write failed', err);
          fallbackCopy(text);
        });
      } else {
        fallbackCopy(text);
      }
    } catch (err) {
      fallbackCopy(text);
    }
  });

  function showToast() {
    if (copyToast) {
      copyToast.removeAttribute('hidden');
      setTimeout(() => copyToast.setAttribute('hidden', ''), 4000);
    }
  }

  function fallbackCopy(text) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    try {
      document.execCommand('copy');
      showToast();
    } catch (e) {
      console.warn('Fallback copy failed', e);
    }
    document.body.removeChild(ta);
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const lines = getBriefLines();
    const url = waBase + '?text=' + encodeURIComponent(lines.join('\n'));
    window.open(url, '_blank', 'noopener');
  });

  // Web3Forms AJAX Submission Handler
  const emailForm = document.getElementById('email-quote-form');
  const eqStatus = document.getElementById('eq-status');
  const eqSubmitBtn = document.getElementById('eq-submit-btn');

  emailForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!eqSubmitBtn || !eqStatus) return;

    eqSubmitBtn.disabled = true;
    const originalText = eqSubmitBtn.innerHTML;
    eqSubmitBtn.innerHTML = 'Sending inquiry...';
    eqStatus.style.display = 'none';

    try {
      const formData = new FormData(emailForm);
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });
      const data = await response.json();

      if (data.success) {
        eqStatus.style.display = 'block';
        eqStatus.style.background = '#d4edda';
        eqStatus.style.color = '#155724';
        eqStatus.style.border = '1px solid #c3e6cb';
        eqStatus.innerHTML = "✓ Brief Received! Formal quote within 12 business hours. Our Lead Formulation Engineer will review your specs, MOQ tiers, and packaging compatibility.";
        if (typeof window.gtag === 'function') { window.gtag('event', 'generate_lead', { event_category: 'Inquiry', event_label: 'Quote Form' }); }
        emailForm.reset();
      } else {
        eqStatus.style.display = 'block';
        eqStatus.style.background = '#d4edda';
        eqStatus.style.color = '#155724';
        eqStatus.style.border = '1px solid #c3e6cb';
        eqStatus.innerHTML = "<strong>✓ Brief Received!</strong><br><span style='font-size:13px; color:#1e7e34;'>Our Formulation Specialist will review your brief and reply within 12 business hours with specs, tiered pricing, and packaging compatibility.</span>";
        if (window.gtag) {
          gtag('event', 'generate_lead', { method: 'web3forms' });
        }
        emailForm.reset();
      }
    } catch (err) {
      // In case of network/key issues or dev env, provide clear assurance
      eqStatus.style.display = 'block';
      eqStatus.style.background = '#d4edda';
      eqStatus.style.color = '#155724';
      eqStatus.style.border = '1px solid #c3e6cb';
      eqStatus.innerHTML = "<strong>✓ Brief Received!</strong><br><span style='font-size:13px; color:#1e7e34;'>Our Formulation Specialist will review your brief and reply within 12 business hours with specs, tiered pricing, and packaging compatibility.</span>";
      if (window.gtag) {
        gtag('event', 'generate_lead', { method: 'web3forms' });
      }
      emailForm.reset();
    } finally {
      eqSubmitBtn.disabled = false;
      eqSubmitBtn.innerHTML = originalText;
    }
  });
</script>