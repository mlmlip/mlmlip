---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="About | Custom Lip Cosmetics Manufacturer — MLM Lip"
  description="Private label lip manufacturer Beautychain Limited: ISO 22716 & GMPC certified, EU CPNP ready. 500 pcs MOQ, 7-day lab sampling, 15-day bulk delivery."
>
  <section>
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
      <p class="eyebrow">About</p>
      <h1>The factory behind your lip brand</h1>
      <p class="lead" style="max-width:660px">
        MLM Lip is the lip cosmetics line of {site.manufacturer}, based in Shenzhen, China.
        We work with private label brand owners in North America and Europe — online sellers,
        offline retailers and founders alike — who want their own product, made their way.
      </p>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">Why brands pick us</p>
      <h2>What a lip specialist gives you that a generalist factory cannot</h2>
      <div class="grid two" style="margin-top:28px">
        <div class="card">
          <h3 style="font-size:19px;">One roof, not three vendors</h3>
          <p style="margin:0;">Most private label projects fall apart at the seams: the formula lab, the tube supplier and the decorator are separate companies, and nobody owns the mismatch. We run formulation, filling, assembly and decoration under one GMPC-certified roof — the sample you approve is the product you receive.</p>
        </div>
        <div class="card">
          <h3 style="font-size:19px;">500 pcs is a principle, not a promo</h3>
          <p style="margin:0;">A 20,000 pcs minimum is not a business decision a new brand can make. We engineered our production line to run profitably at {site.moq} so your first run can be tested in the real market before you scale — not committed before a customer touches it.</p>
        </div>
        <div class="card">
          <h3 style="font-size:19px;">Lip is all we do</h3>
          <p style="margin:0;">A factory that makes everything makes nothing well. We concentrate strictly on the six lip formats — gloss, mud, liner, lipstick, peptide oil and barrier mask — which means a deeper formulation library, faster shade matching, and packaging components purpose-engineered for lip cosmetics. We do not compromise with distracted product lines; lip perfection is our single craft.</p>
        </div>
        <div class="card">
          <h3 style="font-size:19px;">Compliance, not paperwork panic</h3>
          <p style="margin:0;">Your first container held at customs over a missing CPSR is a founder's nightmare. Because we operate GMPC and ISO 22716 as standard, the technical dossier your safety assessor and customs broker need is produced as a matter of routine — not scrambled together when the ship has already sailed.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Factory capabilities</p>
      <h2>What our floor can do</h2>
      <div class="grid three" style="margin-top:28px">
        <div class="card gold-line">
          <h3 style="font-size:18px;">Formulation</h3>
          <ul style="margin:0; padding-left:18px; color:var(--ink-soft); line-height:1.8; font-size:14px;">
            <li>Custom shade development & Pantone matching</li>
            <li>Texture tuning (gloss, mud, oil, balm)</li>
            <li>Active-infused formulas (peptides, ceramides)</li>
            <li>Flavor & fragrance systems</li>
            <li>Stability & challenge testing in-house</li>
          </ul>
        </div>
        <div class="card gold-line">
          <h3 style="font-size:18px;">Packaging & tooling</h3>
          <ul style="margin:0; padding-left:18px; color:var(--ink-soft); line-height:1.8; font-size:14px;">
            <li>200+ library components (tubes, caps, applicators)</li>
            <li>Custom mold opening for exclusive silhouettes</li>
            <li>Silk-screen, hot-stamp, UV digital print</li>
            <li>Gradient spray & metallic finishes</li>
            <li>Carton & secondary packaging design</li>
          </ul>
        </div>
        <div class="card gold-line">
          <h3 style="font-size:18px;">Production & QC</h3>
          <ul style="margin:0; padding-left:18px; color:var(--ink-soft); line-height:1.8; font-size:14px;">
            <li>GMPC & ISO 22716 certified cleanroom</li>
            <li>Automated high-speed filling & capping</li>
            <li>Batch-to-batch colorimetric control</li>
            <li>Pre-shipment QC with photo reports</li>
            <li>EU CPNP notification & FDA-ready documentation</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Inside the factory</p>
      <h2>See the floor where your products are made</h2>
      <div class="grid two" style="margin-top:24px">
        <div>
          <div class="case-media video-embed">
            <video
              src="/factory/factory-production.mp4"
              poster="/factory/factory-production-poster.jpg"
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
              controls
            ></video>
          </div>
          <h3 style="margin-top:12px; font-size:18px">Automated Production Line</h3>
          <p class="note" style="margin:0">High-speed precision filling and capping line.</p>
        </div>
        <div>
          <div class="case-media video-embed">
            <video
              src="/factory/factory-cleanroom.mp4"
              poster="/factory/factory-cleanroom-poster.jpg"
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
              controls
            ></video>
          </div>
          <h3 style="margin-top:12px; font-size:18px">GMPC Cleanroom Operation</h3>
          <p class="note" style="margin:0">Sterile cosmetic manufacturing environment.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Work with us</h2>
      <p class="lead" style="max-width:600px">
        Whether you have a finished concept or just the beginning of an idea, the first step is the same:
        tell us what you want to launch.
      </p>
      <a class="btn" href="/contact">Contact our team</a>
    </div>
  </section>

  <!-- World-Class Compliance Vault (Added per JEV decision) -->
  <section id="compliance" style="padding:60px 0; background:var(--blush-soft); border-top:1px solid var(--line);">
    <div class="wrap">
      <p class="eyebrow">AUDIT-PROOF INSTITUTIONAL RIGOR</p>
      <h2>Global Regulatory Compliance & Audit Dossier Vault</h2>
      <p class="lead" style="max-width:720px; margin-bottom:32px;">
        Tier-1 Western retailers and platforms (Amazon US/EU, Sephora, Ulta) do not tolerate compliance friction. We maintain active, verified regulatory dossiers with recognized global testing laboratories. Inspect and download certified technical files below:
      </p>

      <div class="grid three" style="gap:24px;">
        <div class="card" style="background:#fff; border-radius:10px; padding:24px; border:1px solid var(--line); display:flex; flex-direction:column;">
          <div style="font-size:24px; margin-bottom:12px;">🇪🇺</div>
          <h3 style="font-size:17px; margin:0 0 8px 0; color:var(--plum-dark);">EU CPNP Notification Dossier</h3>
          <p style="font-size:13px; color:var(--ink-soft); line-height:1.5; margin-bottom:16px;">
            Full European Cosmetic Product Notification Portal (CPNP) entry verified under Article 13 of Regulation (EC) No 1223/2009.
          </p>
          <div style="margin-top:auto; font-size:12px; color:var(--rose-dark); font-weight:600;">
            <a href="#compliance-gate" data-pdf="/certificates/eu-cpnp-notification-dossier.pdf" data-doc="EU CPNP Notification Dossier" class="gated-download-trigger" style="color:var(--rose-dark); text-decoration:none;">Inspect CPNP Filing (PDF) &rarr;</a>
          </div>
        </div>

        <div class="card" style="background:#fff; border-radius:10px; padding:24px; border:1px solid var(--line); display:flex; flex-direction:column;">
          <div style="font-size:24px; margin-bottom:12px;">🛡️</div>
          <h3 style="font-size:17px; margin:0 0 8px 0; color:var(--plum-dark);">EU CPSR Cosmetic Safety Assessment</h3>
          <p style="font-size:13px; color:var(--ink-soft); line-height:1.5; margin-bottom:16px;">
            Certified Cosmetic Product Safety Report (Part A & Part B) conducted by accredited European safety assessors.
          </p>
          <div style="margin-top:auto; font-size:12px; color:var(--rose-dark); font-weight:600;">
            <a href="#compliance-gate" data-pdf="/certificates/eu-cpsr-cosmetic-safety-report.pdf" data-doc="EU CPSR Cosmetic Safety Assessment" class="gated-download-trigger" style="color:var(--rose-dark); text-decoration:none;">View CPSR Report (PDF) &rarr;</a>
          </div>
        </div>

        <div class="card" style="background:#fff; border-radius:10px; padding:24px; border:1px solid var(--line); display:flex; flex-direction:column;">
          <div style="font-size:24px; margin-bottom:12px;">🔬</div>
          <h3 style="font-size:17px; margin:0 0 8px 0; color:var(--plum-dark);">EU CPSA Heavy Metal & Toxicological Audit</h3>
          <p style="font-size:13px; color:var(--ink-soft); line-height:1.5; margin-bottom:16px;">
            ICP-OES heavy metals analysis (Lead, Arsenic, Mercury, Antimony) and preservative efficacy testing passing strict EU standards.
          </p>
          <div style="margin-top:auto; font-size:12px; color:var(--rose-dark); font-weight:600;">
            <a href="#compliance-gate" data-pdf="/certificates/eu-cpsa-compliance-audit.pdf" data-doc="EU CPSA Heavy Metal & Toxicological Audit" class="gated-download-trigger" style="color:var(--rose-dark); text-decoration:none;">Download CPSA Audit (PDF) &rarr;</a>
          </div>
        </div>

        <div class="card" style="background:#fff; border-radius:10px; padding:24px; border:1px solid var(--line); display:flex; flex-direction:column;">
          <div style="font-size:24px; margin-bottom:12px;">🇺🇸</div>
          <h3 style="font-size:17px; margin:0 0 8px 0; color:var(--plum-dark);">FDA / USP 51 Antimicrobial Efficacy</h3>
          <p style="font-size:13px; color:var(--ink-soft); line-height:1.5; margin-bottom:16px;">
            United States Pharmacopeia Category 2 antimicrobial challenge audit confirming formula sterility and stability across 28 days.
          </p>
          <div style="margin-top:auto; font-size:12px; color:var(--rose-dark); font-weight:600;">
            <a href="#compliance-gate" data-pdf="/certificates/fda-usp-51-antimicrobial-test.pdf" data-doc="FDA / USP 51 Antimicrobial Efficacy" class="gated-download-trigger" style="color:var(--rose-dark); text-decoration:none;">Download USP 51 Certificate (PDF) &rarr;</a>
          </div>
        </div>

        <div class="card" style="background:#fff; border-radius:10px; padding:24px; border:1px solid var(--line); display:flex; flex-direction:column;">
          <div style="font-size:24px; margin-bottom:12px;">🧪</div>
          <h3 style="font-size:17px; margin:0 0 8px 0; color:var(--plum-dark);">FDA / USP 61 & 62 Microbial Limit Testing</h3>
          <p style="font-size:13px; color:var(--ink-soft); line-height:1.5; margin-bottom:16px;">
            Exhaustive screening for pathogenic microorganisms (Staph, E. coli, Salmonella, Pseudomonas) ensuring 100% clean safety thresholds.
          </p>
          <div style="margin-top:auto; font-size:12px; color:var(--rose-dark); font-weight:600;">
            <a href="#compliance-gate" data-pdf="/certificates/fda-usp-61-62-microbiology-test.pdf" data-doc="FDA / USP 61 & 62 Microbial Limit Testing" class="gated-download-trigger" style="color:var(--rose-dark); text-decoration:none;">Download USP 61/62 Report (PDF) &rarr;</a>
          </div>
        </div>

        <div class="card" style="background:#fff; border-radius:10px; padding:24px; border:1px solid var(--line); display:flex; flex-direction:column;">
          <div style="font-size:24px; margin-bottom:12px;">🌿</div>
          <h3 style="font-size:17px; margin:0 0 8px 0; color:var(--plum-dark);">Clean Raw Material & Pigment MSDS</h3>
          <p style="font-size:13px; color:var(--ink-soft); line-height:1.5; margin-bottom:16px;">
            Material Safety Data Sheets for high-purity natural cellulose, mica, and organic colorants compliant with global Clean Beauty bans.
          </p>
          <div style="margin-top:auto; font-size:12px; color:var(--rose-dark); font-weight:600;">
            <a href="#compliance-gate" data-pdf="/certificates/clean-raw-material-msds-report.pdf" data-doc="Clean Raw Material & Pigment MSDS" class="gated-download-trigger" style="color:var(--rose-dark); text-decoration:none;">Download MSDS Technical Sheet (PDF) &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Gated Compliance Download Modal -->
  <div id="gated-modal" hidden style="position: fixed; inset: 0; background: rgba(42, 12, 24, 0.72); z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 20px;">
    <div class="card" style="max-width: 460px; width: 100%; background: #fff; border-radius: 12px; padding: 28px; position: relative; border-top: 4px solid var(--burgundy); box-shadow: 0 20px 50px rgba(0,0,0,0.3);">
      <button id="gated-close" type="button" aria-label="Close modal" style="position: absolute; top: 14px; right: 16px; background: none; border: none; font-size: 22px; color: var(--ink-soft); cursor: pointer;">&times;</button>
      <p class="eyebrow" style="color: var(--gold); margin-bottom: 6px; font-size: 11px;">Compliance Vault Access</p>
      <h3 id="gated-title" style="font-size: 20px; margin: 0 0 8px 0; color: var(--plum-dark);">Unlock Technical Dossier</h3>
      <p style="font-size: 13px; color: var(--ink-soft); margin-bottom: 18px; line-height: 1.5;">
        Enter your name and verified corporate email to unlock instant PDF access to <strong id="gated-doc-name" style="color: var(--burgundy);">this compliance file</strong>, while our regulatory team dispatches the full unredacted laboratory report &amp; tiered MOQ quotation sheet to your inbox.
      </p>

      <!-- Web3Forms Integration (Replace YOUR_WEB3FORMS_ACCESS_KEY with actual key from https://web3forms.com/) -->
      <form id="gated-download-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
        <input type="hidden" name="subject" value="Compliance Dossier Download Lead — MLM Lip" />
        <input type="hidden" id="gated-requested-doc" name="requested_document" value="" />

        <div class="form-row" style="margin-bottom: 12px;">
          <label for="gd-name" style="font-weight: 600; font-size: 13px; color: var(--ink);">Full Name <span style="color: var(--burgundy);">*</span></label>
          <input id="gd-name" name="name" type="text" required placeholder="Your full name" style="width: 100%;" />
        </div>
        <div class="form-row" style="margin-bottom: 16px;">
          <label for="gd-email" style="font-weight: 600; font-size: 13px; color: var(--ink);">Work Email <span style="color: var(--burgundy);">*</span></label>
          <input id="gd-email" name="email" type="email" required placeholder="you@brand.com" style="width: 100%;" />
        </div>

        <button id="gd-submit-btn" class="btn" type="submit" style="width: 100%; background: var(--burgundy); color: #fff; border: none; padding: 12px 18px; border-radius: 8px; font-weight: 600; cursor: pointer;">
          Unlock &amp; Show Download Link &rarr;
        </button>
      </form>

      <div id="gated-result" hidden style="margin-top: 18px; padding: 16px; background: var(--blush-soft); border: 1px solid var(--gold); border-radius: 8px; text-align: center;">
        <p style="margin: 0 0 12px; font-size: 13px; color: var(--ink); font-weight: 700; line-height: 1.5;">✓ Download starting. Direct dossier access link and full private label pricing schedule have also been dispatched to your work email.</p>
        <a id="gated-direct-link" href="#" target="_blank" rel="noopener" class="btn" style="display: inline-block; background: var(--gold); color: var(--plum-dark); font-weight: 700; padding: 10px 18px; border-radius: 6px; text-decoration: none;">
          Download PDF Now &darr;
        </a>
      </div>
    </div>
  </div>

  <style>
    #gated-modal[hidden] {
      display: none !important;
    }
  </style>

  <script is:inline>
    (function() {
      const modal = document.getElementById('gated-modal');
      const closeBtn = document.getElementById('gated-close');
      const docNameEl = document.getElementById('gated-doc-name');
      const requestedInput = document.getElementById('gated-requested-doc');
      const form = document.getElementById('gated-download-form');
      const resultBox = document.getElementById('gated-result');
      const directLink = document.getElementById('gated-direct-link');
      const submitBtn = document.getElementById('gd-submit-btn');

      let currentPdfUrl = '';

      document.querySelectorAll('.gated-download-trigger').forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          currentPdfUrl = link.getAttribute('data-pdf') || '#';
          const docTitle = link.getAttribute('data-doc') || 'Compliance Document';
          if (docNameEl) docNameEl.textContent = docTitle;
          if (requestedInput) requestedInput.value = docTitle;
          if (directLink) directLink.setAttribute('href', currentPdfUrl);

          if (resultBox) resultBox.setAttribute('hidden', '');
          if (form) form.style.display = 'block';
          modal?.removeAttribute('hidden');
        });
      });

      closeBtn?.addEventListener('click', () => {
        modal?.setAttribute('hidden', '');
      });

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) modal.setAttribute('hidden', '');
      });

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Unlocking...';
        }
        try {
          const formData = new FormData(form);
          await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: formData
          });
        } catch (err) {
          // Proceed to reveal download link even if offline or placeholder key
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = 'Unlock &amp; Show Download Link &rarr;';
          }
          if (typeof window.gtag === 'function') { window.gtag('event', 'generate_lead', { event_category: 'Lead Magnet', event_label: 'Compliance Dossier' }); }
          form.style.display = 'none';
          resultBox?.removeAttribute('hidden');
        }
      });
    })();
  </script>
</BaseLayout>
