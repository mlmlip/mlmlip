---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LipConfigurator from '../components/LipConfigurator.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Build Your Brief | Interactive Custom Lip Cosmetics Configurator — MLM Lip"
  description="Configure custom lip cosmetics in 90 seconds. Select formulations, active complexes, packaging & target markets. Universal 500 pcs MOQ, 7-day lab prototyping, GMPC & CPNP/FDA ready."
>
  <section style="background: linear-gradient(180deg, var(--cream) 0%, var(--blush-soft) 100%); padding-bottom: 40px;">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Interactive Brief Configurator' }]} />
      <p class="eyebrow" style="color: var(--gold); letter-spacing: 0.2em;">Direct-to-Lab Engineering Desk</p>
      <h1>Configure Your Custom Lip Line in 90 Seconds</h1>
      <p class="lead" style="max-width: 740px;">
        Skip vague RFQs. Customize your category, rheology, active ingredients, target market regulations, and luxury packaging. Receive direct formulation guidance, real-time pricing indicators, and lock in a 7-day lab sample slot.
      </p>
    </div>
  </section>

  <!-- P0-2: Interactive Multi-Step Dialog Configurator -->
  <section style="padding-top: 0; padding-bottom: 60px; background: transparent;">
    <div class="wrap">
      <LipConfigurator />
    </div>
  </section>

  <!-- Secondary Fast Route: Direct Email Inquiry Form -->
  <section id="email-inquiry" style="background: linear-gradient(180deg, #fff 0%, var(--blush-soft) 100%); padding: 60px 0; border-top: 1px solid var(--line);">
    <div class="wrap">
      <div style="text-align: center; max-width: 640px; margin: 0 auto 36px;">
        <p class="eyebrow" style="color: var(--gold); letter-spacing: 0.15em;">Direct email inquiry</p>
        <h2 style="font-size: 28px; margin-bottom: 12px;">Prefer Standard Email? Drop Your Requirements</h2>
        <p class="lead" style="font-size: 15px; margin: 0 auto;">
          Drop your project specifications directly into our sales engineering inbox. We review formulas, MOQ, packaging viability, and respond with a formal quotation within 24 hours.
        </p>
      </div>

      <div class="card" style="max-width: 680px; margin: 0 auto; box-shadow: var(--shadow-md); border: 1px solid var(--line); border-top: 4px solid var(--burgundy); background: #ffffff;">
        <form id="email-quote-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="b0681fa9-0cc8-4fd9-80f7-4d5faa39b2e7" />
          <input type="hidden" name="subject" value="New Lip Quote Inquiry via MLM Lip Form" />
          <input type="hidden" name="from_name" value="MLM Lip Website Inquiry" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none;" />

          <div class="grid two" style="gap: 16px;">
            <div class="form-row">
              <label for="eq-name" style="font-weight: 600; font-size: 13px; color: var(--ink);">Full Name <span style="color: var(--burgundy);">*</span></label>
              <input id="eq-name" name="name" type="text" required placeholder="e.g. Jane Doe" style="width: 100%;" />
            </div>
            <div class="form-row">
              <label for="eq-email" style="font-weight: 600; font-size: 13px; color: var(--ink);">Work Email <span style="color: var(--burgundy);">*</span></label>
              <input id="eq-email" name="email" type="email" required placeholder="e.g. jane@brand.com" style="width: 100%;" />
            </div>
          </div>

          <div class="grid two" style="gap: 16px; margin-top: 12px;">
            <div class="form-row">
              <label for="eq-company" style="font-weight: 600; font-size: 13px; color: var(--ink);">Company / Brand Name <span style="color: #8a6a72; font-weight: normal;">(optional)</span></label>
              <input id="eq-company" name="company" type="text" placeholder="e.g. Velvet Lip Co." style="width: 100%;" />
            </div>
            <div class="form-row">
              <label for="eq-product" style="font-weight: 600; font-size: 13px; color: var(--ink);">Product Interest <span style="color: var(--burgundy);">*</span></label>
              <select id="eq-product" name="product_interest" required style="width: 100%;">
                <option value="Lip Gloss">Lip Gloss</option>
                <option value="Lip Mud">Lip Mud &amp; Velvet Tint</option>
                <option value="Lip Oil">Peptide Lip Oil</option>
                <option value="Lipstick">Bullet Lipstick</option>
                <option value="Lip Liner">Lip Liner</option>
                <option value="Lip Mask">Overnight Lip Mask</option>
                <option value="Other">Custom Lip Kit / Collection</option>
              </select>
            </div>
          </div>

          <div class="form-row" style="margin-top: 12px;">
            <label for="eq-message" style="font-weight: 600; font-size: 13px; color: var(--ink);">Message &amp; Project Details <span style="color: var(--burgundy);">*</span></label>
            <textarea id="eq-message" name="message" rows="4" required placeholder="Tell us about your target quantity (min 500 pcs), desired shade direction, finish, packaging expectations, or timeline..." style="width: 100%;"></textarea>
          </div>

<!-- NDA Confidentiality Badge -->
<div style="display: flex; align-items: center; gap: 8px; margin-top: 12px; margin-bottom: 16px; padding: 12px 16px; background: var(--cream); border: 1px solid var(--line); border-radius: 8px;">
  <span style="font-size: 20px;">🔒</span>
  <div>
    <p style="margin: 0; font-size: 13px; font-weight: 600; color: var(--plum);">100% Formulation Confidentiality</p>
    <p style="margin: 0; font-size: 12px; color: var(--ink-soft);">Mutual NDA available upon request. Your formulas and brand concepts are never shared.</p>
  </div>
</div>
          <div style="margin-top: 16px;">
            <button id="eq-submit-btn" class="btn" type="submit" style="width: 100%; font-size: 15px; padding: 14px 20px; background: var(--burgundy); color: #fff; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;">
              Get Custom Formula &amp; Sample Box &rarr;
            </button>
          </div>

          <div id="eq-status" style="display: none; margin-top: 16px; padding: 14px 18px; border-radius: 8px; font-size: 14px; font-weight: 500; text-align: center;"></div>
        </form>
<!-- Trust Badges -->
<div style="display: flex; gap: 24px; justify-content: center; margin-top: 24px; flex-wrap: wrap;">
  <span style="font-size: 12px; color: var(--ink-soft);">✓ ISO 22716 Certified</span>
  <span style="font-size: 12px; color: var(--ink-soft);">✓ FDA Registered Facility</span>
  <span style="font-size: 12px; color: var(--ink-soft);">✓ 7-Day Sample Dispatch</span>
  <span style="font-size: 12px; color: var(--ink-soft);">✓ 500 pcs Universal MOQ</span>
</div>
      </div>
    </div>
  </section>

  <!-- Process SLA Review -->
  <section style="padding: 70px 0;">
    <div class="wrap">
      <p class="eyebrow" style="color: var(--gold);">Seamless Engineering SLA</p>
      <h2>From Custom Configuration to Production Batch</h2>
      <div class="grid three" style="margin-top: 28px;">
        <div class="card" style="border: 1px solid var(--line); border-radius: 12px; padding: 24px;">
          <p class="eyebrow" style="margin-bottom: 6px; color: var(--rose);">Step 1 · 24-Hr Feasibility Review</p>
          <h3>Chemist Analysis</h3>
          <p style="margin:0; font-size:14px; color:var(--ink-soft);">Our chief cosmetic chemists analyze viscosity requirements, active stability, and market regulatory restrictions.</p>
        </div>
        <div class="card" style="border: 1px solid var(--line); border-radius: 12px; padding: 24px;">
          <p class="eyebrow" style="margin-bottom: 6px; color: var(--rose);">Step 2 · 7-Day Lab Prototype</p>
          <h3>Physical Benchmarking</h3>
          <p style="margin:0; font-size:14px; color:var(--ink-soft);">Custom lab sample formulated, shade matched (ΔE &lt; 0.8), filled into components, and priority dispatched. 100% credited to bulk order.</p>
        </div>
        <div class="card" style="border: 1px solid var(--line); border-radius: 12px; padding: 24px;">
          <p class="eyebrow" style="margin-bottom: 6px; color: var(--rose);">Step 3 · Cleanroom Production</p>
          <h3>18–25 Days to Dispatch</h3>
          <p style="margin:0; font-size:14px; color:var(--ink-soft);">Mass production in our ISO 22716 cleanroom facility with full EU CPNP / FDA safety dossiers and vacuum leakage testing.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Simple Email Form Interceptor for UX feedback
  const eqForm = document.getElementById('email-quote-form');
  const eqStatus = document.getElementById('eq-status');
  const eqBtn = document.getElementById('eq-submit-btn');

  eqForm?.addEventListener('submit', async function(e) {
    e.preventDefault();
    if (eqBtn) {
      eqBtn.disabled = true;
      eqBtn.textContent = 'Transmitting to Sales Team...';
    }

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(eqForm)
      });
      const data = await response.json();

      if (response.ok && data.success) {
        if (eqStatus) {
          eqStatus.style.display = 'block';
          eqStatus.style.background = '#d4edda';
          eqStatus.style.color = '#155724';
          eqStatus.innerHTML = '✓ <strong>Thank you!</strong> Your quote request has been transmitted. Our technical sales team will reply within 24 hours.';
        }
        eqForm.reset();
        if (eqBtn) eqBtn.textContent = '✓ Inquiry Received';
      } else {
        throw new Error(data.message || 'Error occurred');
      }
    } catch (err) {
      if (eqStatus) {
        eqStatus.style.display = 'block';
        eqStatus.style.background = '#f8d7da';
        eqStatus.style.color = '#721c24';
        eqStatus.innerHTML = 'Something went wrong. Please chat with us on WhatsApp or email <a href="mailto:nancy@mlmlip.com">nancy@mlmlip.com</a>.';
      }
      if (eqBtn) {
        eqBtn.disabled = false;
        eqBtn.textContent = 'Retry Submission';
      }
    }
  });
</script>
