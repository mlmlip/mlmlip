---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, certifications } from '../../data/site';

const esCategories = [
  { label: 'Brillo Labial (Lip Gloss)', href: '/lip-gloss-manufacturer', blurb: 'Fórmulas de alto brillo, tintes translúcidos o destellos. Envases y aplicadores a medida.' },
  { label: 'Tinta & Mousse Aterciopelado (Lip Mud)', href: '/lip-mud-manufacturer', blurb: 'Acabado mate aterciopelado de textura ligera, sin transferencia y de larga duración.' },
  { label: 'Perfilador de Labios (Lip Liner)', href: '/lip-liner-manufacturer', blurb: 'Trazado ultra suave en lápiz de madera de cedro o formato mecánico retráctil.' },
  { label: 'Barra de Labios Clásica (Lipstick)', href: '/lipstick-manufacturer', blurb: 'Acabados satinados o mate en elegantes estuches magnéticos de zamak o aluminio.' },
  { label: 'Aceite de Tratamiento (Lip Oil)', href: '/lip-oil-manufacturer', blurb: 'Cuidado híbrido con péptidos y escualano botánico con aplicadores cerámicos fríos.' },
  { label: 'Mascarilla Reparadora Labial', href: '/lip-mask-manufacturer', blurb: 'Bálsamos reparadores intensivos nocturnos con ceramidas en tarro o tubo flexible.' }
];

const esFaqs = [
  { q: '¿Cuál es la cantidad mínima de pedido (MOQ)?', a: '500 unidades por SKU — la misma cantidad mínima en las seis categorías de productos labiales.' },
  { q: '¿En cuánto tiempo están listas las muestras?', a: 'Muestras personalizadas listas en 7 días laborables. El 100% del coste de las muestras se descuenta de tu pedido final.' },
  { q: '¿Cumplen con la normativa para exportar a Europa y EE. UU.?', a: 'Sí. Fabricación en salas limpias certificadas GMPC e ISO 22716, con soporte completo para la notificación europea CPNP y FDA.' },
  { q: '¿Ofrecen moldes personalizados de envases?', a: 'Sí. Además de nuestro catálogo de componentes en stock, desarrollamos moldes exclusivos para tu marca.' }
];
---

<BaseLayout
  title="Fabricante de Cosméticos Labiales Marca Blanca | MOQ 500 uds — MLM Lip"
  description="Fabricante OEM/ODM de cosméticos labiales desde 500 piezas. Muestras de laboratorio en 7 días, certificación ISO 22716 y CPNP. Solicite presupuesto hoy."
>
  <section style="position: relative; background: var(--plum-dark); overflow: hidden;">
    <img src="/products/nas-sync-39-1.jpg" alt="Línea de producción de cosméticos MLM Lip" width="1200" height="600" fetchpriority="high" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.48;" />
    <div style="position: absolute; inset: 0; background: linear-gradient(120deg, rgba(47,12,23,0.92) 0%, rgba(74,21,37,0.78) 60%, rgba(110,26,50,0.55) 100%);"></div>
    <div class="wrap" style="position: relative; padding-top: 104px; padding-bottom: 104px;">
      <p class="eyebrow" style="letter-spacing: 0.2em; font-weight: 600; color: var(--gold);">Cosméticos Labiales · Especialistas OEM &amp; ODM</p>
      <h1 style="font-size: clamp(36px, 4.8vw, 58px); line-height: 1.15; max-width: 920px; margin-bottom: 24px; color: #fff;">
        Impulsa Tu Próxima Línea de Labios Viral.<br />
        <span style="color: var(--gold); font-style: italic;">Desde 500 Unidades, Solución Integral.</span>
      </h1>
      <p class="lead" style="max-width: 740px; font-size: 19px; line-height: 1.65; margin-bottom: 36px; color: #f3dde3;">
        Fabricamos cosméticos de alta gama para marcas emergentes y creadores en España, Europa y Norteamérica. Fórmulas a medida, catálogo de packaging premium y moldes exclusivos bajo estándares de sala limpia GMPC e ISO 22716.
      </p>
      <div>
        <a class="btn" href="/quote" style="padding: 16px 36px; font-size: 16px; font-weight: 600;">Diseña tu propuesta online</a>
        <a class="btn ghost" href="/cases" style="margin-left: 14px; padding: 16px 32px; font-size: 16px; color: var(--gold-light); border-color: var(--gold);">Ver fábrica &amp; proyectos</a>
      </div>
      <p class="note" style="margin-top: 24px; font-size: 14px; color: var(--gold-light);">
        ✓ MOQ universal de 500 uds &nbsp;·&nbsp; ✓ Muestras formuladas en 7 días &nbsp;·&nbsp; ✓ 100% reembolsable en tu pedido
      </p>
    </div>
  </section>

  <section style="padding: 0;">
    <div class="wrap">
      <div class="card" style="margin-top: -32px; position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: 18px 34px; justify-content: center; padding: 20px 28px; box-shadow: var(--shadow-md);">
        {['Certificado GMPC', 'Norma ISO 22716', 'Soporte Dossier CPNP UE', 'Documentación FDA', 'MOQ 500 uds', 'Muestras en 7 días'].map((t) => (
          <span style="font-size: 14px; color: var(--plum); font-weight: 600; letter-spacing: 0.02em;">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Global Delivery Milestone Counter Bar (ES) -->
  <section style="padding: 44px 0 36px; background: #fdfaf9; border-bottom: 1px solid var(--line);">
    <div class="wrap">
      <div class="grid four" style="margin-top: 8px; gap: 20px;">
        <div style="text-align: center; padding: 18px 14px; background: #fff; border-radius: 10px; border: 1px solid var(--line); border-top: 3px solid #c5a059; box-shadow: var(--shadow-sm);">
          <p style="font-family: 'Playfair Display', serif; font-size: 38px; font-weight: 700; color: #4a1525; margin: 0; line-height: 1.1;">1,200+</p>
          <p class="note" style="margin: 8px 0 0; font-weight: 600; color: var(--ink);">Fórmulas Personalizadas Probadas</p>
        </div>
        <div style="text-align: center; padding: 18px 14px; background: #fff; border-radius: 10px; border: 1px solid var(--line); border-top: 3px solid #c5a059; box-shadow: var(--shadow-sm);">
          <p style="font-family: 'Playfair Display', serif; font-size: 38px; font-weight: 700; color: #4a1525; margin: 0; line-height: 1.1;">40+</p>
          <p class="note" style="margin: 8px 0 0; font-weight: 600; color: var(--ink);">Cumplimientos Normativos (FDA / UE / ASEAN)</p>
        </div>
        <div style="text-align: center; padding: 18px 14px; background: #fff; border-radius: 10px; border: 1px solid var(--line); border-top: 3px solid #c5a059; box-shadow: var(--shadow-sm);">
          <p style="font-family: 'Playfair Display', serif; font-size: 38px; font-weight: 700; color: #4a1525; margin: 0; line-height: 1.1;">15M+</p>
          <p class="note" style="margin: 8px 0 0; font-weight: 600; color: var(--ink);">Capacidad Anual de Llenado y Envasado</p>
        </div>
        <div style="text-align: center; padding: 18px 14px; background: #fff; border-radius: 10px; border: 1px solid var(--line); border-top: 3px solid #c5a059; box-shadow: var(--shadow-sm);">
          <p style="font-family: 'Playfair Display', serif; font-size: 38px; font-weight: 700; color: #4a1525; margin: 0; line-height: 1.1;">7-10 Days</p>
          <p class="note" style="margin: 8px 0 0; font-weight: 600; color: var(--ink);">Entrega Rápida de Muestras a Medida (7-10 Días)</p>
        </div>
      </div>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">Soluciones por Categoría</p>
      <h2>Fabricación personalizada para cada formato labial</h2>
      <div class="grid three" style="margin-top: 28px;">
        {esCategories.map((c) => (
          <a class="card" href={c.href} style="display: block; color: inherit;">
            <h3 style="font-size: 19px; margin-bottom: 8px;">{c.label}</h3>
            <p style="margin: 0; font-size: 15px;">{c.blurb}</p>
            <p style="margin: 12px 0 0; color: var(--rose-dark); font-size: 14px;">Explorar →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- B2B Enterprise Testimonials Section (ES) -->
  <section style="background: #faf6f5; padding: 76px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div class="wrap">
      <div style="max-width: 760px; margin-bottom: 40px;">
        <p class="eyebrow" style="color: #4a1525; font-weight: 700; letter-spacing: 0.12em;">RESULTADOS INDUSTRIALES VERIFICADOS</p>
        <h2 style="font-size: 32px; color: #4a1525; margin: 0 0 12px 0; line-height: 1.2;">Por Qué Compradores B2B y Directores de I+D Eligen MLM Lip</h2>
        <p class="lead" style="font-size: 16px; color: var(--ink-soft); margin: 0;">
          La fabricación de nivel empresarial elimina bloqueos de aduanas, separación de pigmentos y riesgos de inventario inmovilizado. Así resolvemos los puntos críticos de la cadena de suministro en Europa y Norteamérica.
        </p>
      </div>

      <div class="grid three" style="gap: 24px;">
        <!-- Testimonial 1 (ES) -->
        <div class="card" style="background: #fff; border: 1px solid rgba(197, 160, 89, 0.35); border-top: 4px solid #4a1525; border-radius: 12px; padding: 28px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm);">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; gap: 8px; flex-wrap: wrap;">
              <span style="color: #c5a059; font-size: 15px; letter-spacing: 2px;" aria-label="5 de 5 estrellas">★★★★★</span>
              <span style="background: rgba(74, 21, 37, 0.08); color: #4a1525; border: 1px solid rgba(197, 160, 89, 0.45); font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 4px; letter-spacing: 0.04em;">USP 51/61 &amp; CPNP UE VERIFICADO</span>
            </div>
            <h3 style="font-size: 17px; color: #4a1525; margin: 0 0 12px 0; line-height: 1.35;">«Evitamos un riesgo de retirada de 40.000 € en aduanas de la UE y exceso de metales pesados.»</h3>
            <p style="font-size: 14px; color: var(--ink-soft); line-height: 1.65; margin: 0 0 20px 0;">
              «Nuestro proveedor anterior falló en las auditorías de metales pesados antes de la distribución minorista. MLM Lip entregó informes completos de ensayos microbiológicos <strong>USP 51/61</strong> y dosieres toxicológicos CPNP antes del llenado masivo, evitando un riesgo de retirada valorado en <strong>40.000 €</strong>.»
            </p>
          </div>
          <div style="border-top: 1px solid var(--line); padding-top: 14px;">
            <p style="margin: 0; font-size: 13px; font-weight: 700; color: #4a1525;">Head of Regulatory Compliance</p>
            <p style="margin: 2px 0 0; font-size: 12px; color: #8c6d46; font-weight: 600;">EU Clean Beauty Brand (500+ Doors)</p>
          </div>
        </div>

        <!-- Testimonial 2 (ES) -->
        <div class="card" style="background: #fff; border: 1px solid rgba(197, 160, 89, 0.35); border-top: 4px solid #c5a059; border-radius: 12px; padding: 28px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm);">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; gap: 8px; flex-wrap: wrap;">
              <span style="color: #c5a059; font-size: 15px; letter-spacing: 2px;" aria-label="5 de 5 estrellas">★★★★★</span>
              <span style="background: rgba(74, 21, 37, 0.08); color: #4a1525; border: 1px solid rgba(197, 160, 89, 0.45); font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 4px; letter-spacing: 0.04em;">CERO SEDIMENTACIÓN PIGMENTARIA</span>
            </div>
            <h3 style="font-size: 17px; color: #4a1525; margin: 0 0 12px 0; line-height: 1.35;">«Aprobación de fórmula espejo de alto brillo en 14 días y entrega fluida de 50.000 unidades.»</h3>
            <p style="font-size: 14px; color: var(--ink-soft); line-height: 1.65; margin: 0 0 20px 0;">
              «Las fórmulas perladas espejo suelen sufrir precipitación y separación de fases. El laboratorio de MLM Lip estabilizó la matriz de suspensión, cerró nuestra muestra definitiva en <strong>14 días</strong> y entregó un pedido viral de <strong>50.000 unidades</strong> para TikTok Shop sin desviaciones entre lotes.»
            </p>
          </div>
          <div style="border-top: 1px solid var(--line); padding-top: 14px;">
            <p style="margin: 0; font-size: 13px; font-weight: 700; color: #4a1525;">VP of Product Development</p>
            <p style="margin: 2px 0 0; font-size: 12px; color: #8c6d46; font-weight: 600;">Viral TikTok Shop &amp; DTC Beauty Brand</p>
          </div>
        </div>

        <!-- Testimonial 3 (ES) -->
        <div class="card" style="background: #fff; border: 1px solid rgba(197, 160, 89, 0.35); border-top: 4px solid #4a1525; border-radius: 12px; padding: 28px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-sm);">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; gap: 8px; flex-wrap: wrap;">
              <span style="color: #c5a059; font-size: 15px; letter-spacing: 2px;" aria-label="5 de 5 estrellas">★★★★★</span>
              <span style="background: rgba(74, 21, 37, 0.08); color: #4a1525; border: 1px solid rgba(197, 160, 89, 0.45); font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 4px; letter-spacing: 0.04em;">MOQ FLEXIBLE ESCALONADO 500 UDS</span>
            </div>
            <h3 style="font-size: 17px; color: #4a1525; margin: 0 0 12px 0; line-height: 1.35;">«Redujimos el ciclo de validación de nuevos tonos de 6 meses a tan solo 45 días.»</h3>
            <p style="font-size: 14px; color: var(--ink-soft); line-height: 1.65; margin: 0 0 20px 0;">
              «Al permitir lotes iniciales escalonados desde <strong>500 unidades por SKU</strong>, validamos la rotación de nuevas gamas cromáticas en tiendas físicas sin sobrestock, comprimiendo nuestro ciclo de lanzamiento comercial de <strong>6 meses a 45 días</strong>.»
            </p>
          </div>
          <div style="border-top: 1px solid var(--line); padding-top: 14px;">
            <p style="margin: 0; font-size: 13px; font-weight: 700; color: #4a1525;">Director of Merchandising &amp; Sourcing</p>
            <p style="margin: 2px 0 0; font-size: 12px; color: #8c6d46; font-weight: 600;">Multi-Brand Specialty Cosmetics Retailer (120+ Doors)</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="b2b-testimonials" style="background: var(--blush-soft); padding: 72px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div class="wrap">
      <div style="text-align: center; max-width: 760px; margin: 0 auto 44px;">
        <p class="eyebrow" style="color: var(--burgundy); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;">Trayectoria B2B Verificada</p>
        <h2 style="font-family: 'Playfair Display', var(--font-serif), serif; font-size: clamp(28px, 3.5vw, 40px); color: var(--plum-dark); margin-bottom: 12px;">La Confianza de Fundadores de Belleza y Directores de Normativa</h2>
        <p class="lead" style="font-size: 16px; color: var(--ink-soft); margin: 0 auto;">Desde la aprobación regulatoria CPNP/FDA sin incidencias hasta reposiciones virales a gran escala, así escalan las marcas con nuestro laboratorio.</p>
      </div>
      <div class="grid three" style="gap: 24px;">
        <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 28px; border-top: 3px solid var(--gold); background: #fff;">
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
              <span style="color: var(--gold); font-size: 15px; letter-spacing: 2px;" aria-label="5 de 5 estrellas">★★★★★</span>
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--burgundy); background: var(--blush-soft); padding: 4px 10px; border-radius: 4px;">Cumplimiento &amp; Despacho Transfronterizo</span>
            </div>
            <p style="font-size: 15px; line-height: 1.65; color: var(--ink); font-style: italic; margin: 0 0 20px;">
              "Los estándares de la UE y la FDA sobre conservantes y límites microbiológicos son inflexibles. El equipo de formulación de Beautychain ejecutó pruebas USP 51/61 antes de nuestro primer lote, aprobando nuestro dossier CPNP sin una sola consulta."
            </p>
          </div>
          <div>
            <div style="border-top: 1px solid var(--line); padding-top: 14px; margin-bottom: 12px;">
              <strong style="display: block; font-size: 14px; color: var(--plum-dark);">Directora de Asuntos Regulatorios</strong>
              <span style="font-size: 13px; color: var(--ink-soft);">Marca Clean Beauty (500+ tiendas en la UE)</span>
            </div>
            <div style="display: inline-block; font-size: 12px; font-weight: 600; color: #155724; background: #e8f5e9; border: 1px solid #c3e6cb; padding: 5px 10px; border-radius: 999px;">
              ✓ CPNP UE Aprobado · USP 51/61 Superado
            </div>
          </div>
        </div>

        <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 28px; border-top: 3px solid var(--gold); background: #fff;">
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
              <span style="color: var(--gold); font-size: 15px; letter-spacing: 2px;" aria-label="5 de 5 estrellas">★★★★★</span>
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--burgundy); background: var(--blush-soft); padding: 4px 10px; border-radius: 4px;">Estabilidad de Tono &amp; Escalado Rápido</span>
            </div>
            <p style="font-size: 15px; line-height: 1.65; color: var(--ink); font-style: italic; margin: 0 0 20px;">
              "Sufrimos separación de aceite y pigmento con tres proveedores OEM anteriores en nuestro lip oil de péptidos. Beautychain estabilizó la suspensión en 10 días de muestreo. Cuando el lanzamiento se volvió viral en TikTok, entregaron 40.000 unidades a tiempo."
            </p>
          </div>
          <div>
            <div style="border-top: 1px solid var(--line); padding-top: 14px; margin-bottom: 12px;">
              <strong style="display: block; font-size: 14px; color: var(--plum-dark);">Líder de Producto</strong>
              <span style="font-size: 13px; color: var(--ink-soft);">Marca DTC Viral de Cuidado Labial (Los Ángeles, CA)</span>
            </div>
            <div style="display: inline-block; font-size: 12px; font-weight: 600; color: #155724; background: #e8f5e9; border: 1px solid #c3e6cb; padding: 5px 10px; border-radius: 999px;">
              ✓ Suspensión de Péptidos Estabilizada · 40k Uds Entregadas
            </div>
          </div>
        </div>

        <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 28px; border-top: 3px solid var(--gold); background: #fff;">
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
              <span style="color: var(--gold); font-size: 15px; letter-spacing: 2px;" aria-label="5 de 5 estrellas">★★★★★</span>
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--burgundy); background: var(--blush-soft); padding: 4px 10px; border-radius: 4px;">Prueba de Mercado de Bajo Riesgo</span>
            </div>
            <p style="font-size: 15px; line-height: 1.65; color: var(--ink); font-style: italic; margin: 0 0 20px;">
              "El MOQ universal de 500 uds nos dio la agilidad para probar 6 tonos personalizados en pop-ups antes de emitir nuestra orden de compra de 20.000 unidades. Su muestreo ágil redujo nuestro ciclo de lanzamiento de 6 meses a 45 días."
            </p>
          </div>
          <div>
            <div style="border-top: 1px solid var(--line); padding-top: 14px; margin-bottom: 12px;">
              <strong style="display: block; font-size: 14px; color: var(--plum-dark);">Director de Marca</strong>
              <span style="font-size: 13px; color: var(--ink-soft);">Cadena Regional de Cosmética (Londres, UK)</span>
            </div>
            <div style="display: inline-block; font-size: 12px; font-weight: 600; color: #155724; background: #e8f5e9; border: 1px solid #c3e6cb; padding: 5px 10px; border-radius: 999px;">
              ✓ Lanzamiento Ágil 500 uds · 45 Días al Mercado
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Normativa &amp; Garantía</p>
      <h2>Documentación preparada para el mercado europeo y americano</h2>
      <div class="grid three" style="margin-top:28px">
        {certifications.map((c) => (
          <div class="card gold-line" style="display:flex; gap:16px; align-items:flex-start;">
            <svg viewBox="0 0 48 48" width="40" height="40" fill="none" style="flex-shrink:0; margin-top:4px;" aria-hidden="true">
              <circle cx="24" cy="24" r="22" stroke="var(--gold)" stroke-width="2" />
              <path d="M16 24l6 6 12-14" stroke="var(--burgundy)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div>
              <h3 style="font-size:18px;">{c.name}</h3>
              <p style="margin:0; font-size:14px;">{c.body}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="note" style="margin-top:18px; text-align:center;">
        Informes toxicológicos completos, pruebas de metales pesados, Fichas de Seguridad (FDS) y registros de lote para cada envío.
      </p>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">Preguntas Frecuentes</p>
      <h2>Antes de comenzar tu proyecto</h2>
      <div class="grid two" style="margin-top: 28px;">
        {esFaqs.map((f) => (
          <div class="card">
            <h3 style="font-size: 18px;">{f.q}</h3>
            <p style="margin: 0;">{f.a}</p>
          </div>
        ))}
      </div>
      <p style="margin-top: 24px;"><a href="/faq">Ver todas las preguntas frecuentes →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="card" style="text-align:center; padding:48px 28px">
        <h2 style="margin-bottom:10px">Cuéntanos qué producto deseas lanzar</h2>
        <p class="lead" style="max-width:560px; margin:0 auto 24px">
          Envíanos tu idea de producto, tonos, cantidades y mercado objetivo. Te responderemos en 24 horas con las opciones más prácticas.
        </p>
        <a class="btn" href="/quote">Configurar presupuesto online</a>
      </div>
    </div>
  </section>
</BaseLayout>
