---
// src/components/blog/SampleKitCTA.astro
export interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  badge?: string;
}

const {
  title = "Start Your Lip Line With Just 500 Pieces",
  subtitle = "$50 sample kit — 3 textures, 7-day delivery, fees credited 100% to bulk order",
  ctaText = "Claim Your Sample Kit →",
  ctaLink = "/samples",
  badge = "Sample Kit Offer"
} = Astro.props;
---

<div class="sample-kit-card">
  {badge && <span class="sample-kit-badge">{badge}</span>}
  <h3 class="sample-kit-title">{title}</h3>
  <p class="sample-kit-subtitle">{subtitle}</p>
  
  <div class="sample-kit-features">
    <span class="feature-item"><span class="check-icon">✓</span> 500 pcs MOQ</span>
    <span class="feature-item"><span class="check-icon">✓</span> 7-Day Samples</span>
    <span class="feature-item"><span class="check-icon">✓</span> FDA & ISO Certified</span>
  </div>

  <div class="sample-kit-action">
    <a href={ctaLink} class="sample-kit-btn">{ctaText}</a>
  </div>
</div>

<style>
  .sample-kit-card {
    margin: 44px 0;
    padding: 36px 28px;
    background: linear-gradient(135deg, #faf2f5 0%, #f4e2e7 100%);
    border: 1px solid #e8d7dc;
    border-left: 5px solid #9c2e4e;
    border-radius: 14px;
    box-shadow: 0 4px 20px rgba(74, 21, 37, 0.06);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .sample-kit-badge {
    display: inline-block;
    padding: 4px 14px;
    background: #6e1a32;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 20px;
    margin-bottom: 14px;
  }

  .sample-kit-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(20px, 3vw, 26px);
    font-weight: 600;
    color: #141013;
    line-height: 1.25;
    margin: 0 0 10px;
  }

  .sample-kit-subtitle {
    font-size: 15px;
    color: #4a3e42;
    max-width: 600px;
    margin: 0 auto 20px;
    line-height: 1.6;
  }

  .sample-kit-features {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 24px;
    margin-bottom: 24px;
    font-size: 13.5px;
    font-weight: 600;
    color: #4a1525;
  }

  .feature-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    background: #9c2e4e;
    color: #ffffff;
    border-radius: 50%;
    font-size: 11px;
    font-weight: bold;
  }

  .sample-kit-action {
    display: flex;
    justify-content: center;
  }

  .sample-kit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #6e1a32;
    color: #ffffff !important;
    font-size: 15px;
    font-weight: 600;
    padding: 13px 32px;
    border-radius: 30px;
    text-decoration: none !important;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(110, 26, 50, 0.28);
  }

  .sample-kit-btn:hover {
    background: #4a1525;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(74, 21, 37, 0.35);
  }

  @media (max-width: 640px) {
    .sample-kit-card {
      padding: 28px 18px;
      margin: 32px 0;
    }
    .sample-kit-features {
      flex-direction: column;
      gap: 8px;
      align-items: center;
    }
    .sample-kit-btn {
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>
