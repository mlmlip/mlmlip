---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, pillars, products, steps, certifications } from '../data/site';
import { cases } from '../data/cases';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
const featuredCases = cases.slice(0, 3);
---

<BaseLayout
  title="Private Label Lip Cosmetics Manufacturer | 500 pcs Universal MOQ — MLM Lip"
  description="Tier-1 custom lip cosmetics manufacturing for emerging and high-growth beauty brands in North America & Europe. 500 pcs MOQ across Peptide Lip Oils, Lip Muds, Glosses, and Lipsticks. 7-day rapid prototyping."
>
  <section style="background: linear-gradient(180deg, var(--cream) 0%, var(--blush-soft) 100%); padding-top: 96px; padding-bottom: 96px;">
    <div class="wrap">
      <p class="eyebrow" style="letter-spacing: 0.2em; font-weight: 600;">Custom Lip Cosmetics · OEM &amp; ODM Specialist</p>
      <h1 style="font-size: clamp(38px, 5vw, 62px); line-height: 1.1; max-width: 900px; margin-bottom: 24px;">
        Engineering Your Next Viral Lip Line.<br />
        <span style="color: var(--burgundy); font-style: italic;">From 500 Pieces, End-to-End.</span>
      </h1>
      <p class="lead" style="max-width: 720px; font-size: 20px; line-height: 1.6; margin-bottom: 36px;">
        We manufacture benchmark-grade lip cosmetics for indie beauty founders, TikTok Shop creators, and multi-channel retailers across North America and Europe. Bespoke formulation, componentry library, and custom tooling—executed under GMPC &amp; ISO cleanroom standards.
      </p>
      <div>
        <a class="btn" href="/contact" style="padding: 16px 36px; font-size: 16px; font-weight: 600;">Request Custom Sample Kit</a>
        <a class="btn ghost" href="/cases" style="margin-left: 14px; padding: 16px 32px; font-size: 16px;">View Factory &amp; Case Studies</a>
      </div>
      <p class="note" style="margin-top: 24px; font-size: 14px; color: var(--plum);">
        ✓ 500 pcs universal MOQ &nbsp;·&nbsp; ✓ 7-day formulation sampling &nbsp;·&nbsp; ✓ 100% sample fee credited to bulk order
      </p>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">Enterprise Manufacturing Pillars</p>
      <h2>Built for Agile Brands. Backed by Industrial Rigor.</h2>
      <div class="grid three" style="margin-top: 36px;">
        {pillars.map((p) => (
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <p class="eyebrow" style="margin-bottom: 8px; color: var(--burgundy); font-size: 11px;">{p.subtitle}</p>
              <h3 style="font-size: 22px; line-height: 1.3; margin-bottom: 14px;">{p.title}</h3>
              <p style="font-size: 15px; line-height: 1.65; color: var(--ink-soft);">{p.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">What we produce</p>
      <h2>Lip first. Everything else second.</h2>
      <p class="lead" style="max-width:640px">
        Six lip categories are what we do best — gloss, mud, liner, lipstick, oil and mask.
        Body oils and other cosmetics are available as companion lines to round out your range.
      </p>
      <div class="grid three" style="margin-top:28px">
        {products.map((p) => (
          <div class="card">
            <h3>{p.name}</h3>
            <p>{p.body}</p>
            <p class="note" style="margin:0">{p.detail}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:24px"><a href="/products">View the full product range →</a></p>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2>From brief to your door</h2>
      <div class="grid two" style="margin-top:28px">
        {steps.map((s) => (
          <div class="card">
            <p class="eyebrow" style="margin-bottom:6px">Step {s.n}</p>
            <h3>{s.title}</h3>
            <p style="margin:0">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Certified production</p>
      <h2>Documentation your market asks for</h2>
      <div class="grid three" style="margin-top:28px">
        {certifications.map((c) => (
          <div class="card">
            <h3>{c.name}</h3>
            <p style="margin:0">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <p class="eyebrow">Real projects</p>
      <h2>Made for brands like yours</h2>
      <div class="grid three" style="margin-top:28px">
        {featuredCases.map((c) => (
          <div class="card">
            {c.image ? (
              <div class="case-media"><img src={c.image} alt={c.title} loading="lazy" /></div>
            ) : (
              <div class="media-slot" style="margin-bottom:16px">Case media — assets coming</div>
            )}
            <p class="eyebrow" style="margin-bottom:6px">{c.category}</p>
            <h3 style="margin-bottom:8px">{c.title}</h3>
            <p style="margin:0">{c.summary}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:24px"><a href="/cases">See all cases &amp; factory videos →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">From the blog</p>
      <h2>Build your lip brand smarter</h2>
      <div class="grid two" style="margin-top:28px">
        {latestPosts.map((post) => (
          <a class="card" href={`/blog/${post.id}`} style="display:block; color:inherit">
            <h3 style="margin-bottom:8px">{post.data.title}</h3>
            <p style="margin:0">{post.data.description}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:24px"><a href="/blog">Read all articles →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="card" style="text-align:center; padding:48px 28px">
        <h2 style="margin-bottom:10px">Tell us what you want to launch</h2>
        <p class="lead" style="max-width:560px; margin:0 auto 24px">
          Send your product idea, target quantity and market. We will come back with the most practical way to make it yours.
        </p>
        <a class="btn" href="/contact">Start your lip line</a>
      </div>
    </div>
  </section>
</BaseLayout>
