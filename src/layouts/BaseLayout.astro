---
import { site, footerCategories, footerCompany, ui, navKeys, navLinks } from '../data/site';
import LiveChat from '../components/LiveChat.astro';
import '../styles/global.css';

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith('/fr') ? 'fr' : currentPath.startsWith('/es') ? 'es' : 'en';
const locale = currentLang === 'fr' ? 'fr_FR' : currentLang === 'es' ? 'es_ES' : 'en_US';
const t = ui[currentLang];

const canonical = new URL(currentPath.replace(/\/$/, '') || '/', Astro.site ?? 'https://mlmlip.com');

// 标准化当前路径（去除尾部斜杠，但保留根路径 '/'）
const cleanPath = (currentPath.replace(/\/$/, '') || '/');

// 判断是否为单品详情页：以 /products/ 开头，且不是 /products 且不是 /products/page/
const isProductDetail = cleanPath.startsWith('/products/') && !cleanPath.startsWith('/products/page');

// 多语言双向路由映射表（具备三语对应页面的路由集合）
const multiLangRoutes = [
  { en: '/', fr: '/fr', es: '/es' },
  { en: '/products', fr: '/fr/produits', es: '/es/productos' },
  { en: '/about', fr: '/fr/a-propos', es: '/es/nosotros' },
  { en: '/quote', fr: '/fr/quote', es: '/es/quote' },
  { en: '/faq', fr: '/fr/faq', es: '/es/faq' },
  { en: '/lip-gloss-manufacturer', fr: '/fr/fabricant-gloss-levres', es: '/es/fabricante-brillo-labios' },
  { en: '/lip-mud-manufacturer', fr: '/fr/fabricant-lip-mud', es: '/es/fabricante-lip-mud' },
  { en: '/lip-liner-manufacturer', fr: '/fr/fabricant-crayon-levres', es: '/es/fabricante-delineador-labios' },
  { en: '/lipstick-manufacturer', fr: '/fr/fabricant-rouge-levres', es: '/es/fabricante-lapiz-labial' },
  { en: '/lip-oil-manufacturer', fr: '/fr/fabricant-huile-levres', es: '/es/fabricante-aceite-labios' },
  { en: '/lip-mask-manufacturer', fr: '/fr/fabricant-masque-levres', es: '/es/fabricante-mascarilla-labios' }
];

const matchedRoute = multiLangRoutes.find(
  (r) => r.en === cleanPath || r.fr === cleanPath || r.es === cleanPath
);

// 计算 hreflang 列表：
// 1. 若为单品详情页：站内目前只有英文单品页，绝对不能输出指向 404 的 fr/es，仅输出 en 和 x-default 指向当前自身
// 2. 若在三语映射表中：输出对应的 en, fr, es, 以及 x-default (指向 en)
// 3. 其余纯英文页面（如 blog 详情页、packaging 等目前无 fr/es 对应的页面）：只输出 en 和 x-default 指向自身，严防 404
interface AlternateLink {
  lang: string;
  href: string;
}

let alternateLinks: AlternateLink[] = [];
let switcherUrls = {
  en: new URL(cleanPath, site.domain).href,
  fr: new URL('/fr', site.domain).href,
  es: new URL('/es', site.domain).href
};

if (isProductDetail) {
  alternateLinks = [
    { lang: 'en', href: canonical.href },
    { lang: 'x-default', href: canonical.href }
  ];
  switcherUrls = {
    en: canonical.href,
    fr: new URL('/fr/produits', site.domain).href,
    es: new URL('/es/productos', site.domain).href
  };
} else if (matchedRoute) {
  const enHref = new URL(matchedRoute.en === '/' ? '' : matchedRoute.en, site.domain).href;
  const frHref = new URL(matchedRoute.fr, site.domain).href;
  const esHref = new URL(matchedRoute.es, site.domain).href;

  alternateLinks = [
    { lang: 'en', href: enHref },
    { lang: 'fr', href: frHref },
    { lang: 'es', href: esHref },
    { lang: 'x-default', href: enHref }
  ];
  switcherUrls = {
    en: enHref,
    fr: frHref,
    es: esHref
  };
} else {
  // 纯英文独立页面
  alternateLinks = [
    { lang: 'en', href: canonical.href },
    { lang: 'x-default', href: canonical.href }
  ];
  switcherUrls = {
    en: canonical.href,
    fr: new URL('/fr', site.domain).href,
    es: new URL('/es', site.domain).href
  };
}

const getLangUrl = (lang: 'en' | 'fr' | 'es') => switcherUrls[lang];

// 动态导航栏链接（根据当前语种切换对应的本地化路径）
const localizedNavLinks: Record<string, string> = {
  products: currentLang === 'fr' ? '/fr/produits' : currentLang === 'es' ? '/es/productos' : '/products',
  packaging: '/packaging',
  customization: '/customization',
  process: '/process',
  cases: '/cases',
  samples: '/samples',
  blog: '/blog',
  about: currentLang === 'fr' ? '/fr/a-propos' : currentLang === 'es' ? '/es/nosotros' : '/about'
};

const localizedQuoteLink = currentLang === 'fr' ? '/fr/quote' : currentLang === 'es' ? '/es/quote' : '/quote';
const localizedBrandLink = currentLang === 'fr' ? '/fr' : currentLang === 'es' ? '/es' : '/';

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://mlmlip.com/#website",
      "url": site.domain,
      "name": site.name,
      "description": site.tagline,
      "publisher": {
        "@id": "https://mlmlip.com/#organization"
      },
      "inLanguage": ["en", "fr", "es"]
    },
    {
      "@type": ["Organization", "Manufacturer"],
      "@id": "https://mlmlip.com/#organization",
      "name": site.name,
      "legalName": site.manufacturer,
      "url": site.domain,
      "logo": `${site.domain}/favicon.svg`,
      "description": "Prestige private label custom lip cosmetics manufacturer specializing in lip gloss, lip mud, lip oil, lipstick, and lip masks with a universal 500 pcs MOQ.",
      "address": [
        {
          "@type": "PostalAddress",
          "addressLocality": "Shenzhen",
          "addressRegion": "Guangdong",
          "addressCountry": "CN",
          "description": "Innovation & R&D Center"
        },
        {
          "@type": "PostalAddress",
          "addressLocality": "Huizhou",
          "addressRegion": "Guangdong",
          "addressCountry": "CN",
          "description": "Cleanroom Manufacturing Hub"
        }
      ],
      "alternateName": ["Beautychain", "Beautychain Limited", "MLM Lip OEM/ODM"],
      "sameAs": [
        "https://www.linkedin.com/company/mlmlip",
        "https://twitter.com/mlmlip",
        "https://www.instagram.com/mlmlip_cosmetics"
      ],
      "knowsAbout": [
        "Cosmetics OEM Contract Manufacturing",
        "Private Label Lip Gloss Formulation",
        "Velvet Lip Mud Rheology",
        "Peptide Lip Oil Engineering",
        "ISO 22716 Cosmetics GMP Cleanroom Operations",
        "FDA MoCRA Cosmetic Facility Compliance",
        "EU CPNP and CPSR Safety Assessment",
        "Custom Cosmetic Injection Mold Tooling"
      ],
      "hasCredential": [
        {
          "@type": "EducationalOccupationalCredential",
          "name": "ISO 22716:2007 Cosmetics GMP Certification"
        },
        {
          "@type": "EducationalOccupationalCredential",
          "name": "US FDA MoCRA Compliant Facility Registration"
        }
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": site.contact.whatsapp,
        "contactType": "sales",
        "email": site.contact.email,
        "availableLanguage": ["English", "French", "Spanish"]
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Custom Lip Cosmetics OEM/ODM Catalog",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "High-Impact Lip Gloss Private Label" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Velvet Lip Mud & Tint Manufacturing" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Skinified Peptide Lip Oil OEM/ODM" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Precision Lip Liner Production" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom Lipstick & Bullet Case Tooling" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Barrier Repair Lip Mask Production" } }
        ]
      }
    }
  ]
};

const pathSegments = currentPath.split('/').filter((s) => s.length > 0);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mlmlip.com' },
    ...pathSegments.map((seg, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: seg.replace(/[-_]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
      item: 'https://mlmlip.com/' + pathSegments.slice(0, i + 1).join('/')
    }))
  ]
};
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#4a1525" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.href} />
    ))}
    <slot name="head" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="AI Fact Sheet (llms.txt)" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Full Factory Specification (llms-full.txt)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&display=swap" /></noscript>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={`${site.domain}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MLM Lip — Private label lip cosmetics manufacturer. 500 pcs MOQ, 7-day sampling, GMPC + ISO + CPNP." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@mlmlip" />
    <meta name="twitter:image" content={`${site.domain}/og-image.png`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CHEQXE47YG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CHEQXE47YG');
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={localizedBrandLink}>MLM<span>Lip</span></a>
        <nav class="nav" id="primary-nav">
          {navKeys.map((key) => {
            const targetLink = localizedNavLinks[key];
            const isActive = cleanPath === targetLink.replace(/\/$/, '');
            return (
              <a href={targetLink} class={isActive ? 'is-active' : ''}>{t.nav[key]}</a>
            );
          })}
          <a class="btn" href={localizedQuoteLink}>{t.nav.quote}</a>
          <div class="lang-switch" style="display:flex; gap:6px; margin-left:8px; font-size:12px; font-weight:700; color:var(--ink-soft); align-items:center;">
            <a href={getLangUrl('en')} style={`color: ${currentLang === 'en' ? 'var(--gold)' : 'var(--ink-soft)'}; font-weight: ${currentLang === 'en' ? '700' : '600'}; ${currentLang === 'en' ? 'border-bottom: 2px solid var(--gold);' : ''}`}>EN</a>
            <span style="opacity: 0.5;">/</span>
            <a href={getLangUrl('fr')} style={`color: ${currentLang === 'fr' ? 'var(--gold)' : 'var(--ink-soft)'}; font-weight: ${currentLang === 'fr' ? '700' : '600'}; ${currentLang === 'fr' ? 'border-bottom: 2px solid var(--gold);' : ''}`}>FR</a>
            <span style="opacity: 0.5;">/</span>
            <a href={getLangUrl('es')} style={`color: ${currentLang === 'es' ? 'var(--gold)' : 'var(--ink-soft)'}; font-weight: ${currentLang === 'es' ? '700' : '600'}; ${currentLang === 'es' ? 'border-bottom: 2px solid var(--gold);' : ''}`}>ES</a>
          </div>
        </nav>
        <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false">
          <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        </button>
      </div>
      <div class="nav-drawer" id="nav-drawer" hidden>
        <div class="wrap">
          {navKeys.map((key) => {
            const targetLink = localizedNavLinks[key];
            const isActive = cleanPath === targetLink.replace(/\/$/, '');
            return (
              <a href={targetLink} class={isActive ? 'is-active' : ''}>{t.nav[key]}</a>
            );
          })}
          <a class="btn" href={localizedQuoteLink} style="margin-top: 8px; display: inline-block;">{t.nav.quote}</a>
          <div style="display:flex; gap:12px; margin-top:16px; padding-top:12px; border-top:1px solid var(--line); font-size:14px; font-weight:600; align-items:center;">
            <span>{t.nav.lang}</span>
            <a href={getLangUrl('en')} style={`color: ${currentLang === 'en' ? 'var(--gold)' : 'var(--ink-soft)'}; font-weight: ${currentLang === 'en' ? '700' : '600'}; ${currentLang === 'en' ? 'text-decoration: underline;' : ''}`}>English</a>
            <a href={getLangUrl('fr')} style={`color: ${currentLang === 'fr' ? 'var(--gold)' : 'var(--ink-soft)'}; font-weight: ${currentLang === 'fr' ? '700' : '600'}; ${currentLang === 'fr' ? 'text-decoration: underline;' : ''}`}>Français</a>
            <a href={getLangUrl('es')} style={`color: ${currentLang === 'es' ? 'var(--gold)' : 'var(--ink-soft)'}; font-weight: ${currentLang === 'es' ? '700' : '600'}; ${currentLang === 'es' ? 'text-decoration: underline;' : ''}`}>Español</a>
          </div>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="grid three">
          <div>
            <p class="brand">MLM<span>Lip</span></p>
            <p style="color:#e9c9d3; max-width: 320px;">
              {t.footer.desc}
            </p>
            <p style="color:#d6b3be; font-size:13px; margin-top:16px;">
              GMPC · ISO 22716 · EU CPNP support
            </p>
          </div>
          <div>
            <p style="color:#f3dde3; margin-bottom:10px;">{t.footer.mfg}</p>
            <p style="color:#e9c9d3; margin:0; line-height:1.9;">
              {footerCategories.map((l) => (
                <><a href={l.href}>{l.label}</a><br /></>
              ))}
            </p>
          </div>
          <div>
            <p style="color:#f3dde3; margin-bottom:10px;">{t.footer.touch}</p>
            <p style="color:#e9c9d3; margin:0 0 14px; line-height:1.9;">
              WhatsApp: <a href={site.contact.whatsappLink} target="_blank" rel="noopener">{site.contact.whatsapp}</a><br />
              Email: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a><br />
              {site.contact.address}
            </p>
            <p style="color:#e9c9d3; margin:0; line-height:1.9;">
              {footerCompany.slice(0, 5).map((l) => (
                <><a href={l.href}>{l.label}</a> · </>
              ))}
            </p>
          </div>
        </div>
        <p style="color:#d6b3be; margin-top:32px; font-size:13px">
          {new Date().getFullYear()} {site.name} · Manufactured by {site.manufacturer}
        </p>
      </div>
    </footer>

    <a class="wa-float" href={`${site.contact.whatsappLink}?text=${encodeURIComponent("Hi MLM Lip, I'd like to discuss a private label lip project.")}`} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path d="M17.5 14.4c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.7.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.7-1.7-.9-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3.1 5 4.3 2.5 1 3 .8 3.6.8.6-.1 1.9-.8 2.1-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/>
      </svg>
      <span>WhatsApp</span>
    </a>

    <!-- P0-3: 24/7 AI Formulation Specialist Chat Widget -->
    <LiveChat />

    <script is:inline>
      const toggle = document.getElementById('nav-toggle');
      const drawer = document.getElementById('nav-drawer');
      toggle?.addEventListener('click', () => {
        const open = drawer?.hasAttribute('hidden');
        if (open) {
          drawer?.removeAttribute('hidden');
          toggle.setAttribute('aria-expanded', 'true');
          toggle.setAttribute('aria-label', 'Close menu');
        } else {
          drawer?.setAttribute('hidden', '');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open menu');
        }
      });
    </script>

    <script is:inline>
      // 滚动渐入动画 — 轻量 Intersection Observer
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('revealed');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.card, section .grid > *, .timeline > li').forEach((el) => {
          el.classList.add('reveal');
          io.observe(el);
        });
      }
    </script>
  
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Track WhatsApp clicks
  document.querySelectorAll('a[href*="wa.me"], a[href*="whatsapp"]').forEach(function(el) {
    el.addEventListener('click', function() {
      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          lead_type: 'whatsapp_inquiry',
          page_path: window.location.pathname
        });
      }
    });
  });
  // Track form submissions with email tier detection
  document.querySelectorAll('form[action*="web3forms"]').forEach(function(form) {
    form.addEventListener('submit', function() {
      var emailInput = form.querySelector('input[type="email"]');
      var email = emailInput ? emailInput.value : '';
      var freeProviders = ['gmail.com','yahoo.com','hotmail.com','outlook.com','qq.com','163.com','aol.com'];
      var domain = email.split('@')[1] || '';
      var emailTier = freeProviders.some(function(p){return domain.toLowerCase()===p;}) ? 'tier_3_free' : 'tier_1_business';
      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          lead_type: 'quote_inquiry',
          email_tier: emailTier,
          page_path: window.location.pathname
        });
      }
    });
  });
});
</script>
</body>
</html>