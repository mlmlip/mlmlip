---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact | Request a Quote for Custom Lip Products — MLM Lip"
  description="Contact MLM Lip for custom lip cosmetics manufacturing. Send your product brief, target quantity and market to get a quote. WhatsApp and email available."
>
  <section>
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
      <p class="eyebrow">Contact</p>
      <h1>Tell us what you want to launch</h1>
      <p class="lead" style="max-width:620px">
        The more you tell us — product type, quantity, target market, price point — the more specific our reply can be.
        Most inquiries are answered within one working day.
      </p>
    </div>
  </section>

  <section class="tint" style="padding-top:0; background:transparent">
    <div class="wrap">
      <div class="grid two">
        <div class="card">
          <h2 style="font-size:24px">Send your brief</h2>
          <form id="inquiry-form">
            <div class="form-row">
              <label for="name">Your name *</label>
              <input id="name" name="name" type="text" required />
            </div>
            <div class="form-row">
              <label for="company">Brand / company</label>
              <input id="company" name="company" type="text" placeholder="Your brand name" />
            </div>
            <div class="form-row">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required placeholder="you@yourbrand.com" />
            </div>
            <div class="form-row">
              <label for="product">Product interested in</label>
              <select id="product" name="product">
                <option value="">Select a category</option>
                <option>Lip gloss</option>
                <option>Lip mud / velvet tint</option>
                <option>Lip liner</option>
                <option>Lipstick</option>
                <option>Lip oil</option>
                <option>Lip mask</option>
                <option>Full lip collection / bundle</option>
                <option>Not sure yet</option>
              </select>
            </div>
            <div class="form-row">
              <label for="quantity">Target quantity</label>
              <input id="quantity" name="quantity" type="text" placeholder="e.g. 500 pcs" />
            </div>
            <div class="form-row">
              <label for="market">Target market</label>
              <select id="market" name="market">
                <option value="">Select market</option>
                <option>United States</option>
                <option>Canada</option>
                <option>United Kingdom</option>
                <option>European Union</option>
                <option>Other / global</option>
              </select>
            </div>
            <div class="form-row">
              <label for="message">Project details</label>
              <textarea id="message" name="message" rows="4" placeholder="Price point, finish, packaging ideas, timeline…"></textarea>
            </div>
            <div style="display:flex; flex-wrap:wrap; gap:12px; margin-top:8px;">
              <button class="btn" type="submit" id="submit-btn" style="flex:1; min-width:220px;">Send my brief via WhatsApp →</button>
              <button class="btn ghost" type="button" id="copy-contact-btn" style="flex:1; min-width:180px;">Copy brief text</button>
            </div>
            <div id="contact-copy-toast" hidden style="margin-top:12px; padding:10px 14px; background:#d4edda; color:#155724; border-radius:8px; font-size:13px; font-weight:500;">
              ✓ Inquiry copied to clipboard! You can paste it into an email to us.
            </div>
            <p class="note" style="margin-top:12px">
              Your brief is sent via WhatsApp with all details pre-filled. Prefer email? <a id="contact-mail-link" href={`mailto:${site.contact.email}?subject=Lip%20Product%20Inquiry`}>Click here to send via email directly</a>.
            </p>
            <div id="form-success" hidden style="margin-top:16px; padding:16px; background:var(--blush); border-radius:10px; border-left:3px solid var(--rose);">
              <p style="margin:0; color:var(--plum); font-weight:600;">✓ Your brief is ready in WhatsApp.</p>
              <p class="note" style="margin:6px 0 0;">If WhatsApp didn't open, <a href={site.contact.whatsappLink} target="_blank" rel="noopener">click here to chat with us</a>.</p>
            </div>
          </form>
        </div>

        <div>
          <div class="card" style="margin-bottom:24px">
            <h3>Direct contact</h3>
            <p style="margin:0">
              WhatsApp: <a href={site.contact.whatsappLink} target="_blank" rel="noopener">{site.contact.whatsapp}</a><br />
              Email: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a><br />
              Location: {site.contact.address}
            </p>
          </div>
          <div class="card">
            <h3>What happens next</h3>
            <p style="margin:0">
              We review your brief and reply with the practical options — recommended format, packaging route,
              sampling plan and pricing for your quantity.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ wa: site.contact.whatsappLink.replace('https://wa.me/', '') }}>
    const form = document.getElementById('inquiry-form');
    const success = document.getElementById('form-success');
    const copyBtn = document.getElementById('copy-contact-btn');
    const copyToast = document.getElementById('contact-copy-toast');
    const mailLink = document.getElementById('contact-mail-link');

    function getContactLines() {
      const data = new FormData(form);
      return [
        'Inquiry from mlmlip.com',
        'Name: ' + (data.get('name') || ''),
        'Email: ' + (data.get('email') || ''),
        'Brand: ' + (data.get('company') || ''),
        'Product: ' + (data.get('product') || ''),
        'Quantity: ' + (data.get('quantity') || ''),
        'Market: ' + (data.get('market') || ''),
        'Details: ' + (data.get('message') || '')
      ];
    }

    function syncMailto() {
      if (mailLink && form) {
        const d = new FormData(form);
        const prod = d.get('product') || 'Lip Cosmetics';
        const subj = encodeURIComponent(`Inquiry: ${prod} (${d.get('company') || 'New Brand'})`);
        const body = encodeURIComponent(getContactLines().join('\n'));
        mailLink.setAttribute('href', `mailto:${site.contact.email}?subject=${subj}&body=${body}`);
      }
    }

    form?.addEventListener('input', syncMailto);
    form?.addEventListener('change', syncMailto);
    syncMailto();

    copyBtn?.addEventListener('click', () => {
      const text = getContactLines().join('\n');
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(showToast).catch(err => {
            console.warn('Clipboard write failed', err);
            fallbackCopy(text);
          });
        } else {
          fallbackCopy(text);
        }
      } catch (err) {
        fallbackCopy(text);
      }
    });

    function showToast() {
      if (copyToast) {
        copyToast.removeAttribute('hidden');
        setTimeout(() => copyToast.setAttribute('hidden', ''), 4000);
      }
    }

    function fallbackCopy(text) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try {
        document.execCommand('copy');
        showToast();
      } catch (e) {
        console.warn('Fallback copy failed', e);
      }
      document.body.removeChild(ta);
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const lines = getContactLines();
      const url = 'https://wa.me/' + wa + '?text=' + encodeURIComponent(lines.join('\n'));
      window.open(url, '_blank', 'noopener');
      success?.removeAttribute('hidden');
    });
  </script>
</BaseLayout>
